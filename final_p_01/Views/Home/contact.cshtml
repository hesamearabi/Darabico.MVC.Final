@{
    Layout = "_Layout";
    ViewData["Title"] = "ارتباط با ما";
}

@section Head {
    <style>
        :root {
            --primary-color: #0056b3; /* آبی سازمانی */
            --dark-header: #111827; /* رنگ تیره برای هدر */
            --bg-gray: #f3f4f6; /* رنگ پس زمینه کلی */
        }

        /* 1. اصلاح مشکل هدر: ایجاد یک نوار تیره در بالای صفحه */
        .page-title-section {
            background-color: var(--dark-header);
            /* اضافه کردن پترن برای زیبایی */
            background-image: radial-gradient(circle at 10% 20%, rgba(0, 86, 179, 0.2) 0%, transparent 20%);
            padding: 160px 0 80px; /* فاصله از بالا برای قرارگیری زیر منو */
            color: white;
            text-align: center;
            position: relative;
        }

            .page-title-section h1 {
                font-size: 3rem;
                font-weight: 900;
                margin-bottom: 10px;
            }

            .page-title-section p {
                font-size: 1.1rem;
                opacity: 0.8;
                max-width: 600px;
                margin: 0 auto;
            }

        /* 2. بدنه اصلی که روی هدر تیره قرار می‌گیرد (Negative Margin) */
        .contact-body {
            background-color: var(--bg-gray);
            min-height: 60vh;
            padding-bottom: 80px;
        }

        .floating-container {
            max-width: 1200px;
            margin: -60px auto 0; /* کشیدن باکس‌ها به سمت بالا */
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        .grid-layout {
            display: grid;
            grid-template-columns: 2fr 1fr; /* تقسیم فضا: لیست تماس‌ها بزرگتر */
            gap: 30px;
        }

        /* استایل کارت‌های تماس */
        .contact-list-box {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        }

        .contact-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 25px 0;
            border-bottom: 1px solid #eee;
            transition: all 0.3s;
        }

            .contact-item-row:last-child {
                border-bottom: none;
            }

            .contact-item-row:hover {
                padding-right: 15px;
            }

        .c-label {
            font-size: 0.95rem;
            color: #888;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .c-icon {
            width: 40px;
            height: 40px;
            background: #eef4ff;
            color: var(--primary-color);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .c-value {
            font-size: 1.3rem;
            font-weight: 700;
            color: #222;
            text-decoration: none;
            direction: ltr;
        }

            .c-value:hover {
                color: var(--primary-color);
            }

        /* استایل باکس کناری (سئو و مشاوره) */
        .side-info-box {
            background: #0056b3;
            color: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0, 86, 179, 0.3);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .side-info-box h2 {
                font-size: 1.5rem;
                margin-bottom: 20px;
                border-bottom: 1px solid rgba(255,255,255,0.2);
                padding-bottom: 15px;
            }

            .side-info-box p {
                line-height: 1.8;
                margin-bottom: 15px;
                font-size: 0.95rem;
                text-align: justify;
                opacity: 0.95;
            }

            .side-info-box strong {
                color: #ffd700;
                font-weight: 600;
            }

        /* ریسپانسیو */
        @@media (max-width: 992px) {
            .grid-layout {
                grid-template-columns: 1fr;
            }

            .floating-container {
                margin-top: -40px;
            }

            .contact-item-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .c-value {
                font-size: 1.1rem;
            }

            .page-title-section {
                padding-top: 140px;
            }
            /* تنظیم ارتفاع هدر در موبایل */
        }
    </style>
}

@section Hero {
