@{
    Layout = "_Layout";
    ViewData["Title"] = "ارتباط با ما";
    string absoluteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}

@section Head {
    <!-- 🚀 Local SEO: معرفی دقیق شرکت فیزیکی، شعب و ساعات کاری به گوگل -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@graph": [
            {
              "@@type": "ContactPage",
              "@@id": "@absoluteUrl",
              "url": "@absoluteUrl",
              "name": "تماس با دارابی کو",
              "description": "راه‌های ارتباطی با دفتر مرکزی و کارخانه تولیدی هلدینگ دارابی جهت مشاوره و استعلام هزینه ساخت زمین پدل."
            },
            {
              "@@type": "GeneralContractor",
              "name": "هلدینگ دارابی (دارابی کو)",
              "image": "@($"{Context.Request.Scheme}://{Context.Request.Host}/siteLOGO/sitelogo.png")",
              "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
              "telephone": ["+989111515971", "+989121729882"],
              "address": [
                {
                  "@@type": "PostalAddress",
                  "streetAddress": "بلوار خزر، خیابان دریا ۴، فروشگاه دارابی",
                  "addressLocality": "ساری",
                  "addressRegion": "مازندران",
                  "addressCountry": "IR",
                  "name": "دفتر مرکزی هلدینگ"
                },
                {
                  "@@type": "PostalAddress",
                  "streetAddress": "کیلومتر ۲۰ جاده فرح آباد، شهرک صنعتی شماره ۲، قطعه D5",
                  "addressLocality": "ساری",
                  "addressRegion": "مازندران",
                  "addressCountry": "IR",
                  "name": "کارخانه تولید شیشه و سازه"
                }
              ],
              "openingHoursSpecification": {
                "@@type": "OpeningHoursSpecification",
                "dayOfWeek": [
                  "Saturday",
                  "Sunday",
                  "Monday",
                  "Tuesday",
                  "Wednesday"
                ],
                "opens": "08:00",
                "closes": "17:00"
              }
            }
          ]
        }
    </script>

    <style>
        :root {
            --primary-color: #0056b3;
            --dark-header: #111827;
            --bg-gray: #f3f4f6;
        }

        .page-title-section {
            background-color: var(--dark-header);
            background-image: radial-gradient(circle at 10% 20%, rgba(0, 86, 179, 0.2) 0%, transparent 20%);
            padding: 160px 0 80px;
            color: white;
            text-align: center;
            position: relative;
        }

            .page-title-section h1 {
                font-size: 3rem;
                font-weight: 900;
                margin-bottom: 10px;
            }

            .page-title-section p {
                font-size: 1.1rem;
                opacity: 0.8;
                max-width: 600px;
                margin: 0 auto;
            }

        .contact-body {
            background-color: var(--bg-gray);
            min-height: 60vh;
            padding-bottom: 80px;
        }

        .floating-container {
            max-width: 1200px;
            margin: -60px auto 0;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }

        .grid-layout {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
        }

        .contact-list-box {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        }

        .contact-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 25px 0;
            border-bottom: 1px solid #eee;
            transition: all 0.3s;
        }

            .contact-item-row:last-child {
                border-bottom: none;
            }

            .contact-item-row:hover {
                padding-right: 15px;
            }

        .c-label {
            font-size: 0.95rem;
            color: #888;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .c-icon {
            width: 40px;
            height: 40px;
            background: #eef4ff;
            color: var(--primary-color);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .c-value {
            font-size: 1.3rem;
            font-weight: 700;
            color: #222;
            text-decoration: none;
            direction: ltr;
        }

            .c-value:hover {
                color: var(--primary-color);
            }

        .side-info-box {
            background: #0056b3;
            color: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0, 86, 179, 0.3);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .side-info-box h2 {
                font-size: 1.5rem;
                margin-bottom: 20px;
                border-bottom: 1px solid rgba(255,255,255,0.2);
                padding-bottom: 15px;
            }

            .side-info-box p {
                line-height: 1.8;
                margin-bottom: 15px;
                font-size: 0.95rem;
                text-align: justify;
                opacity: 0.95;
            }

            .side-info-box strong {
                color: #ffd700;
                font-weight: 600;
            }

        @@media (max-width: 992px) {
            .grid-layout {
                grid-template-columns: 1fr;
            }

            .floating-container {
                margin-top: -40px;
            }

            .contact-item-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .c-value {
                font-size: 1.1rem;
            }

            .page-title-section {
                padding-top: 140px;
            }
        }
    </style>
}

@section Hero { }

    <div class="page-title-section">
        <div class="container">
            <h1>تماس با ما</h1>
            <p>مشاوره تخصصی و استعلام هزینه ساخت زمین پدل</p>
        </div>
    </div>

    <div class="contact-body">
        <div class="floating-container">
            <div class="grid-layout">

                <div class="contact-list-box">
                    <div class="contact-item-row">
                        <div class="c-label">
                            <span class="c-icon" aria-hidden="true">📞</span>
                            <span>مدیریت فروش و قراردادها</span>
                        </div>
                        <a href="tel:09111515971" class="c-value" dir="ltr">0911 151 5971</a>
                    </div>

                    <div class="contact-item-row">
                        <div class="c-label">
                            <span class="c-icon" aria-hidden="true">👷</span>
                            <span>مدیریت فنی و اجرایی</span>
                        </div>
                        <a href="tel:09121729882" class="c-value" dir="ltr">0912 172 9882</a>
                    </div>

                    <div class="contact-item-row">
                        <div class="c-label">
                            <span class="c-icon" aria-hidden="true">🏭</span>
                            <span>کارخانه تولید شیشه و سازه</span>
                        </div>
                        <span class="c-value" style="font-size:1rem; direction:rtl;">شهرک صنعتی شماره ۲، قطعه D5</span>
                    </div>

                    <div class="contact-item-row">
                        <div class="c-label">
                            <span class="c-icon" aria-hidden="true">📍</span>
                            <span>دفتر مرکزی هلدینگ</span>
                        </div>
                        <span class="c-value" style="font-size:1rem; direction:rtl;">ساری، بلوار خزر، خیابان دریا 4 ، فروشگاه دارابی</span>
                    </div>
                </div>

                <div class="side-info-box">
                    <h2>مشاوره قبل از ساخت</h2>
                    <p>تیم مهندسی دارابی به عنوان <strong>مجری ساخت زمین پدل</strong>، آماده ارائه دقیق‌ترین آنالیز از <strong>هزینه ساخت زمین پدل</strong> به کارفرمایان محترم می‌باشد.</p>
                    <p>رعایت دقیق <strong>ابعاد استاندارد زمین پدل</strong> (۱۰ در ۲۰ متر) و استفاده از شیشه‌های سکوریت با استاندارد جهانی، تخصص ماست.</p>
                    <p>اگر در جستجوی اطلاعات شفاف درباره <strong>مراحل ساخت زمین پدل</strong> و بازگشت سرمایه هستید، همین حالا با کارشناسان ما تماس بگیرید.</p>
                    <div style="margin-top:20px; padding-top:20px; border-top:1px solid rgba(255,255,255,0.2); font-size:0.8rem; opacity:0.7;">
                        ساعات پاسخگویی: شنبه تا چهارشنبه ۸ الی ۱۷
                    </div>
                </div>

            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const container = document.querySelector('.floating-container');
                container.style.opacity = '0';
                container.style.transform = 'translateY(30px)';
                container.style.transition = 'all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1)';

                setTimeout(() => {
                    container.style.opacity = '1';
                    container.style.transform = 'translateY(0)';
                }, 200);
            });
        </script>
    }