@model final_p_01.ViewModels.BlogListViewModel
@using System.Text.Json
@inject final_p_01.Services.ISiteUrlBuilder UrlBuilder
@{
    ViewData["Title"] = "مجله پدل دارابی کو | راهنمای تخصصی ساخت زمین پدل";
    ViewData["MetaDescription"] = "راهنمای طراحی، ساخت و نگهداری زمین پدل؛ مشخصات فنی و تجربه پروژه‌های دارابی‌کو را بخوانید.";
    int currentPage = Model.CurrentPage < 1 ? 1 : Model.CurrentPage;
    string PageUrl(int page) => Url.Action("Blog", "Home", new { page = page > 1 ? (int?)page : null, category = Model.SelectedCategory }) ?? "/blog";
    ViewData["Canonical"] = UrlBuilder.Absolute(PageUrl(currentPage));
}
@section Head {
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(new Dictionary<string, object> {
        ["@context"] = "https://schema.org", ["@type"] = "CollectionPage", ["name"] = "مجله پدل دارابی کو", ["url"] = ViewData["Canonical"]!,
        ["mainEntity"] = new Dictionary<string, object> { ["@type"] = "ItemList", ["itemListElement"] = Model.Posts.Select((p, i) => new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = i + 1, ["url"] = UrlBuilder.Absolute("/blog/" + Uri.EscapeDataString(p.Slug)), ["name"] = p.Title }) }
    }))</script>
}
<section class="editorial-page" dir="rtl">
    <header class="editorial-header">
        <p class="editorial-eyebrow">دانش ساخت، تصمیم روشن</p>
        <h1>مجله پدل دارابی کو</h1>
        <p>از انتخاب زمین تا نگهداری کورت؛ راهنمای فنی برای تصمیم‌های پروژه شما.</p>
    </header>
    <nav class="editorial-filters" aria-label="دسته‌بندی مقالات">
        <a href="@Url.Action("Blog", "Home")" aria-current="@(Model.SelectedCategory == null ? "page" : null)">همه مقالات</a>
        @foreach (var category in Model.Categories)
        {
            <a href="@Url.Action("Blog", "Home", new { category = category.Id })" aria-current="@(Model.SelectedCategory == category.Id ? "page" : null)">@category.Name</a>
        }
    </nav>
    <div class="editorial-grid">
        @foreach (var post in Model.Posts)
        {
            @await Html.PartialAsync("_PostCard", post)
        }
    </div>
    @if (!Model.Posts.Any())
    {
        <div class="editorial-empty"><h2>هنوز مقاله‌ای در این دسته منتشر نشده است</h2><p>راهنمای جامع ساخت را بخوانید یا سایر دسته‌ها را بررسی کنید.</p><a href="/padel-court-construction-guide">راهنمای ساخت زمین پدل</a></div>
    }
    @if (Model.TotalPages > 1)
    {
        <nav class="editorial-filters" aria-label="صفحه‌بندی مقالات">
            @if (currentPage > 1) { <a href="@PageUrl(currentPage - 1)" rel="prev">قبلی</a> }
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(Model.TotalPages, currentPage + 2); i++)
            { <a href="@PageUrl(i)" aria-current="@(i == currentPage ? "page" : null)">@i</a> }
            @if (currentPage < Model.TotalPages) { <a href="@PageUrl(currentPage + 1)" rel="next">بعدی</a> }
        </nav>
    }
</section>
