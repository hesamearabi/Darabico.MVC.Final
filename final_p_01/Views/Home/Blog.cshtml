@model final_p_01.ViewModels.BlogListViewModel
@using System.Text.Json
@inject final_p_01.Services.ISiteUrlBuilder UrlBuilder

@{
    ViewData["Title"] = Model.CurrentPage > 1 ? $"مجله آموزشی پدل - صفحه {Model.CurrentPage}" : "مجله آموزشی پدل";
    ViewData["MetaDescription"] = Model.CurrentPage > 1
        ? $"آرشیو مقالات و آموزش‌های تخصصی ساخت زمین پدل دارابی کو - صفحه {Model.CurrentPage}"
        : "مرجع تخصصی مقالات، آموزش‌ها و راهنمای ساخت، تجهیز و سرمایه‌گذاری زمین پدل در ایران.";
    ViewData["Canonical"] = Model.CurrentPage > 1
        ? UrlBuilder.Absolute($"blog?page={Model.CurrentPage}")
        : UrlBuilder.Absolute("blog");
    ViewData["OgImage"] = UrlBuilder.Absolute("images/H-IMG/man-playing-padel-9KR4F3U-e1750063137155-compressed.webp");
    ViewData["OgImageWidth"] = "1920";
    ViewData["OgImageHeight"] = "1080";
    ViewData["OgImageAlt"] = "مجله آموزشی ساخت و تجهیز زمین پدل دارابی کو";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "ItemList",
            "itemListElement": [
                @if (Model.Posts != null && Model.Posts.Any())
                {
                            int index = 1;
                            var postList = Model.Posts.ToList();
                            for (int i = 0; i < postList.Count; i++)
                            {
                                        var post = postList[i];
                                        string normalizedPostSlug = (post.Slug ?? string.Empty).Trim().ToLowerInvariant();
                                        <text>
                                        {
                                            "@@type": "ListItem",
                                            "position": @index,
                                            "url": "@UrlBuilder.Absolute($"blog/{normalizedPostSlug}")",
                                            "name": @Html.Raw(JsonSerializer.Serialize(post.Title))
                                        }
                                        @(i < postList.Count - 1 ? "," : "")
                                        </text>
                                        index++;
                            }
                }
            ]
        }
    </script>

    <style>
        .blog-page-wrapper {
            padding: 120px 24px 80px;
            max-width: 1200px;
            margin: 0 auto;
            font-family: var(--ws-font, WorkspaceDana, Dana, Tahoma, sans-serif);
        }

        .blog-header {
            text-align: center;
            margin-bottom: 64px;
        }

            .blog-header h1 {
                font-size: clamp(2rem, 4vw, 3rem);
                font-weight: 700;
                color: #1d1d1f;
                letter-spacing: -0.015em;
                margin-bottom: 12px;
            }

            .blog-header p {
                color: #86868b;
                font-size: 1.125rem;
                max-width: 600px;
                margin: 0 auto;
            }

        .blog-cards {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 32px;
        }

        .blog-card {
            background-color: #ffffff;
            border-radius: 18px;
            overflow: hidden;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            border: 1px solid #e5e5ea;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .blog-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
            }

        .blog-img {
            width: 100%;
            aspect-ratio: 16 / 9;
            overflow: hidden;
            background-color: #f5f5f7;
        }

            .blog-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

        .blog-card:hover .blog-img img {
            transform: scale(1.03);
        }

        .blog-info {
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .blog-category {
            color: #0066cc;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }

        .blog-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #1d1d1f;
            line-height: 1.4;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .pagination-container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 80px;
            gap: 8px;
        }

        .page-item {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: transparent;
            color: #1d1d1f;
            text-decoration: none;
            font-weight: 500;
            font-size: 1rem;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

            .page-item:hover {
                background-color: #f5f5f7;
            }

            .page-item.active {
                background-color: #1d1d1f;
                color: #ffffff;
            }

            .page-item.disabled {
                opacity: 0.4;
                pointer-events: none;
            }

        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 64px 20px;
            color: #86868b;
            font-size: 1.125rem;
            background-color: #f5f5f7;
            border-radius: 18px;
        }

        .blog-card:focus-visible,
        .page-item:focus-visible {
            outline: 3px solid #0066cc;
            outline-offset: 3px;
        }

        @@media (max-width: 480px) {
            .blog-page-wrapper {
                padding: 104px 16px 56px;
            }

            .blog-header {
                margin-bottom: 40px;
            }

            .blog-cards {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .blog-info {
                padding: 18px;
            }

            .pagination-container {
                margin-top: 48px;
                flex-wrap: wrap;
            }

            .page-item {
                width: 44px;
                height: 44px;
            }
        }
    </style>
}

<div class="blog-page-wrapper">
    <header class="blog-header" dir="rtl">
        <h1>مجله پدل دارابی کو</h1>
        <p>مرجع تخصصی مقالات، آموزش‌ها و راهنمای ساخت زمین پدل</p>
    </header>

    <div class="blog-cards" dir="rtl">
        @if (Model.Posts != null && Model.Posts.Any())
        {
            int cardIndex = 0;
            foreach (var post in Model.Posts)
            {
                bool isFirstRow = cardIndex < 3;
                string cardAlt = !string.IsNullOrWhiteSpace(post.CoverImageAlt) ? post.CoverImageAlt : post.Title;
                string imageSrc = !string.IsNullOrEmpty(post.CoverImagePath) ? Url.Content(post.CoverImagePath) : Url.Content("~/images/H-IMG/133.webp");
                <a asp-controller="Home" asp-action="Post" asp-route-slug="@post.Slug" class="blog-card" aria-label="مطالعه مقاله @post.Title">
                    <div class="blog-img">
                        <img src="@imageSrc" alt="@cardAlt" width="640" height="360" loading="@(isFirstRow ? "eager" : "lazy")" decoding="@(isFirstRow ? "sync" : "async")" fetchpriority="@(cardIndex == 0 ? "high" : null)">
                    </div>
                    <div class="blog-info">
                        <span class="blog-category">
                            @(post.CategoryName ?? "بدون دسته‌بندی")
                        </span>
                        <h2 class="blog-title">@post.Title</h2>
                    </div>
                </a>
                cardIndex++;
            }
        }
        else
        {
            <div class="empty-state">
                در حال حاضر مقاله‌ای منتشر نشده است.
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="صفحات وبلاگ">
            <div class="pagination-container" dir="ltr">
                @if (Model.CurrentPage > 1)
                {
                    int prevPage = Model.CurrentPage - 1;
                    <a asp-action="Blog" asp-route-page="@(prevPage == 1 ? null : prevPage)" class="page-item" title="صفحه قبلی" aria-label="قبلی">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                    </a>
                }
                else
                {
                    <span class="page-item disabled" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                    </span>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-action="Blog" asp-route-page="@(i == 1 ? null : i)" class="page-item @(i == Model.CurrentPage ? "active" : "")" aria-current="@(i == Model.CurrentPage ? "page" : null)">@i</a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="Blog" asp-route-page="@(Model.CurrentPage + 1)" class="page-item" title="صفحه بعدی" aria-label="بعدی">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                    </a>
                }
                else
                {
                    <span class="page-item disabled" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                    </span>
                }
            </div>
        </nav>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const header = document.getElementById("main-header");
            if (header) {
                header.style.background = "rgba(255, 255, 255, 0.8)";
                header.style.backdropFilter = "blur(12px)";
                header.style.webkitBackdropFilter = "blur(12px)";
                header.classList.add("scrolled");
            }
        });
    </script>
}