@model final_p_01.Domain.Entities.Post
@using Ganss.Xss
@using System.Text.Json

@{
    // 🚀 Pillar SEO: عناوین و دیسکریپشن جامع در صورت خالی بودن دیتابیس
    ViewData["Title"] = Model?.Title ?? "راهنمای جامع 0 تا 100 ساخت زمین پدل | دارابی کو";
    ViewData["MetaDescription"] = Model?.MetaDescription ?? "جامع‌ترین راهنمای ساخت زمین پدل در ایران؛ بررسی ابعاد استاندارد، متریال، شیشه‌های سکوریت و برآورد دقیق هزینه‌های احداث کورت.";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string coverImage = !string.IsNullOrWhiteSpace(Model?.CoverImagePath) ? Model.CoverImagePath : "/H-IMG/man-playing-padel-9KR4F3U-e1750063137155-compressed.webp";
    string absoluteCoverImage = $"{Context.Request.Scheme}://{Context.Request.Host}{coverImage}";
    string absoluteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/padel-court-construction-guide";

    var sanitizer = new HtmlSanitizer();
    sanitizer.AllowedTags.Add("iframe");
    sanitizer.AllowedTags.Add("video");
    sanitizer.AllowedTags.Add("source");
    sanitizer.AllowedTags.Add("div");
    sanitizer.AllowedAttributes.Add("allowfullscreen");
    sanitizer.AllowedAttributes.Add("webkitallowfullscreen");
    sanitizer.AllowedAttributes.Add("mozallowfullscreen");
    sanitizer.AllowedAttributes.Add("frameborder");
    sanitizer.AllowedAttributes.Add("controls");
    sanitizer.AllowedAttributes.Add("style");
    sanitizer.AllowedAttributes.Add("class");
    sanitizer.AllowedAttributes.Add("id");

    sanitizer.FilterUrl += (sender, args) =>
    {
        if (args.Tag.TagName.ToLower() == "iframe" && !args.OriginalUrl.StartsWith("https://www.aparat.com/"))
            args.SanitizedUrl = null;
    };

    string processedContent = sanitizer.Sanitize(Model?.Content ?? "<p>محتوای راهنما در حال بروزرسانی است...</p>");

    var safeFaqs = Model?.Faqs?.Select(f => new
    {
        Question = f.Question,
        Answer = sanitizer.Sanitize((f.Answer ?? "").Replace("\n", "<br/>"))
    }).ToList();
}

@section Hero { }

    @section Head {
        <link rel="preload" as="image" href="@coverImage" fetchpriority="high">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

        <!-- 🚀 SEO: تولید خودکار Rich Snippets اختصاصی برای صفحه Pillar -->
        <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@graph": [
                {
                  "@@type": "Article",
                  "headline": @Html.Raw(JsonSerializer.Serialize(Model?.Title ?? "راهنمای ساخت زمین پدل")),
                  "image": "@absoluteCoverImage",
                  "datePublished": "@(Model?.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))",
                  "author": {
                    "@@type": "Organization",
                    "name": "دارابی کو",
                    "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")"
                  },
                  "publisher": {
                    "@@type": "Organization",
                    "name": "دارابی کو",
                    "logo": {
                      "@@type": "ImageObject",
                      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/siteLOGO/sitelogo.png")"
                    }
                  },
                  "mainEntityOfPage": {
                    "@@type": "WebPage",
                    "@@id": "@absoluteUrl"
                  }
                },
                {
                  "@@type": "BreadcrumbList",
                  "itemListElement": [
                    {
                      "@@type": "ListItem",
                      "position": 1,
                      "name": "خانه",
                      "item": "@($"{Context.Request.Scheme}://{Context.Request.Host}/")"
                    },
                    {
                      "@@type": "ListItem",
                      "position": 2,
                      "name": "راهنمای ساخت زمین پدل"
                    }
                  ]
                }
                @if (safeFaqs != null && safeFaqs.Any())
                {
                    <text>
                    ,{
                      "@@type": "FAQPage",
                      "mainEntity": [
                        @for (int i = 0; i < safeFaqs.Count; i++)
                        {
                              var faq = safeFaqs[i];
                              <text>
                              {
                                "@@type": "Question",
                                "name": @Html.Raw(JsonSerializer.Serialize(faq.Question)),
                                "acceptedAnswer": {
                                  "@@type": "Answer",
                                  "text": @Html.Raw(JsonSerializer.Serialize(faq.Answer))
                                }
                              }
                              @(i < safeFaqs.Count - 1 ? "," : "")
                              </text>
                        }
                      ]
                    }
                    </text>
                }
              ]
            }
        </script>

        <style>
            :root {
                --pd-bg: #f8fafc;
                --pd-card: #ffffff;
                --pd-text-main: #0f172a;
                --pd-text-muted: #64748b;
                --pd-primary: #0056b3;
                --pd-accent: #d11e32;
                --pd-navy: #0a0c12;
                --pd-radius-xl: 24px;
                --pd-radius-lg: 16px;
                --pd-radius-md: 12px;
                --pd-shadow: 0 10px 40px rgba(0,0,0,0.04);
                --pd-transition: all 0.3s ease;
            }

            body {
                background-color: var(--pd-bg) !important;
            }

            * {
                box-sizing: border-box;
            }

            /* Pillar Hero */
            .pd-hero {
                position: relative;
                width: 100%;
                height: 70vh;
                min-height: 500px;
                background-image: url('@coverImage');
                background-size: cover;
                background-position: center;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-top: 0;
                padding-top: 80px;
            }

                .pd-hero::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(to top, rgba(10, 12, 18, 0.95) 0%, rgba(10, 12, 18, 0.6) 50%, rgba(10, 12, 18, 0.3) 100%);
                }

            .pd-hero-content {
                position: relative;
                z-index: 2;
                text-align: center;
                color: #fff;
                max-width: 900px;
                padding: 0 20px;
            }

            .pd-title {
                font-size: clamp(2.2rem, 4.5vw, 4rem);
                font-weight: 900;
                line-height: 1.3;
                margin-bottom: 25px;
                margin-top: 0;
                text-shadow: 0 4px 20px rgba(0,0,0,0.4);
                color: #fff;
            }

            .pd-badge {
                display: inline-block;
                background: var(--pd-accent);
                color: #fff;
                padding: 6px 16px;
                border-radius: 50px;
                font-size: 0.9rem;
                font-weight: 800;
                margin-bottom: 20px;
                letter-spacing: 1px;
            }

            /* Pillar Container */
            .pd-container {
                max-width: 900px;
                margin: -60px auto 80px;
                background: var(--pd-card);
                border-radius: var(--pd-radius-xl);
                padding: 60px 70px;
                box-shadow: var(--pd-shadow);
                position: relative;
                z-index: 10;
            }

            .pd-body {
                font-size: 1.15rem;
                line-height: 2.2;
                color: var(--pd-text-muted);
                text-align: justify;
            }

                .pd-body h2 {
                    color: var(--pd-primary);
                    font-size: 1.8rem;
                    font-weight: 900;
                    margin-top: 3rem;
                    margin-bottom: 1.2rem;
                    border-bottom: 2px solid #f1f5f9;
                    padding-bottom: 10px;
                }

                .pd-body h3 {
                    color: var(--pd-text-main);
                    font-weight: 800;
                    margin-top: 2rem;
                    margin-bottom: 1rem;
                }

                .pd-body img {
                    max-width: 100% !important;
                    height: auto !important;
                    border-radius: var(--pd-radius-md);
                    margin: 2rem 0;
                    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
                }

                .pd-body .aparat-embed-wrapper {
                    position: relative !important;
                    width: 100% !important;
                    padding-bottom: 56.25% !important;
                    height: 0 !important;
                    margin: 2.5rem 0 !important;
                    border-radius: 16px !important;
                    overflow: hidden !important;
                    background-color: #000 !important;
                    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15) !important;
                }

                    .pd-body .aparat-embed-wrapper iframe {
                        position: absolute !important;
                        top: 0 !important;
                        left: 0 !important;
                        width: 100% !important;
                        height: 100% !important;
                        border: none !important;
                    }

            /* FAQ Section */
            .pd-faq-wrapper {
                margin-top: 4rem;
                padding-top: 3rem;
                border-top: 2px dashed #f1f5f9;
            }

            .pd-faq-title {
                font-size: 1.8rem;
                font-weight: 900;
                color: var(--pd-text-main);
                margin-bottom: 2rem;
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .pd-faq-title i {
                    color: var(--pd-primary);
                }

            .pd-details {
                background: #fff;
                border: 1px solid #e2e8f0;
                border-radius: var(--pd-radius-md);
                margin-bottom: 1rem;
                overflow: hidden;
                transition: var(--pd-transition);
            }

            .pd-summary {
                padding: 1.25rem 1.5rem;
                font-weight: 700;
                font-size: 1.1rem;
                color: var(--pd-text-main);
                cursor: pointer;
                list-style: none;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

                .pd-summary::-webkit-details-marker {
                    display: none;
                }

                .pd-summary::after {
                    content: '\F282';
                    font-family: "bootstrap-icons";
                    font-size: 1.2rem;
                    color: var(--pd-primary);
                    transition: transform 0.3s ease;
                }

            .pd-details[open] .pd-summary {
                color: var(--pd-primary);
                background: #f8fafc;
            }

                .pd-details[open] .pd-summary::after {
                    transform: rotate(180deg);
                }

            .pd-answer {
                padding: 0 1.5rem 1.5rem;
                color: var(--pd-text-secondary);
                line-height: 1.9;
                background: #f8fafc;
            }

            /* CTA */
            .pd-cta {
                background: linear-gradient(135deg, var(--pd-navy) 0%, #1e293b 100%);
                border-radius: var(--pd-radius-lg);
                padding: 3rem;
                margin-top: 4rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 30px;
                box-shadow: 0 20px 40px rgba(10, 12, 18, 0.2);
                flex-wrap: wrap;
            }

            .pd-cta-text h4 {
                color: #fff;
                font-size: 1.8rem;
                font-weight: 900;
                margin-bottom: 0.8rem;
                margin-top: 0;
            }

            .pd-cta-text p {
                color: #cbd5e1;
                font-size: 1.05rem;
                margin: 0;
                line-height: 1.8;
            }

            .pd-cta-actions {
                display: flex;
                gap: 12px;
                align-items: center;
                flex-wrap: wrap;
            }

            .pd-btn {
                background: var(--pd-primary);
                color: #fff;
                padding: 14px 28px;
                border-radius: 50px;
                font-weight: 700;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: var(--pd-transition);
                height: 50px;
                border: none;
            }

                .pd-btn:hover {
                    background: #004494;
                    transform: translateY(-3px);
                    color: #fff;
                }

            @@media (max-width: 768px) {
                .pd-hero {
                    height: auto;
                    padding-top: 120px;
                    padding-bottom: 80px;
                }

                .pd-title {
                    font-size: 2.2rem;
                }

                .pd-container {
                    margin: -40px 15px 50px;
                    padding: 30px 20px;
                }

                .pd-cta {
                    flex-direction: column;
                    text-align: center;
                }

                .pd-cta-actions {
                    justify-content: center;
                }

                .pd-body {
                    font-size: 1.05rem;
                }
            }
        </style>
    }

    <div class="pd-hero">
        <div class="pd-hero-content">
            <span class="pd-badge">Pillar Content</span>
            <h1 class="pd-title">@(Model?.Title ?? "راهنمای جامع صفر تا صد ساخت زمین پدل")</h1>
        </div>
    </div>

    <main class="pd-container">
        <article class="pd-body">
            @Html.Raw(processedContent)
        </article>

        @if (safeFaqs != null && safeFaqs.Any())
        {
            <div class="pd-faq-wrapper">
                <h3 class="pd-faq-title"><i class="bi bi-patch-question-fill"></i> سوالات متداول</h3>
                <div class="pd-faq-list">
                    @foreach (var faq in safeFaqs)
                    {
                        <details class="pd-details">
                            <summary class="pd-summary">@faq.Question</summary>
                            <div class="pd-answer">@Html.Raw(faq.Answer)</div>
                        </details>
                    }
                </div>
            </div>
        }

        <div class="pd-cta">
            <div class="pd-cta-text">
                <h4>پروژه خود را با مطمئن‌ترین تیم ایران آغاز کنید</h4>
                <p>مشاوره رایگان، تامین شیشه‌های استاندارد و اجرای تضمینی.</p>
            </div>
            <div class="pd-cta-actions">
                <a asp-controller="Home" asp-action="Contact" class="pd-btn">
                    <i class="bi bi-telephone-fill"></i> ارتباط با مهندسین دارابی کو
                </a>
            </div>
        </div>
    </main>

    @section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                document.body.classList.remove('loading-state');
                const header = document.getElementById("main-header");
                if (header && !header.classList.contains("scrolled")) {
                    header.style.background = "rgba(10, 12, 18, 0.95)";
                    header.style.backdropFilter = "blur(10px)";
                    header.classList.add("scrolled");
                }
            });
        </script>
    }