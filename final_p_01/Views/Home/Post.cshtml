@model final_p_01.Models.PostDetailsViewModel
@using System.Linq
@using System.Collections
@using System.Collections.Generic
@using Ganss.Xss
@using System.Text.Json
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = Model.Post.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    string coverImage = !string.IsNullOrWhiteSpace(Model.Post.CoverImagePath) ? Model.Post.CoverImagePath : "/H-IMG/133.webp";
    string coverAlt = !string.IsNullOrWhiteSpace(Model.Post.CoverImageAlt) ? Model.Post.CoverImageAlt : Model.Post.Title;
    string absoluteCoverImage = $"{Context.Request.Scheme}://{Context.Request.Host}{coverImage}";

    string currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";

    var sanitizer = new HtmlSanitizer();

    var allowedTags = new[] { "p", "br", "strong", "em", "u", "b", "i", "ul", "ol", "li", "a", "span", "h1", "h2", "h3", "h4", "h5", "h6", "table", "tbody", "thead", "tr", "td", "th", "img", "figure", "figcaption", "blockquote", "iframe", "video", "source", "div" };
    foreach (var tag in allowedTags) { sanitizer.AllowedTags.Add(tag); }

    var allowedAttributes = new[] { "href", "src", "alt", "title", "allow", "referrerpolicy", "width", "height", "target", "rel", "allowfullscreen", "webkitallowfullscreen", "mozallowfullscreen", "frameborder", "controls", "preload", "style", "class", "id", "dir", "loading", "decoding", "fetchpriority" };
    foreach (var attr in allowedAttributes) { sanitizer.AllowedAttributes.Add(attr); }

    sanitizer.FilterUrl += (sender, args) =>
    {
        if (args.Tag.TagName.ToLower() == "iframe" &&
            !args.OriginalUrl.StartsWith("https://www.aparat.com/") &&
            !args.OriginalUrl.StartsWith("https://www.youtube.com/"))
        {
            args.SanitizedUrl = null;
        }
    };

    sanitizer.PostProcessNode += (sender, args) =>
    {
        if (args.Node.NodeName.Equals("IMG", System.StringComparison.OrdinalIgnoreCase))
        {
            var img = (AngleSharp.Dom.IElement)args.Node;
            if (!img.HasAttribute("loading")) img.SetAttribute("loading", "lazy");
            if (!img.HasAttribute("decoding")) img.SetAttribute("decoding", "async");
            if (!img.HasAttribute("alt") || string.IsNullOrWhiteSpace(img.GetAttribute("alt")))
            {
                img.SetAttribute("alt", Model.Post.Title ?? "تصویر مقاله");
            }
        }
    };

    string ProcessAllVideos(string rawHtml)
    {
        if (string.IsNullOrWhiteSpace(rawHtml)) return string.Empty;

        var tokens = new Dictionary<string, string>();
        int tokenIndex = 0;

        string CreateVideoToken(string embedHtml)
        {
            string key = $"__DARABICO_MEDIA_TOKEN_{tokenIndex++}__";
            tokens[key] = embedHtml;
            return key;
        }

        string BuildYoutubeShortsHtml(string id) =>
            $"\u003Cdiv class=\"video-shorts-wrapper\"\u003E\u003Ciframe src=\"https://www.youtube.com/embed/{id}\" allowfullscreen loading=\"lazy\"\u003E\u003C/iframe\u003E\u003C/div\u003E";

        string BuildYoutubeNormalHtml(string id) =>
            $"\u003Cdiv class=\"video-normal-wrapper\"\u003E\u003Ciframe src=\"https://www.youtube.com/embed/{id}\" allowfullscreen loading=\"lazy\"\u003E\u003C/iframe\u003E\u003C/div\u003E";

        string BuildAparatShortsHtml(string id)
        {
            if (Regex.IsMatch(id, "^\\d+$"))
            {
                return $@"
                <div class=""video-shorts-wrapper mceNonEditable"" style=""width:100%; max-width:340px; aspect-ratio:9/16; margin:2.5rem auto; border-radius:20px; overflow:hidden; background:linear-gradient(135deg, #1e293b, #0f172a); border: 2px solid #cbd5e1; box-shadow: 0 15px 35px rgba(0,0,0,0.15); display:flex; align-items:center; justify-content:center; flex-direction:column; position:relative; text-align:center; padding: 20px;"">
                    <div style=""width: 80px; height: 80px; border-radius: 50%; background: #ea1d5d; display:flex; align-items:center; justify-content:center; margin-bottom: 20px; box-shadow: 0 10px 25px rgba(234, 29, 93, 0.4);"">
                        <i class=""bi bi-play-fill"" style=""font-size: 40px; color: #fff; margin-left: 5px;""></i>
                    </div>
                    <h4 style=""color: #fff; font-size: 1.2rem; font-weight: 800; margin-bottom: 10px; font-family: Tahoma;"">ویدیوی آموزشی (Shorts)</h4>
                    <p style=""color: #94a3b8; font-size: 0.9rem; margin-bottom: 25px; line-height: 1.6;"">برای مشاهده این ویدیوی کوتاه در آپارات کلیک کنید.</p>
                    <a href=""https://www.aparat.com/shorts/{id}"" target=""_blank"" style=""background: #fff; color: #ea1d5d; font-weight: bold; padding: 12px 30px; border-radius: 50px; text-decoration: none; font-size: 0.95rem; box-shadow: 0 5px 15px rgba(255,255,255,0.1);"">
                        <i class=""bi bi-box-arrow-up-right me-2""></i> پخش ویدیو
                    </a>
                </div><p><br/></p>";
            }
            return $"\u003Cdiv class=\"video-shorts-wrapper\"\u003E\u003Ciframe src=\"https://www.aparat.com/video/video/embed/videohash/{id}/vt/frame\" allowfullscreen loading=\"lazy\"\u003E\u003C/iframe\u003E\u003C/div\u003E";
        }

        string BuildAparatNormalHtml(string id) =>
            $"\u003Cdiv class=\"video-normal-wrapper\"\u003E\u003Ciframe src=\"https://www.aparat.com/video/video/embed/videohash/{id}/vt/frame\" allowfullscreen loading=\"lazy\"\u003E\u003C/iframe\u003E\u003C/div\u003E";

        string BuildSelfHostedVideoHtml(string videoUrl) =>
            $"\u003Cdiv class=\"video-shorts-wrapper\"\u003E\u003Cvideo src=\"{videoUrl}\" controls preload=\"metadata\" style=\"width:100%; height:100%; border-radius: 16px; object-fit: cover; background:#000;\"\u003E\u003C/video\u003E\u003C/div\u003E";

        string content = rawHtml;

        content = Regex.Replace(content, "\u003Cvideo[^\u003E]*\u003E.*?\u003Csource[^\u003E]*src=[\"']([^\"']+\\.mp4)[\"'][^\u003E]*\u003E.*?\u003C/video\u003E",
            m => CreateVideoToken(BuildSelfHostedVideoHtml(m.Groups[1].Value)), RegexOptions.IgnoreCase | RegexOptions.Singleline);

        content = Regex.Replace(content, "(?:\u003Cp[^\u003E]*\u003E)?\\s*(\\/uploads\\/article-videos\\/[a-zA-Z0-9_-]+\\.mp4)\\s*(?:\u003C/p\u003E)?",
            m => CreateVideoToken(BuildSelfHostedVideoHtml(m.Groups[1].Value)), RegexOptions.IgnoreCase);

        content = Regex.Replace(
            content,
            "(?:\u003Cdiv[^\u003E]*class=[\"'][^\"']*(?:aparat|video)[^\"']*[\"'][^\u003E]*\u003E\\s*)?\u003Ciframe[^\u003E]*src=[\"']([^\"']+)[\"'][^\u003E]*\u003E\\s*\u003C/iframe\u003E(?:\\s*\u003C/div\u003E)?",
            match =>
            {
                string fullTag = match.Value;
                string src = match.Groups[1].Value;
                bool isVertical = fullTag.Contains("video-shorts-wrapper", System.StringComparison.OrdinalIgnoreCase);

                var ytShort = Regex.Match(src, "youtube\\.com/shorts/([a-zA-Z0-9_-]{6,15})", RegexOptions.IgnoreCase);
                if (ytShort.Success) return CreateVideoToken(BuildYoutubeShortsHtml(ytShort.Groups[1].Value));

                var ytEmbed = Regex.Match(src, "(?:youtube\\.com/embed/|youtube\\.com/watch\\?v=|youtu\\.be/)([a-zA-Z0-9_-]{6,15})", RegexOptions.IgnoreCase);
                if (ytEmbed.Success)
                {
                    return CreateVideoToken(isVertical ? BuildYoutubeShortsHtml(ytEmbed.Groups[1].Value) : BuildYoutubeNormalHtml(ytEmbed.Groups[1].Value));
                }

                var apShort = Regex.Match(src, "aparat\\.com/shorts/(?:embed/)?([a-zA-Z0-9_-]+)", RegexOptions.IgnoreCase);
                if (apShort.Success) return CreateVideoToken(BuildAparatShortsHtml(apShort.Groups[1].Value));

                var apEmbed = Regex.Match(src, "aparat\\.com/(?:video/video/embed/videohash/|v/)([a-zA-Z0-9_-]+)", RegexOptions.IgnoreCase);
                if (apEmbed.Success)
                {
                    string hash = apEmbed.Groups[1].Value;
                    bool isNumeric = Regex.IsMatch(hash, "^\\d{10,}$");
                    return CreateVideoToken((isVertical || isNumeric) ? BuildAparatShortsHtml(hash) : BuildAparatNormalHtml(hash));
                }

                return fullTag;
            },
            RegexOptions.IgnoreCase | RegexOptions.Singleline);

        content = Regex.Replace(
            content,
            "\u003Ca[^\u003E]*href=[\"']((?:https?://)?(?:www\\.|m\\.)?(?:youtube\\.com|youtu\\.be|aparat\\.com)[^\"']*)[\"'][^\u003E]*\u003E.*?\u003C/a\u003E",
            "$1",
            RegexOptions.IgnoreCase | RegexOptions.Singleline);

        content = Regex.Replace(content, "(width|height)=[\"'][^\"']*[\"']", "", RegexOptions.IgnoreCase);
        content = Regex.Replace(content, "style=[\"'][^\"']*[\"']", "", RegexOptions.IgnoreCase);

        content = Regex.Replace(content, "(?:https?://)?(?:www\\.|m\\.)?youtube\\.com/shorts/([a-zA-Z0-9_-]{6,15})(?:\\?[^\\s\u003C\"']*)?", m => CreateVideoToken(BuildYoutubeShortsHtml(m.Groups[1].Value)), RegexOptions.IgnoreCase);
        content = Regex.Replace(content, "(?:https?://)?(?:www\\.)?aparat\\.com/shorts/(?:embed/)?([a-zA-Z0-9_-]+)(?:\\?[^\\s\u003C\"']*)?", m => CreateVideoToken(BuildAparatShortsHtml(m.Groups[1].Value)), RegexOptions.IgnoreCase);
        content = Regex.Replace(content, "(?:https?://)?(?:www\\.|m\\.)?(?:youtube\\.com/watch\\?v=|youtu\\.be/|youtube\\.com/embed/)([a-zA-Z0-9_-]{6,15})(?:[&?][^\\s\u003C\"']*)?", m => CreateVideoToken(BuildYoutubeNormalHtml(m.Groups[1].Value)), RegexOptions.IgnoreCase);
        content = Regex.Replace(content, "(?:https?://)?(?:www\\.)?aparat\\.com/v/([a-zA-Z0-9_-]+)(?:\\?[^\\s\u003C\"']*)?", m => CreateVideoToken(BuildAparatNormalHtml(m.Groups[1].Value)), RegexOptions.IgnoreCase);

        foreach (var kvp in tokens)
        {
            content = Regex.Replace(content, $"(?:\u003Cp[^\u003E]*\u003E\\s*(?:&nbsp;)*\\s*)?{Regex.Escape(kvp.Key)}(?:\\s*(?:&nbsp;)*\\s*\u003C/p\u003E)?", kvp.Value, RegexOptions.IgnoreCase);
        }

        return content;
    }

    string sanitizedRaw = Model != null ? sanitizer.Sanitize(Model.Post.Content ?? "") : "";
    string processedContent = ProcessAllVideos(sanitizedRaw);

    string FormatFaqAnswer(string? rawAnswer)
    {
        if (string.IsNullOrWhiteSpace(rawAnswer)) return string.Empty;
        bool containsHtml = rawAnswer.Contains("\u003Cp\u003E") || rawAnswer.Contains("\u003Cbr") || rawAnswer.Contains("\u003Cdiv\u003E") || rawAnswer.Contains("\u003Cul\u003E");
        string preparedText = containsHtml ? rawAnswer : rawAnswer.Replace("\r\n", "\n").Replace("\n", "\u003Cbr/\u003E");
        return sanitizer.Sanitize(preparedText);
    }

    string schemaJson = "";
    if (Model != null)
    {
        var schema = new Hashtable();
        schema["\u0040context"] = "https://schema.org";
        var graph = new ArrayList();

        var webPageNode = new Hashtable { ["\u0040type"] = "WebPage", ["\u0040id"] = currentUrl, ["url"] = currentUrl, ["name"] = Model.Post.Title };
        graph.Add(webPageNode);

        var authorNode = new Hashtable { ["\u0040type"] = "Organization", ["name"] = "دارابی کو" };
        var logoNode = new Hashtable { ["\u0040type"] = "ImageObject", ["url"] = $"{Context.Request.Scheme}://{Context.Request.Host}/siteLOGO/sitelogo.png" };
        var publisherNode = new Hashtable { ["\u0040type"] = "Organization", ["name"] = "دارابی کو", ["logo"] = logoNode };
        var ratingNode = new Hashtable { ["\u0040type"] = "AggregateRating", ["ratingValue"] = Model.Post.AverageRating.ToString(), ["bestRating"] = "5", ["ratingCount"] = Model.Post.TotalVotes.ToString() };

        var articleNode = new Hashtable
        {
            ["\u0040type"] = "Article",
            ["headline"] = Model.Post.Title,
            ["image"] = absoluteCoverImage,
            ["datePublished"] = Model.Post.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ"),
            ["author"] = authorNode,
            ["publisher"] = publisherNode,
            ["aggregateRating"] = ratingNode
        };
        graph.Add(articleNode);

        var item1 = new Hashtable { ["\u0040type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = $"{Context.Request.Scheme}://{Context.Request.Host}/" };
        var item2 = new Hashtable { ["\u0040type"] = "ListItem", ["position"] = 2, ["name"] = "مقالات", ["item"] = $"{Context.Request.Scheme}://{Context.Request.Host}/Blog" };
        var item3 = new Hashtable { ["\u0040type"] = "ListItem", ["position"] = 3, ["name"] = Model.Post.Title, ["item"] = currentUrl };
        var breadcrumbNode = new Hashtable { ["\u0040type"] = "BreadcrumbList", ["itemListElement"] = new[] { item1, item2, item3 } };
        graph.Add(breadcrumbNode);

        if (Model.Post.Faqs != null && Model.Post.Faqs.Any())
        {
            var faqList = new ArrayList();
            foreach (var f in Model.Post.Faqs)
            {
                var ansNode = new Hashtable { ["\u0040type"] = "Answer", ["text"] = FormatFaqAnswer(f.Answer) };
                var qNode = new Hashtable { ["\u0040type"] = "Question", ["name"] = f.Question, ["acceptedAnswer"] = ansNode };
                faqList.Add(qNode);
            }
            var faqPageNode = new Hashtable { ["\u0040type"] = "FAQPage", ["mainEntity"] = faqList };
            graph.Add(faqPageNode);
        }

        schema["\u0040graph"] = graph;
        schemaJson = JsonSerializer.Serialize(schema, new JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
    }
}

@section Hero { }

    @section Head {
        <link rel="preload" as="image" href="@coverImage" fetchpriority="high" />
        <link rel="canonical" href="@currentUrl" />
        <meta property="og:title" content="@ViewData["Title"]" />
        <meta property="og:description" content="@(ViewData["MetaDescription"] ?? Model?.Post.Title)" />
        <meta property="og:type" content="article" />
        <meta property="og:url" content="@currentUrl" />
        <meta property="og:image" content="@absoluteCoverImage" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

        @if (!string.IsNullOrEmpty(schemaJson))
        {
            <script type="application/ld+json">@Html.Raw(schemaJson)</script>
        }

        <style>
            :root {
                --pd-bg: #f8fafc;
                --pd-card: #ffffff;
                --pd-text-main: #0f172a;
                --pd-text-muted: #475569;
                --pd-primary: #0056b3;
                --pd-accent: #d11e32;
                --pd-navy: #0a0c12;
                --pd-radius-xl: 24px;
                --pd-radius-lg: 16px;
                --pd-radius-md: 12px;
                --pd-shadow: 0 10px 40px rgba(0,0,0,0.04);
                --pd-transition: all 0.3s ease;
            }

            body {
                background-color: var(--pd-bg) !important;
            }

            * {
                box-sizing: border-box;
            }

            .pd-hero {
                position: relative;
                width: 100%;
                height: 60vh;
                min-height: 450px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-top: 0;
                padding-top: 80px;
                overflow: hidden;
                background-color: var(--pd-navy);
            }

            .pd-hero-img {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: 0;
            }

            .pd-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to top, rgba(10, 12, 18, 0.95) 0%, rgba(10, 12, 18, 0.5) 50%, rgba(10, 12, 18, 0.2) 100%);
                z-index: 1;
                pointer-events: none;
            }

            .pd-hero-content {
                position: relative;
                z-index: 2;
                text-align: center;
                color: #fff;
                max-width: 900px;
                padding: 0 20px;
                width: 100%;
            }

            .pd-breadcrumb {
                display: inline-flex;
                align-items: center;
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(10px);
                -webkit-backdrop-filter: blur(10px);
                padding: 8px 24px;
                border-radius: 50px;
                border: 1px solid rgba(255,255,255,0.1);
                margin: 0 0 25px 0;
                font-size: 0.85rem;
                color: #f8fafc;
                list-style: none;
                flex-wrap: wrap;
                justify-content: center;
            }

                .pd-breadcrumb li {
                    display: inline-flex;
                    align-items: center;
                }

                .pd-breadcrumb a {
                    color: #fff;
                    text-decoration: none;
                    transition: var(--pd-transition);
                }

                    .pd-breadcrumb a:hover, .pd-breadcrumb a:focus-visible {
                        color: var(--pd-accent);
                        outline: none;
                    }

                .pd-breadcrumb .sep {
                    margin: 0 10px;
                    opacity: 0.7;
                }

            .pd-title {
                font-size: clamp(2rem, 4vw, 3.5rem);
                font-weight: 900;
                line-height: 1.3;
                margin-bottom: 25px;
                margin-top: 0;
                text-shadow: 0 4px 20px rgba(0,0,0,0.4);
            }

            .pd-meta {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 25px;
                font-size: 0.95rem;
                color: #e2e8f0;
                flex-wrap: wrap;
            }

                .pd-meta span, .pd-meta time {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

                .pd-meta i {
                    color: var(--pd-accent);
                }

            .pd-container {
                max-width: 850px;
                margin: -60px auto 80px;
                background: var(--pd-card);
                border-radius: var(--pd-radius-xl);
                padding: 60px 70px;
                box-shadow: var(--pd-shadow);
                position: relative;
                z-index: 10;
            }

            .pd-body {
                font-size: 1.15rem;
                line-height: 2.2;
                color: var(--pd-text-muted);
                text-align: justify;
                word-wrap: break-word;
                overflow-wrap: break-word;
            }

                .pd-body h2, .pd-body h3 {
                    color: var(--pd-text-main);
                    font-weight: 800;
                    margin-top: 2.5rem;
                    margin-bottom: 1.2rem;
                    line-height: 1.4;
                }

                .pd-body table {
                    width: 100% !important;
                    display: block;
                    overflow-x: auto;
                    -webkit-overflow-scrolling: touch;
                    border-collapse: collapse;
                    margin: 2rem 0;
                }

                .pd-body .pdf-btn {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    background: var(--pd-primary);
                    color: #fff !important;
                    padding: 12px 28px;
                    border-radius: 50px;
                    font-weight: bold;
                    text-decoration: none;
                    box-shadow: 0 8px 20px rgba(0,86,179,0.2);
                    transition: 0.3s;
                    margin: 15px 0;
                }

                    .pd-body .pdf-btn:hover {
                        background: #004494;
                        transform: translateY(-3px);
                        box-shadow: 0 12px 25px rgba(0,86,179,0.4);
                    }

                .pd-body img {
                    max-width: 100% !important;
                    height: auto !important;
                    object-fit: contain !important;
                    border-radius: var(--pd-radius-md);
                    margin: 2rem auto !important;
                    display: block !important;
                    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
                }

            /* پلیر ریسپانسیو اختصاصی */
            .video-normal-wrapper {
                position: relative;
                width: 100%;
                aspect-ratio: 16 / 9;
                margin: 2.5rem auto;
                border-radius: 16px;
                overflow: hidden;
                background: #0a0c12;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
            }

            .video-shorts-wrapper {
                position: relative;
                width: 100%;
                max-width: 340px;
                aspect-ratio: 9 / 16;
                margin: 2.5rem auto;
                border-radius: 20px;
                overflow: hidden;
                background: #0a0c12;
                box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
                border: 3px solid #f1f5f9;
            }

                .video-normal-wrapper iframe, .video-shorts-wrapper iframe, .video-shorts-wrapper video {
                    position: absolute !important;
                    top: 0 !important;
                    left: 0 !important;
                    width: 100% !important;
                    height: 100% !important;
                    border: 0 !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    display: block !important;
                    background: #000;
                }

            /* 🚀 کارت دانلود PDF */
            .pdf-premium-card {
                background: #fff;
                border: 1px solid #e2e8f0;
                border-radius: 24px;
                padding: 25px;
                display: flex;
                align-items: center;
                gap: 25px;
                margin: 3rem 0;
                box-shadow: 0 15px 35px rgba(0,0,0,0.04);
                transition: all 0.3s ease;
            }

                .pdf-premium-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
                    border-color: #cbd5e1;
                }

            .pdf-premium-icon {
                width: 80px;
                height: 80px;
                background: linear-gradient(135deg, #eff6ff, #dbeafe);
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 3rem;
                color: #2563eb;
                flex-shrink: 0;
            }

            .pdf-premium-content {
                flex-grow: 1;
                text-align: right;
            }

            .pdf-premium-title {
                font-size: 1.4rem;
                font-weight: 900;
                color: var(--pd-navy);
                margin: 0 0 8px 0;
            }

            .pdf-premium-desc {
                font-size: 1rem;
                color: var(--pd-text-muted);
                margin: 0;
                line-height: 1.6;
            }

            .pdf-premium-btn {
                background: var(--pd-navy);
                color: #fff !important;
                padding: 14px 30px;
                border-radius: 50px;
                font-weight: 800;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
                transition: 0.3s;
                flex-shrink: 0;
                white-space: nowrap;
            }

                .pdf-premium-btn:hover {
                    background: #C5A66B;
                    color: var(--pd-navy) !important;
                    box-shadow: 0 10px 20px rgba(197,166,107,0.3);
                }

            .pd-rating-box {
                border: 1px solid #e2e8f0;
                background: #fff;
                box-shadow: 0 5px 15px rgba(0,0,0,0.02);
            }

            .pd-star-icon {
                font-size: 2.5rem;
                color: #e2e8f0;
                cursor: pointer;
                transition: 0.2s;
                padding: 0 5px;
            }

            .pd-stars {
                display: flex;
                flex-direction: row-reverse;
                justify-content: center;
                gap: 5px;
            }

                .pd-stars:hover .pd-star-icon {
                    color: #e2e8f0;
                }

            .pd-star-icon:hover, .pd-star-icon:hover ~ .pd-star-icon, .pd-star-icon.active {
                color: #f59e0b !important;
            }

            .pd-faq-wrapper {
                margin-top: 4rem;
                padding-top: 3rem;
                border-top: 2px dashed #f1f5f9;
            }

            .pd-faq-title {
                font-size: 1.8rem;
                font-weight: 900;
                color: var(--pd-text-main);
                margin-bottom: 2rem;
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .pd-faq-title i {
                    color: var(--pd-primary);
                }

            .pd-details {
                background: #fff;
                border: 1px solid #e2e8f0;
                border-radius: var(--pd-radius-md);
                margin-bottom: 1rem;
                overflow: hidden;
                transition: var(--pd-transition);
            }

                .pd-details:hover {
                    border-color: #cbd5e1;
                }

            .pd-summary {
                padding: 1.25rem 1.5rem;
                font-weight: 700;
                font-size: 1.1rem;
                color: var(--pd-text-main);
                cursor: pointer;
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: #fff;
                list-style: none;
            }

                .pd-summary::-webkit-details-marker {
                    display: none;
                }

                .pd-summary::after {
                    content: '\F282';
                    font-family: "bootstrap-icons";
                    font-size: 1.2rem;
                    color: var(--pd-primary);
                    transition: transform 0.3s ease;
                }

            .pd-details[open] .pd-summary {
                color: var(--pd-primary);
                background: #f8fafc;
            }

                .pd-details[open] .pd-summary::after {
                    transform: rotate(180deg);
                }

            .pd-answer {
                padding: 0 1.5rem 1.5rem;
                color: var(--pd-text-muted);
                line-height: 1.9;
                background: #f8fafc;
                border-top: 1px solid transparent;
            }

            .pd-cta {
                background: linear-gradient(135deg, var(--pd-navy) 0%, #1e293b 100%);
                border-radius: var(--pd-radius-lg);
                padding: 3rem;
                margin-top: 4rem;
                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                gap: 30px;
                box-shadow: 0 20px 40px rgba(10, 12, 18, 0.2);
                position: relative;
                overflow: hidden;
                flex-wrap: wrap;
            }

            .pd-cta-text {
                position: relative;
                z-index: 2;
                flex: 1 1 50%;
                min-width: 300px;
            }

                .pd-cta-text h4 {
                    color: #fff;
                    font-size: 1.8rem;
                    font-weight: 900;
                    margin-bottom: 0.8rem;
                }

                .pd-cta-text p {
                    color: #cbd5e1;
                    font-size: 1.05rem;
                    margin: 0;
                    line-height: 1.8;
                }

            .pd-cta-actions {
                position: relative;
                z-index: 2;
                display: flex;
                gap: 12px;
                align-items: center;
                flex-wrap: wrap;
            }

            .pd-btn-social {
                background: rgba(255, 255, 255, 0.05);
                color: #fff;
                width: 50px;
                height: 50px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                font-size: 1.3rem;
                text-decoration: none;
                transition: var(--pd-transition);
                border: 1px solid rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(5px);
            }

                .pd-btn-social:hover {
                    background: var(--pd-primary);
                    color: #fff;
                    transform: translateY(-3px);
                    border-color: var(--pd-primary);
                    box-shadow: 0 10px 20px rgba(0, 86, 179, 0.3);
                }

            .pd-btn {
                background: var(--pd-primary);
                color: #fff;
                padding: 14px 28px;
                border-radius: 50px;
                font-weight: 700;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: var(--pd-transition);
                box-shadow: 0 10px 20px rgba(0, 86, 179, 0.3);
                border: none;
                height: 50px;
            }

                .pd-btn:hover {
                    background: #004494;
                    transform: translateY(-3px);
                    box-shadow: 0 15px 25px rgba(0, 86, 179, 0.4);
                    color: #fff;
                }

            /* استایل‌های اضافه شده برای حل مشکل مطالب پیشنهادی (طراحی مینیمال و ریسپانسیو) */
            .pd-related-section {
                max-width: 1100px;
                margin: 40px auto 100px;
                padding: 0 20px;
                font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            }

            .pd-related-title {
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--pd-navy);
                margin-bottom: 30px;
                padding-bottom: 15px;
                border-bottom: 1px solid #e2e8f0;
            }

            .pd-related-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 24px;
            }

            .pd-card {
                background-color: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 16px;
                overflow: hidden;
                text-decoration: none;
                display: flex;
                flex-direction: column;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

                .pd-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
                }

                .pd-card > div:first-child {
                    width: 100%;
                    aspect-ratio: 16 / 9;
                    background-color: #f8fafc;
                    overflow: hidden;
                }

            .pd-card-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

            .pd-card:hover .pd-card-img {
                transform: scale(1.03);
            }

            .pd-card-body {
                padding: 20px;
                display: flex;
                flex-direction: column;
                gap: 10px;
                flex-grow: 1;
            }

            .pd-card-meta {
                font-size: 0.8rem;
                color: #64748b;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .pd-card-title {
                font-size: 1.1rem;
                font-weight: 700;
                color: var(--pd-navy);
                line-height: 1.5;
                margin: 0;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            @@media (max-width: 768px) {
                .pd-container {
                    margin: -30px 10px 40px !important;
                    padding: 30px 15px !important;
                    border-radius: 16px !important;
                }

                .pd-title {
                    font-size: 1.9rem !important;
                    padding: 0 10px;
                }

                .pdf-premium-card {
                    flex-direction: column;
                    text-align: center;
                    padding: 25px 15px;
                    gap: 15px;
                }

                .pdf-premium-content {
                    text-align: center;
                }

                .pdf-premium-action, .pdf-premium-btn {
                    width: 100%;
                    justify-content: center;
                }

                .pd-cta {
                    flex-direction: column;
                    text-align: center;
                    gap: 25px;
                    padding: 30px 20px;
                }

                .pd-cta-actions {
                    width: 100%;
                    justify-content: center;
                }
            }
        </style>
    }

    @if (Model != null)
    {
        <header class="pd-hero">
            <img src="@coverImage" alt="@(Model.Post.Title ?? "مقاله ساخت زمین پدل")" class="pd-hero-img" fetchpriority="high" decoding="sync" loading="eager" />

            <div class="pd-hero-content">
                <nav aria-label="مسیریابی صفحه">
                    <ol class="pd-breadcrumb">
                        <li><a href="/">خانه</a></li>
                        <li class="sep" aria-hidden="true">/</li>
                        <li><a asp-controller="Home" asp-action="Blog">مجله پدل</a></li>
                        <li class="sep" aria-hidden="true">/</li>
                        <li aria-current="page" style="color: #fff; font-weight: 700;">@Model.Post.Title</li>
                    </ol>
                </nav>

                <h1 class="pd-title">@Model.Post.Title</h1>

                <div class="pd-meta">
                    <span><i class="bi bi-person-circle" aria-hidden="true"></i> تحریریه دارابی کو</span>
                    <time datetime="@Model.Post.CreatedAt.ToString("yyyy-MM-dd")">
                        <i class="bi bi-calendar3" aria-hidden="true"></i> @Model.Post.CreatedAt.ToString("yyyy/MM/dd")
                    </time>
                    @if (Model.Post.Category != null)
                    {
                        <span><i class="bi bi-folder2-open"></i> @Model.Post.Category.Name</span>
                    }
                </div>
            </div>
        </header>

        <main role="main" class="pd-container">
            <article class="pd-body">
                @Html.Raw(processedContent)
            </article>

            @if (!string.IsNullOrEmpty(Model.Post.AudioFilePath))
            {
                <div class="mt-5 p-4 rounded-4" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                    <h5 class="fw-bold mb-3" style="color: #0a0c12;"><i class="bi bi-mic-fill text-primary"></i> پادکست صوتی مقاله</h5>
                    <audio controls class="w-100 rounded-pill">
                        <source src="@Model.Post.AudioFilePath" type="audio/mpeg" />
                        مرورگر شما از پخش صدا پشتیبانی نمی‌کند.
                    </audio>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Post.AttachmentFilePath))
            {
                string title = string.IsNullOrWhiteSpace(Model.Post.AttachmentTitle) ? "دانلود فایل ضمیمه مقاله" : Model.Post.AttachmentTitle;
                string desc = string.IsNullOrWhiteSpace(Model.Post.AttachmentDescription) ? "برای دریافت اطلاعات بیشتر، فایل مربوطه را دانلود کنید." : Model.Post.AttachmentDescription;

                <div class="pdf-premium-card">
                    <div class="pdf-premium-icon">
                        <i class="bi bi-file-earmark-pdf-fill"></i>
                    </div>
                    <div class="pdf-premium-content">
                        <h4 class="pdf-premium-title">@title</h4>
                        <p class="pdf-premium-desc">@desc</p>
                    </div>
                    <div class="pdf-premium-action">
                        <a href="@Model.Post.AttachmentFilePath" download class="pdf-premium-btn">
                            <i class="bi bi-cloud-arrow-down-fill fs-5"></i> دریافت فایل
                        </a>
                    </div>
                </div>
            }

            <div class="pd-rating-box mt-5 p-4 rounded-4 text-center">
                <h4 class="fw-bold mb-3" style="color: #0a0c12;">به این مقاله چه امتیازی می‌دهید؟</h4>
                <div class="pd-stars" style="direction: ltr;">
                    <i class="bi bi-star-fill pd-star-icon" data-value="5"></i>
                    <i class="bi bi-star-fill pd-star-icon" data-value="4"></i>
                    <i class="bi bi-star-fill pd-star-icon" data-value="3"></i>
                    <i class="bi bi-star-fill pd-star-icon" data-value="2"></i>
                    <i class="bi bi-star-fill pd-star-icon" data-value="1"></i>
                </div>
                <p class="text-muted mt-2 mb-0" id="rating-text">
                    میانگین امتیاز: <strong class="text-dark">@Model.Post.AverageRating</strong> از 5 (<strong class="text-dark">@Model.Post.TotalVotes</strong> رای)
                </p>
            </div>

            @if (Model.Post.Faqs != null && Model.Post.Faqs.Any())
            {
                <section class="pd-faq-wrapper" aria-labelledby="faq-heading">
                    <h3 id="faq-heading" class="pd-faq-title">
                        <i class="bi bi-patch-question-fill" aria-hidden="true"></i>
                        سوالات متداول
                    </h3>

                    <div class="pd-faq-list">
                        @foreach (var faq in Model.Post.Faqs)
                        {
                            <details class="pd-details">
                                <summary class="pd-summary">@faq.Question</summary>
                                <div class="pd-answer">
                                    @Html.Raw(FormatFaqAnswer(faq.Answer))
                                </div>
                            </details>
                        }
                    </div>
                </section>
            }

            <section class="pd-cta" aria-labelledby="cta-heading">
                <div class="pd-cta-text">
                    <h4 id="cta-heading">پروژه خود را با مطمئن‌ترین تیم ایران آغاز کنید</h4>
                    <p>مشاوره رایگان، تامین شیشه‌های استاندارد و اجرای تضمینی. با تیم مهندسین دارابی کو در ارتباط باشید.</p>
                </div>
                <div class="pd-cta-actions">
                    <a href="https://wa.me/989111515971" target="_blank" class="pd-btn-social" aria-label="ارتباط در واتس‌اپ" title="واتس‌اپ">
                        <i class="bi bi-whatsapp" aria-hidden="true"></i>
                    </a>
                    <a href="https://t.me/DarabiHolding" target="_blank" class="pd-btn-social" aria-label="ارتباط در تلگرام" title="تلگرام">
                        <i class="bi bi-telegram" aria-hidden="true"></i>
                    </a>
                    <a href="https://instagram.com/darabicopadel" target="_blank" class="pd-btn-social" aria-label="صفحه اینستاگرام" title="اینستاگرام">
                        <i class="bi bi-instagram" aria-hidden="true"></i>
                    </a>
                    <a asp-controller="Home" asp-action="Contact" class="pd-btn">
                        <i class="bi bi-telephone-fill" aria-hidden="true"></i> ارتباط با مهندسین
                    </a>
                </div>
            </section>
        </main>

        @if (Model.RelatedPosts != null && Model.RelatedPosts.Any())
        {
            <section class="pd-related-section">
                <h3 class="pd-related-title">مطالب پیشنهادی</h3>
                <div class="pd-related-grid">
                    @foreach (var rpost in Model.RelatedPosts)
                    {
                        <a asp-controller="Home" asp-action="Post" asp-route-slug="@rpost.Slug" class="pd-card">
                            <div style="overflow: hidden;">
                                <img src="@(!string.IsNullOrWhiteSpace(rpost.CoverImagePath) ? rpost.CoverImagePath : "/H-IMG/133.webp")" alt="@rpost.Title" class="pd-card-img" loading="lazy" />
                            </div>
                            <div class="pd-card-body">
                                <div class="pd-card-meta">
                                    <time datetime="@rpost.CreatedAt.ToString("yyyy-MM-dd")"><i class="bi bi-clock"></i> @rpost.CreatedAt.ToString("yyyy/MM/dd")</time>
                                </div>
                                <h5 class="pd-card-title">@rpost.Title</h5>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }
    }
    else
    {
        <div style="text-align: center; padding: 100px 20px;">
            <h2>مقاله‌ای یافت نشد.</h2>
            <a href="/" class="pd-btn" style="margin-top: 20px;">بازگشت به صفحه اصلی</a>
        </div>
    }

    @section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                document.body.classList.remove('loading-state');
                const header = document.getElementById("main-header");
                if (header && !header.classList.contains("scrolled")) {
                    header.style.background = "rgba(10, 12, 18, 0.95)";
                    header.style.backdropFilter = "blur(10px)";
                    header.classList.add("scrolled");
                }

                const postId = '@(Model?.Post?.Id ?? 0)';
                const stars = document.querySelectorAll('.pd-star-icon');
                const ratingText = document.getElementById('rating-text');

                if (postId !== '0' && stars.length > 0 && ratingText) {
                    const hasRated = localStorage.getItem('rated_post_' + postId);

                    if (hasRated) {
                        const savedRating = parseInt(localStorage.getItem('rating_val_' + postId) || "5");
                        stars.forEach(function (s) {
                            if (!(parseInt(s.getAttribute('data-value')) > savedRating)) {
                                s.classList.add('active');
                            }
                        });
                        ratingText.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle"></i> شما قبلاً به این مقاله رای داده‌اید!</span>';
                    }

                    stars.forEach(function (star) {
                        star.addEventListener('click', function () {
                            if (localStorage.getItem('rated_post_' + postId)) {
                                return;
                            }

                            var value = parseInt(this.getAttribute('data-value'));

                            stars.forEach(function (s) { s.classList.remove('active'); });
                            stars.forEach(function (s) {
                                if (!(parseInt(s.getAttribute('data-value')) > value)) {
                                    s.classList.add('active');
                                }
                            });

                            ratingText.innerHTML = '<span class="text-warning fw-bold"><i class="bi bi-hourglass-split"></i> در حال ثبت...</span>';

                            fetch('/Home/SubmitRating', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                },
                                body: `postId=${postId}&rating=${value}`
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    localStorage.setItem('rated_post_' + postId, 'true');
                                    localStorage.setItem('rating_val_' + postId, value);
                                    ratingText.innerHTML = `<span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> رای شما با موفقیت ثبت شد. (میانگین جدید: ${data.newAverage} از ${data.newTotal} رای)</span>`;
                                } else {
                                    ratingText.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-x-circle-fill"></i> خطا: ' + data.message + '</span>';
                                }
                            })
                            .catch(error => {
                                ratingText.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-x-circle-fill"></i> خطای ارتباط با سرور.</span>';
                                console.error('Error:', error);
                            });
                        });
                    });
                }
            });
        </script>
    }