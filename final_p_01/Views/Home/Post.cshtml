@model final_p_01.Models.PostDetailsViewModel
@using System.Linq
@using Ganss.Xss
@using System.Text.Json
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = Model.Post.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    string coverImage = !string.IsNullOrWhiteSpace(Model.Post.CoverImagePath) ? Model.Post.CoverImagePath : "/H-IMG/133.webp";
    string coverAlt = !string.IsNullOrWhiteSpace(Model.Post.CoverImageAlt) ? Model.Post.CoverImageAlt : Model.Post.Title;
    string absoluteCoverImage = $"{Context.Request.Scheme}://{Context.Request.Host}{coverImage}";
    string absoluteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";

    string processedContent = Model.Post.Content ?? "";

    // 🚀 1. حذف تمام استایل‌ها و ابعاد مزاحم که ادیتور به صورت مخفیانه روی عکس‌ها و ویدیوها می‌گذارد
    processedContent = Regex.Replace(processedContent, @"(width|height)=[""'][^""']*[""']", "", RegexOptions.IgnoreCase);
    processedContent = Regex.Replace(processedContent, @"style=[""'][^""']*[""']", "", RegexOptions.IgnoreCase);

    // 🚀 2. سیستم هوشمند تشخیص YouTube Shorts (تبدیل خودکار به پلیر عمودی موبایلی)
    processedContent = Regex.Replace(processedContent,
        @"(?:<p>)?(?:<a[^>]*>)?\s*https?://(?:www\.)?youtube\.com/shorts/([a-zA-Z0-9_-]+)\s*(?:</a>)?\s*(?:</p>)?",
        "<div class=\"video-shorts-wrapper\"><iframe src=\"https://www.youtube.com/embed/$1\" allowfullscreen></iframe></div>",
        RegexOptions.IgnoreCase);

    // 🚀 3. سیستم هوشمند تشخیص آپارات شورتز (تبدیل خودکار به پلیر عمودی موبایلی)
    processedContent = Regex.Replace(processedContent,
        @"(?:<p>)?(?:<a[^>]*>)?\s*https?://(?:www\.)?aparat\.com/shorts/([a-zA-Z0-9]+)\s*(?:</a>)?\s*(?:</p>)?",
        "<div class=\"video-shorts-wrapper\"><iframe src=\"https://www.aparat.com/video/video/embed/videohash/$1/vt/frame\" allowfullscreen></iframe></div>",
        RegexOptions.IgnoreCase);

    // 🚀 4. سیستم هوشمند تشخیص YouTube معمولی (تبدیل خودکار به پلیر افقی عریض)
    processedContent = Regex.Replace(processedContent,
        @"(?:<p>)?(?:<a[^>]*>)?\s*https?://(?:www\.)?(?:youtube\.com/watch\?v=|youtu\.be/)([a-zA-Z0-9_-]+)(?:[&?][^\s<]*)?\s*(?:</a>)?\s*(?:</p>)?",
        "<div class=\"video-normal-wrapper\"><iframe src=\"https://www.youtube.com/embed/$1\" allowfullscreen></iframe></div>",
        RegexOptions.IgnoreCase);

    // 🚀 5. سیستم هوشمند تشخیص آپارات معمولی (تبدیل خودکار به پلیر افقی عریض بدون سیاهی)
    processedContent = Regex.Replace(processedContent,
        @"(?:<p>)?(?:<a[^>]*>)?\s*https?://(?:www\.)?aparat\.com/v/([a-zA-Z0-9]+)\s*(?:</a>)?\s*(?:</p>)?",
        "<div class=\"video-normal-wrapper\"><iframe src=\"https://www.aparat.com/video/video/embed/videohash/$1/vt/frame\" allowfullscreen></iframe></div>",
        RegexOptions.IgnoreCase);

    // ایمن‌سازی فقط برای بخش FAQ اعمال می‌شود تا کدهای ادمین خراب نشوند
    var sanitizer = new HtmlSanitizer();
    var safeFaqs = Model.Post.Faqs?.Select(f => new
    {
        Question = f.Question,
        Answer = sanitizer.Sanitize((f.Answer ?? "").Replace("\n", "<br/>"))
    }).ToList();
}

<!-- 🚀 مخفی کردن بنر صفحه اصلی -->
@section Hero { }

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preload" as="image" href="@coverImage" fetchpriority="high">

    <!-- 🚀 SEO: Schema Markup -->
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@graph": [
            {
                "@@type": "Article",
                "headline": @Html.Raw(JsonSerializer.Serialize(Model.Post.Title)),
                "image": "@absoluteCoverImage",
                "datePublished": "@Model.Post.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")",
                "author": { "@@type": "Organization", "name": "دارابی کو", "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")" },
                "publisher": { "@@type": "Organization", "name": "دارابی کو", "logo": { "@@type": "ImageObject", "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}/siteLOGO/sitelogo.png")" } },
                "aggregateRating": {
                "@@type": "AggregateRating",
                "ratingValue": "@Model.Post.AverageRating",
                "bestRating": "5",
                "ratingCount": "@Model.Post.TotalVotes"
                },
                "mainEntityOfPage": { "@@type": "WebPage", "@@id": "@absoluteUrl" }
            }
            @if (safeFaqs != null && safeFaqs.Any())
            {
                        <text>
                        ,{
                            "@@type": "FAQPage",
                            "mainEntity": [
                            @for (int i = 0; i < safeFaqs.Count; i++)
                            {
                                        var faq = safeFaqs[i];
                                        <text>
                                        {
                                        "@@type": "Question",
                                        "name": @Html.Raw(JsonSerializer.Serialize(faq.Question)),
                                        "acceptedAnswer": { "@@type": "Answer", "text": @Html.Raw(JsonSerializer.Serialize(faq.Answer)) }
                                        }
                                        @(i < safeFaqs.Count - 1 ? "," : "")
                                        </text>
                            }
                            ]
                        }
                        </text>
            }
            ]
        }
    </script>

    <style>
        :root {
            --pd-bg: #f8fafc;
            --pd-card: #ffffff;
            --pd-text-main: #0f172a;
            --pd-text-muted: #64748b;
            --pd-primary: #0056b3;
            --pd-accent: #d11e32;
            --pd-navy: #0a0c12;
            --pd-radius-xl: 24px;
            --pd-radius-lg: 16px;
            --pd-radius-md: 12px;
            --pd-shadow: 0 10px 40px rgba(0,0,0,0.04);
            --pd-shadow-hover: 0 20px 40px rgba(0,0,0,0.08);
            --pd-transition: all 0.3s ease;
        }

        body {
            background-color: var(--pd-bg) !important;
        }

        * {
            box-sizing: border-box;
        }

        .pd-hero {
            position: relative;
            width: 100%;
            height: 60vh;
            min-height: 450px;
            background-image: url('@coverImage');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 80px;
        }

            .pd-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to top, rgba(10, 12, 18, 0.95) 0%, rgba(10, 12, 18, 0.5) 50%, rgba(10, 12, 18, 0.2) 100%);
            }

        .pd-hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: #fff;
            max-width: 900px;
            padding: 0 20px;
        }

        .pd-breadcrumb {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 8px 24px;
            border-radius: 50px;
            border: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 25px;
            font-size: 0.85rem;
            color: #cbd5e1;
        }

            .pd-breadcrumb a {
                color: #fff;
                text-decoration: none;
                transition: var(--pd-transition);
            }

                .pd-breadcrumb a:hover {
                    color: var(--pd-accent);
                }

            .pd-breadcrumb .sep {
                margin: 0 10px;
                opacity: 0.5;
            }

        .pd-title {
            font-size: clamp(2rem, 4vw, 3.5rem);
            font-weight: 900;
            line-height: 1.3;
            margin-bottom: 25px;
            margin-top: 0;
            text-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        .pd-meta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 25px;
            font-size: 0.95rem;
            color: #e2e8f0;
            flex-wrap: wrap;
        }

            .pd-meta span, .pd-meta time {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .pd-meta i {
                color: var(--pd-accent);
            }

        .pd-container {
            max-width: 850px;
            margin: -60px auto 80px;
            background: var(--pd-card);
            border-radius: var(--pd-radius-xl);
            padding: 60px 70px;
            box-shadow: var(--pd-shadow);
            position: relative;
            z-index: 10;
        }

        .pd-body {
            font-size: 1.15rem;
            line-height: 2.2;
            color: var(--pd-text-muted);
            text-align: justify;
            overflow-wrap: break-word;
            word-wrap: break-word;
        }

            .pd-body h2, .pd-body h3 {
                color: var(--pd-text-main);
                font-weight: 800;
                margin-top: 2.5rem;
                margin-bottom: 1.2rem;
                line-height: 1.4;
            }

            /* 🚀 استایل دکمه‌های دانلودی که با ادیتور وسط متن قرار داده می‌شوند */
            .pd-body .pdf-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: var(--pd-primary);
                color: #fff !important;
                padding: 12px 28px;
                border-radius: 50px;
                font-weight: bold;
                text-decoration: none;
                box-shadow: 0 8px 20px rgba(0,86,179,0.2);
                transition: 0.3s;
                margin: 15px 0;
            }

                .pd-body .pdf-btn:hover {
                    background: #004494;
                    transform: translateY(-3px);
                    box-shadow: 0 12px 25px rgba(0,86,179,0.4);
                }

            .pd-body img {
                max-width: 100% !important;
                height: auto !important;
                object-fit: contain !important;
                border-radius: var(--pd-radius-md);
                margin: 2rem auto !important;
                display: block !important;
                box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            }

            .pd-body iframe {
                border-radius: 16px !important;
                border: none !important;
                box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
                display: block;
                background: #000;
                max-width: 100%;
            }

        /* ویدیوهای معمولی افقی (آپارات و یوتیوب عادی) */
        .video-normal-wrapper {
            width: 100%;
            margin: 3rem 0;
        }

            .video-normal-wrapper iframe {
                width: 100% !important;
                aspect-ratio: 16 / 9 !important;
                height: auto !important;
            }

        /* ویدیوهای عمودی (YouTube Shorts و آپارات شورتز) */
        .video-shorts-wrapper {
            width: 100%;
            display: flex;
            justify-content: center;
            margin: 3rem 0;
        }

            .video-shorts-wrapper iframe {
                width: 100% !important;
                max-width: 360px !important;
                aspect-ratio: 9 / 16 !important;
                height: auto !important;
            }

        /* 🚀 کارت پریمیوم دانلود PDF (انتهای مقاله) */
        .pdf-premium-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
            padding: 25px;
            display: flex;
            align-items: center;
            gap: 25px;
            margin: 3rem 0;
            box-shadow: 0 15px 35px rgba(0,0,0,0.04);
            transition: all 0.3s ease;
        }

            .pdf-premium-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.08);
                border-color: #cbd5e1;
            }

        .pdf-premium-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: #2563eb;
            flex-shrink: 0;
        }

        .pdf-premium-content {
            flex-grow: 1;
            text-align: right;
        }

        .pdf-premium-title {
            font-size: 1.4rem;
            font-weight: 900;
            color: var(--pd-navy);
            margin: 0 0 8px 0;
        }

        .pdf-premium-desc {
            font-size: 1rem;
            color: var(--pd-text-muted);
            margin: 0;
            line-height: 1.6;
        }

        .pdf-premium-btn {
            background: var(--pd-navy);
            color: #fff !important;
            padding: 14px 30px;
            border-radius: 50px;
            font-weight: 800;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: 0.3s;
            flex-shrink: 0;
            white-space: nowrap;
        }

            .pdf-premium-btn:hover {
                background: #C5A66B;
                color: var(--pd-navy) !important;
                box-shadow: 0 10px 20px rgba(197,166,107,0.3);
            }

        /* 🚀 ستاره‌ها */
        .pd-rating-box {
            border: 1px solid var(--border-color);
            background: #fff;
            box-shadow: 0 5px 15px rgba(0,0,0,0.02);
        }

        .pd-star-icon {
            font-size: 2.5rem;
            color: #e2e8f0;
            cursor: pointer;
            transition: 0.2s;
            padding: 0 5px;
        }

        .pd-stars {
            display: flex;
            flex-direction: row-reverse;
            justify-content: center;
            gap: 5px;
        }

            .pd-stars:hover .pd-star-icon {
                color: #e2e8f0;
            }

        .pd-star-icon:hover, .pd-star-icon:hover ~ .pd-star-icon, .pd-star-icon.active {
            color: #f59e0b !important;
        }

        .pd-faq-wrapper {
            margin-top: 4rem;
            padding-top: 3rem;
            border-top: 2px dashed #f1f5f9;
        }

        .pd-faq-title {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--pd-text-main);
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .pd-faq-title i {
                color: var(--pd-primary);
            }

        .pd-details {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: var(--pd-radius-md);
            margin-bottom: 1rem;
            overflow: hidden;
            transition: var(--pd-transition);
        }

            .pd-details:hover {
                border-color: #cbd5e1;
            }

        .pd-summary {
            padding: 1.25rem 1.5rem;
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--pd-text-main);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff;
            list-style: none;
        }

            .pd-summary::-webkit-details-marker {
                display: none;
            }

            .pd-summary::after {
                content: '\F282';
                font-family: "bootstrap-icons";
                font-size: 1.2rem;
                color: var(--pd-primary);
                transition: transform 0.3s ease;
            }

        .pd-details[open] .pd-summary {
            color: var(--pd-primary);
            background: #f8fafc;
        }

            .pd-details[open] .pd-summary::after {
                transform: rotate(180deg);
            }

        .pd-answer {
            padding: 0 1.5rem 1.5rem;
            color: var(--pd-text-secondary);
            line-height: 1.9;
            background: #f8fafc;
            border-top: 1px solid transparent;
        }

        .pd-cta {
            background: linear-gradient(135deg, var(--pd-navy) 0%, #1e293b 100%);
            border-radius: var(--pd-radius-lg);
            padding: 3rem;
            margin-top: 4rem;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            box-shadow: 0 20px 40px rgba(10, 12, 18, 0.2);
            position: relative;
            overflow: hidden;
            flex-wrap: wrap;
        }

        .pd-cta-text {
            position: relative;
            z-index: 2;
            flex: 1 1 50%;
            min-width: 300px;
        }

            .pd-cta-text h4 {
                color: #fff;
                font-size: 1.8rem;
                font-weight: 900;
                margin-bottom: 0.8rem;
            }

            .pd-cta-text p {
                color: #cbd5e1;
                font-size: 1.05rem;
                margin: 0;
                line-height: 1.8;
            }

        .pd-cta-actions {
            position: relative;
            z-index: 2;
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .pd-btn-social {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            width: 50px;
            height: 50px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 1.3rem;
            text-decoration: none;
            transition: var(--pd-transition);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(5px);
        }

            .pd-btn-social:hover {
                background: var(--pd-primary);
                color: #fff;
                transform: translateY(-3px);
                border-color: var(--pd-primary);
                box-shadow: 0 10px 20px rgba(0, 86, 179, 0.3);
            }

        .pd-btn {
            background: var(--pd-primary);
            color: #fff;
            padding: 14px 28px;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--pd-transition);
            box-shadow: 0 10px 20px rgba(0, 86, 179, 0.3);
            border: none;
            height: 50px;
        }

            .pd-btn:hover {
                background: #004494;
                transform: translateY(-3px);
                box-shadow: 0 15px 25px rgba(0, 86, 179, 0.4);
                color: #fff;
            }

        .pd-related-section {
            max-width: 1200px;
            margin: 0 auto 80px;
            padding: 0 20px;
        }

        .pd-related-title {
            text-align: center;
            font-size: 2.2rem;
            font-weight: 900;
            color: var(--pd-text-main);
            margin-bottom: 2.5rem;
        }

        .pd-related-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
        }

        .pd-card {
            background: var(--pd-card);
            border-radius: var(--pd-radius-lg);
            overflow: hidden;
            box-shadow: var(--pd-shadow);
            transition: var(--pd-transition);
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            border: 1px solid #f1f5f9;
        }

            .pd-card:hover {
                transform: translateY(-10px);
                box-shadow: var(--pd-shadow-hover);
                border-color: #C5A66B;
            }

        .pd-card-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            transition: 0.5s;
        }

        .pd-card:hover .pd-card-img {
            transform: scale(1.05);
        }

        .pd-card-body {
            padding: 25px;
            background: #fff;
            z-index: 2;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .pd-card-meta {
            display: flex;
            gap: 15px;
            font-size: 0.85rem;
            color: var(--pd-text-muted);
            margin-bottom: 12px;
            font-weight: 600;
        }

            .pd-card-meta i {
                color: #C5A66B;
            }

        .pd-card-title {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--pd-text-main);
            line-height: 1.6;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* 🚀 ریسپانسیو کامل و حرفه‌ای برای موبایل (رفع مشکل چسبیدن به لبه‌ها و کادرها) */
        @@media (max-width: 768px) {
            .pd-container {
                margin: -30px 10px 40px !important;
                padding: 30px 15px !important; /* ایجاد فاصله ایمن 15 پیکسلی از دو طرف در موبایل */
                border-radius: 16px !important;
            }

            .pd-title {
                font-size: 1.8rem !important;
                padding: 0 10px;
            }

            .pdf-premium-card {
                flex-direction: column;
                text-align: center;
                padding: 25px 15px;
                gap: 15px;
            }

            .pdf-premium-content {
                text-align: center;
            }

            .pdf-premium-action {
                width: 100%;
            }

            .pdf-premium-btn {
                width: 100%;
                justify-content: center;
            }

            .pd-cta {
                flex-direction: column;
                text-align: center;
                gap: 25px;
                padding: 30px 20px;
            }

            .pd-cta-actions {
                width: 100%;
                justify-content: center;
            }
        }
    </style>

    <div class="pd-hero">
        <div class="pd-hero-content">
            <nav aria-label="breadcrumb" class="pd-breadcrumb">
                <a href="/">خانه</a>
                <span class="sep">/</span>
                <a asp-controller="Home" asp-action="Blog">مجله پدل</a>
                <span class="sep">/</span>
                <span aria-current="page" style="color: #fff;">@Model.Post.Title</span>
            </nav>

            <h1 class="pd-title">@Model.Post.Title</h1>

            <div class="pd-meta">
                <span><i class="bi bi-person-circle"></i> تحریریه دارابی کو</span>
                <time datetime="@Model.Post.CreatedAt.ToString("yyyy-MM-dd")">
                    <i class="bi bi-calendar3"></i> @Model.Post.CreatedAt.ToString("yyyy/MM/dd")
                </time>
                @if (Model.Post.Category != null)
                {
                    <span><i class="bi bi-folder2-open"></i> @Model.Post.Category.Name</span>
                }
            </div>
        </div>
    </div>

    <main class="pd-container">

        <article class="pd-body">
            @Html.Raw(processedContent)
        </article>

        <!-- 🚀 نمایش پادکست -->
        @if (!string.IsNullOrEmpty(Model.Post.AudioFilePath))
        {
            <div class="mt-5 p-4 rounded-4" style="background: #f8fafc; border: 1px solid var(--border-color);">
                <h5 class="fw-bold mb-3" style="color: var(--brand-navy);"><i class="bi bi-mic-fill" style="color: #C5A66B;"></i> پادکست صوتی مقاله</h5>
                <audio controls class="w-100 rounded-pill">
                    <source src="@Model.Post.AudioFilePath" type="audio/mpeg">
                    مرورگر شما از پخش صدا پشتیبانی نمی‌کند.
                </audio>
            </div>
        }

        <!-- 🚀 UI/UX جدید و فوق‌حرفه‌ای برای دانلود فایل PDF (انتهای مقاله) -->
        @if (!string.IsNullOrEmpty(Model.Post.AttachmentFilePath))
        {
            string title = string.IsNullOrWhiteSpace(Model.Post.AttachmentTitle) ? "دانلود فایل ضمیمه مقاله" : Model.Post.AttachmentTitle;
            string desc = string.IsNullOrWhiteSpace(Model.Post.AttachmentDescription) ? "برای دریافت اطلاعات بیشتر، فایل مربوطه را دانلود کنید." : Model.Post.AttachmentDescription;

            <div class="pdf-premium-card">
                <div class="pdf-premium-icon">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                </div>
                <div class="pdf-premium-content">
                    <h4 class="pdf-premium-title">@title</h4>
                    <p class="pdf-premium-desc">@desc</p>
                </div>
                <div class="pdf-premium-action">
                    <a href="@Model.Post.AttachmentFilePath" download class="pdf-premium-btn">
                        <i class="bi bi-cloud-arrow-down-fill fs-5"></i> دریافت فایل
                    </a>
                </div>
            </div>
        }

        <!-- 🚀 رابط کاربری ستاره‌های امتیازدهی -->
        <div class="pd-rating-box mt-5 p-4 rounded-4 text-center">
            <h4 class="fw-bold mb-3" style="color: var(--brand-navy);">به این مقاله چه امتیازی می‌دهید؟</h4>
            <div class="pd-stars" style="direction: ltr;">
                <i class="bi bi-star-fill pd-star-icon" data-value="5"></i>
                <i class="bi bi-star-fill pd-star-icon" data-value="4"></i>
                <i class="bi bi-star-fill pd-star-icon" data-value="3"></i>
                <i class="bi bi-star-fill pd-star-icon" data-value="2"></i>
                <i class="bi bi-star-fill pd-star-icon" data-value="1"></i>
            </div>
            <p class="text-muted mt-2 mb-0" id="rating-text">
                میانگین امتیاز: <strong class="text-dark">@Model.Post.AverageRating</strong> از 5 (<strong class="text-dark">@Model.Post.TotalVotes</strong> رای)
            </p>
        </div>

        @if (safeFaqs != null && safeFaqs.Any())
        {
            <div class="pd-faq-wrapper">
                <h3 class="pd-faq-title">
                    <i class="bi bi-patch-question-fill"></i>
                    سوالات متداول
                </h3>

                <div class="pd-faq-list">
                    @foreach (var faq in safeFaqs)
                    {
                        <details class="pd-details">
                            <summary class="pd-summary">@faq.Question</summary>
                            <div class="pd-answer">
                                @Html.Raw(faq.Answer)
                            </div>
                        </details>
                    }
                </div>
            </div>
        }

        <div class="pd-cta">
            <div class="pd-cta-text">
                <h4>آماده ساخت کورت پدل هستید؟</h4>
                <p>طراحی فراتر از استاندارد. اجرای تخصصی زمین‌های پدل با شیشه‌های ۱۲ میل نشکن. تجربه‌ای امن و بی‌نظیر برای بازیکنان.</p>
            </div>
            <div class="pd-cta-actions">
                <a href="https://wa.me/989111515971" target="_blank" class="pd-btn-social" title="واتس‌اپ"><i class="bi bi-whatsapp"></i></a>
                <a href="https://t.me/DarabiHolding" target="_blank" class="pd-btn-social" title="تلگرام"><i class="bi bi-telegram"></i></a>
                <a href="https://instagram.com/darabicopadel" target="_blank" class="pd-btn-social" title="اینستاگرام"><i class="bi bi-instagram"></i></a>
                <a asp-controller="Home" asp-action="Contact" class="pd-btn"><i class="bi bi-telephone-fill"></i> دریافت مشاوره رایگان</a>
            </div>
        </div>

    </main>

    @if (Model.RelatedPosts != null && Model.RelatedPosts.Any())
    {
        <section class="pd-related-section">
            <h3 class="pd-related-title">مطالب پیشنهادی</h3>
            <div class="pd-related-grid">
                @foreach (var rpost in Model.RelatedPosts)
                {
                    <a asp-controller="Home" asp-action="Post" asp-route-slug="@rpost.Slug" class="pd-card">
                        <div style="overflow: hidden;">
                            <img src="@(!string.IsNullOrWhiteSpace(rpost.CoverImagePath) ? rpost.CoverImagePath : "/H-IMG/133.webp")" alt="@rpost.Title" class="pd-card-img" loading="lazy" />
                        </div>
                        <div class="pd-card-body">
                            <div class="pd-card-meta">
                                <time datetime="@rpost.CreatedAt.ToString("yyyy-MM-dd")"><i class="bi bi-clock"></i> @rpost.CreatedAt.ToString("yyyy/MM/dd")</time>
                            </div>
                            <h5 class="pd-card-title">@rpost.Title</h5>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    @section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                document.body.classList.remove('loading-state');
                const header = document.getElementById("main-header");
                if (header && !header.classList.contains("scrolled")) {
                    header.style.background = "rgba(10, 12, 18, 0.95)";
                    header.style.backdropFilter = "blur(10px)";
                    header.classList.add("scrolled");
                }

                // لاجیک ستاره‌ها
                const postId = '@Model.Post.Id';
                const stars = document.querySelectorAll('.pd-star-icon');
                const ratingText = document.getElementById('rating-text');

                const hasRated = localStorage.getItem('rated_post_' + postId);
                if (hasRated) {
                    const savedRating = parseInt(localStorage.getItem('rating_val_' + postId) || "5");
                    stars.forEach(s => {
                        if (parseInt(s.getAttribute('data-value')) <= savedRating) {
                            s.classList.add('active');
                        }
                    });
                    ratingText.innerHTML = '<span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle"></i> شما قبلاً به این مقاله رای داده‌اید!</span>';
                }

                stars.forEach(star => {
                    star.addEventListener('click', function () {
                        if (localStorage.getItem('rated_post_' + postId)) {
                            return;
                        }

                        let value = parseInt(this.getAttribute('data-value'));

                        stars.forEach(s => s.classList.remove('active'));
                        stars.forEach(s => {
                            if (parseInt(s.getAttribute('data-value')) <= value) {
                                s.classList.add('active');
                            }
                        });

                        localStorage.setItem('rated_post_' + postId, 'true');
                        localStorage.setItem('rating_val_' + postId, value);

                        ratingText.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-check-circle-fill"></i> رای شما با موفقیت ثبت شد. با تشکر!</span>';
                    });
                });
            });
        </script>
    }