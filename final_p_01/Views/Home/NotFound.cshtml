@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa-IR" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>صفحه پیدا نشد | ۴۰۴ - دارابی کو</title>
    <meta name="robots" content="noindex, follow">

    <style>
        /* فراخوانی فونت‌ها */
        @@font-face {
            font-family: 'Dana';
            src: url('/fonts/Dana-Medium.woff2?v=1000') format('woff2');
            font-weight: normal;
            font-display: swap;
        }

        @@font-face {
            font-family: 'Dana';
            src: url('/fonts/Dana-DemiBold.woff2?v=1000') format('woff2');
            font-weight: 600;
            font-display: swap;
        }

        :root {
            --pd-primary: #0056b3;
            --pd-navy: #0a0c12;
            --pd-text-main: #0f172a;
            --pd-text-muted: #64748b;
            --pd-bg-light: #f8fafc;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Dana', system-ui, sans-serif;
            background-color: var(--pd-bg-light);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            color: var(--pd-text-main);
            /* پترن نقطه‌ای پریمیوم */
            background-image: radial-gradient(#cbd5e1 1.5px, transparent 1.5px);
            background-size: 35px 35px;
            background-position: center;
        }

        /* هاله‌ی رنگی پشت کارت */
        .glow-bg {
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(0, 86, 179, 0.15) 0%, transparent 70%);
            z-index: 0;
            animation: pulse 6s infinite alternate;
        }

        .not-found-container {
            position: relative;
            z-index: 1;
            text-align: center;
            padding: 50px 40px;
            max-width: 650px;
            width: 90%;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 32px;
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 25px 50px rgba(10, 12, 18, 0.05), inset 0 0 0 1px rgba(255,255,255,0.5);
        }

        .visual-wrapper {
            position: relative;
            margin-bottom: 20px;
        }

        .error-code {
            font-size: clamp(100px, 15vw, 150px);
            font-weight: 900;
            color: #f1f5f9;
            line-height: 0.8;
            user-select: none;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.02);
            letter-spacing: -5px;
        }

        .error-image {
            font-size: clamp(60px, 8vw, 80px);
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 2;
            filter: drop-shadow(0 15px 25px rgba(0,0,0,0.15));
        }

        .error-title {
            font-size: clamp(22px, 4vw, 28px);
            font-weight: 600;
            color: var(--pd-navy);
            margin-bottom: 15px;
            letter-spacing: -0.5px;
        }

        .error-desc {
            font-size: 1.05rem;
            color: var(--pd-text-muted);
            margin-bottom: 40px;
            line-height: 1.8;
        }

            .error-desc strong {
                color: var(--pd-primary);
                font-weight: 600;
            }

        .actions-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* دکمه اصلی */
        .btn-primary {
            background-color: var(--pd-navy);
            color: #fff;
            padding: 16px 32px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: 2px solid var(--pd-navy);
        }

            .btn-primary:hover {
                background-color: var(--pd-primary);
                border-color: var(--pd-primary);
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0, 86, 179, 0.3);
            }

        /* دکمه ثانویه (تکنیک بازگشت به قیف فروش) */
        .btn-secondary {
            background-color: transparent;
            color: var(--pd-navy);
            padding: 16px 32px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            border: 2px solid #e2e8f0;
        }

            .btn-secondary:hover {
                border-color: var(--pd-navy);
                background-color: #f8fafc;
                transform: translateY(-3px);
            }

        /* انیمیشن‌ها */
        .bounce {
            animation: padelBounce 2s cubic-bezier(0.28, 0.84, 0.42, 1) infinite;
        }

        @@keyframes padelBounce {
            0%, 100% {
                transform: translate(-50%, 20px) rotate(0deg) scale(1, 0.9);
            }

            50% {
                transform: translate(-50%, -40px) rotate(15deg) scale(1, 1);
            }

            80% {
                transform: translate(-50%, 10px) rotate(-5deg) scale(1, 0.95);
            }
        }

        @@keyframes pulse {
            0% {
                transform: scale(0.95);
                opacity: 0.7;
            }

            100% {
                transform: scale(1.1);
                opacity: 1;
            }
        }

        /* ریسپانسیو دکمه‌ها */
        @@media (max-width: 500px) {
            .actions-group {
                flex-direction: column;
            }

            .btn-primary, .btn-secondary {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <div class="glow-bg"></div>

    <div class="not-found-container">
        <div class="visual-wrapper">
            <div class="error-code">404</div>
            <div class="error-image bounce">🎾</div>
        </div>

        <h1 class="error-title">اوپس! توپ به اوت رفته است</h1>

        <p class="error-desc">
            متاسفانه صفحه‌ای که به دنبال آن هستید در سایت <strong>دارابی کو</strong> پیدا نشد.<br>
            ممکن است آدرس جابه‌جا شده باشد یا لینک اشتباه باشد.
        </p>

        <div class="actions-group">
            <a href="/" class="btn-primary">
                بازگشت به زمین اصلی
                <span style="font-size: 1.2em; line-height: 1;">➜</span>
            </a>
            <!-- لینک ثانویه اصلاح شد -->
            <a asp-controller="Home" asp-action="Post" asp-route-slug="padel-court-construction-guide" class="btn-secondary">
                مطالعه راهنمای ساخت پدل
            </a>
        </div>
    </div>

</body>
</html>