@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa-IR" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>صفحه پیدا نشد | ۴۰۴</title>
    <meta name="robots" content="noindex, follow">

    <style>
        /* اصلاح مهم: استفاده از @@ برای جلوگیری از خطای ریزور */
        @@font-face {
            font-family: 'Dana';
            src: url('/fonts/Dana-Medium.woff2?v=1000') format('woff2');
            font-weight: normal;
        }

        :root {
            --brand-navy: #121D35;
            --brand-gold: #C5A66B;
            --text-grey: #666;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Dana', system-ui, sans-serif;
            background-color: #f4f4f4;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            color: var(--brand-navy);
            background-image: radial-gradient(var(--brand-gold) 0.5px, transparent 0.5px);
            background-size: 30px 30px;
        }

        .not-found-container {
            text-align: center;
            padding: 40px;
            max-width: 600px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 20px 40px rgba(18, 29, 53, 0.1);
        }

        .error-code {
            font-size: 120px;
            font-weight: 900;
            color: #e0e0e0;
            line-height: 0.8;
            margin-bottom: -40px;
            user-select: none;
            opacity: 0.5;
        }

        .error-image {
            font-size: 80px;
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
            display: inline-block;
            filter: drop-shadow(0 10px 15px rgba(0,0,0,0.2));
        }

        .error-title {
            font-size: 26px;
            font-weight: 900;
            color: var(--brand-navy);
            margin-bottom: 15px;
        }

        .error-desc {
            font-size: 16px;
            color: var(--text-grey);
            margin-bottom: 40px;
            line-height: 1.8;
        }

        .back-home-btn {
            background-color: var(--brand-navy);
            color: #fff;
            padding: 15px 35px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(18, 29, 53, 0.2);
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .back-home-btn:hover {
                background-color: var(--brand-gold);
                color: var(--brand-navy);
                transform: translateY(-3px);
                box-shadow: 0 15px 30px rgba(197, 166, 107, 0.4);
            }

        .bounce {
            animation: bounce 2s infinite;
        }

        /* در اینجا هم @@ استفاده شده که درست است */
        @@keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-30px) rotate(10deg);
            }

            60% {
                transform: translateY(-15px) rotate(-5deg);
            }
        }
    </style>
</head>
<body>

    <div class="not-found-container">
        <div class="error-code">404</div>
        <div class="error-image bounce">🎾</div>

        <h1 class="error-title">اوپس! توپ به اوت رفته است</h1>

        <p class="error-desc">
            متاسفانه صفحه‌ای که به دنبال آن هستید پیدا نشد.<br>
            شاید لینک شکسته باشد یا صفحه حذف شده باشد.
        </p>

        <a href="/" class="back-home-btn">
            <span>بازگشت به زمین اصلی</span>
            <span style="font-size: 1.2em;">➜</span>
        </a>
    </div>

</body>
</html>