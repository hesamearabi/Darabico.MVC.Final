<body class="loading-state">

    <div id="brand-loader" aria-hidden="true">
        <div class="loader-content">
            <img src="@Url.Content("~/images/siteLOGO/sitelogo.png")" alt="" class="loader-logo" width="110" height="40" fetchpriority="high" decoding="async">
            <div class="loading-bar-container">
                <div class="loading-bar"></div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const MIN_VISIBLE_MS = 280;
            const startTime = performance.now();
            const loader = document.getElementById("brand-loader");
            const body = document.body;
            let finished = false;

            const hideLoader = () => {
                if (finished) return;
                finished = true;

                body.classList.remove("loading-state");

                if (!loader) return;

                if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    loader.remove();
                    return;
                }

                loader.classList.add("loader-hidden");
                loader.addEventListener("transitionend", () => loader.remove(), { once: true });
                setTimeout(() => loader.remove(), 350);
            };

            const scheduleHide = () => {
                const elapsed = performance.now() - startTime;
                const remaining = Math.max(0, MIN_VISIBLE_MS - elapsed);
                setTimeout(hideLoader, remaining);
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", scheduleHide, { once: true });
            } else {
                scheduleHide();
            }

            window.addEventListener("pageshow", (event) => {
                if (event.persisted) {
                    hideLoader();
                }
            });
        })();
    </script>

