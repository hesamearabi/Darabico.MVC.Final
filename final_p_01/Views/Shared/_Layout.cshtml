        <div class="loader-content">
            <img src="@Url.Content("~/siteLOGO/sitelogo.png")" alt="DarabiCo Loader" class="loader-logo" width="110" height="40" fetchpriority="high" decoding="async">
            <div class="loading-bar-container">
                <div class="loading-bar"></div>
            </div>
        </div>
    </div>

    @{
        string path = Context.Request.Path.Value?.ToLower() ?? "";
        bool isHomePage = path == "/" || path == "/home" || path == "/home/index";
    }

