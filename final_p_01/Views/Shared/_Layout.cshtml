@inject final_p_01.Services.ISiteUrlBuilder UrlBuilder
@using final_p_01.ViewModels
@using final_p_01.Application.Services
@inject final_p_01.Services.ISiteSettingsProvider SiteSettings
@{
    var siteSettings = SiteSettings.Get();
    string? pageSeoKey = ViewData["SeoPageKey"] as string ?? (Context.Request.Path.Value?.Trim('/').ToLowerInvariant() switch
    {
        "" => "home",
        "blog" => "blog",
        "projects" => "projects",
        "about-us" => "about",
        "contact-us" => "contact",
        "estimator" => "estimator",
        "inquiry" => "inquiry",
        _ => null
    });
    var (pageSeoTitle, pageSeoDescription) = pageSeoKey != null ? siteSettings.ForPage(pageSeoKey) : (null, null);
}
<!DOCTYPE html>
<html lang="fa-IR" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @{
        string? customMetaDescription = ViewData["MetaDescription"] as string;
        customMetaDescription = !string.IsNullOrWhiteSpace(pageSeoDescription) ? pageSeoDescription : customMetaDescription;
        string metaDescription = !string.IsNullOrWhiteSpace(customMetaDescription)
        ? customMetaDescription
        : "دارابی‌کو، برند تخصصی هلدینگ دارابی و پیمانکار مستقیم طراحی، زیرسازی و ساخت زمین پدل در ایران. تولید شیشه، چمن مصنوعی و تجهیزات با استانداردهای جهانی FIP.";

        string robots = ViewData["Robots"] as string
        ?? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
        bool isNoIndex = robots.Contains("noindex", StringComparison.OrdinalIgnoreCase);

        string rawTitle = ViewData["Title"] as string ?? "ساخت زمین پدل و تجهیزات استاندارد FIP";
        if (!string.IsNullOrWhiteSpace(pageSeoTitle)) rawTitle = pageSeoTitle;
        bool hasBrandInTitle = rawTitle.Contains("دارابی کو") || rawTitle.Contains("دارابی‌کو") || rawTitle.Contains("دارابیکو");
        string pageTitle = (hasBrandInTitle || rawTitle.Length > 55)
        ? rawTitle
        : $"{rawTitle} | دارابی کو";

        string canonicalRaw = Context.Request.Path.Value ?? "";
        string canonicalPath = string.IsNullOrEmpty(canonicalRaw) || canonicalRaw == "/"
        ? "/"
        : canonicalRaw.ToLowerInvariant().TrimEnd('/');
        string defaultCanonicalUrl = UrlBuilder.Absolute(canonicalPath);

        string canonicalUrl = ViewData["Canonical"] is string customCanonical
        ? UrlBuilder.Absolute(customCanonical)
        : defaultCanonicalUrl;
        string ogType = ViewData["OgType"] as string ?? "website";
        string ogTitle = ViewData["OgTitle"] as string ?? pageTitle;

        string? customOgDescription = ViewData["OgDescription"] as string;
        string ogDescription = !string.IsNullOrWhiteSpace(customOgDescription)
        ? customOgDescription
        : metaDescription;

        string? customOgImage = ViewData["OgImage"] as string;
        bool hasCustomOgImage = !string.IsNullOrWhiteSpace(customOgImage);
        string ogImage = hasCustomOgImage
        ? UrlBuilder.Absolute(customOgImage!)
        : UrlBuilder.Absolute("images/siteLOGO/sitelogo.png");

        string? ogImageWidth = ViewData["OgImageWidth"] as string ?? (hasCustomOgImage ? null : "500");
        string? ogImageHeight = ViewData["OgImageHeight"] as string ?? (hasCustomOgImage ? null : "500");
        string ogImageAlt = ViewData["OgImageAlt"] as string ?? ogTitle;

        string twitterCard = ViewData["TwitterCard"] as string
        ?? (hasCustomOgImage ? "summary_large_image" : "summary");
        string twitterDescription = ogDescription;

        string? articlePublishedTime = ViewData["ArticlePublishedTime"] as string;
        string? articleModifiedTime = ViewData["ArticleModifiedTime"] as string;
    }

    <meta name="description" content="@metaDescription">
    <meta name="robots" content="@robots">
    @if (!isNoIndex)
    {
        <link rel="canonical" href="@canonicalUrl" />
    }

    <meta property="og:locale" content="fa_IR">
    <meta property="og:site_name" content="دارابی کو | مجری ساخت زمین پدل">
    <meta property="og:title" content="@ogTitle">
    <meta property="og:type" content="@ogType">
    <meta property="og:description" content="@ogDescription">
    <meta property="og:image" content="@ogImage">
    @if (!string.IsNullOrWhiteSpace(ogImageWidth))
    {
        <meta property="og:image:width" content="@ogImageWidth">
    }
    @if (!string.IsNullOrWhiteSpace(ogImageHeight))
    {
        <meta property="og:image:height" content="@ogImageHeight">
    }
    <meta property="og:image:alt" content="@ogImageAlt">
    <meta property="og:url" content="@canonicalUrl">

    @if (!string.IsNullOrWhiteSpace(articlePublishedTime))
    {
        <meta property="article:published_time" content="@articlePublishedTime">
    }
    @if (!string.IsNullOrWhiteSpace(articleModifiedTime))
    {
        <meta property="article:modified_time" content="@articleModifiedTime">
    }

    <meta name="twitter:card" content="@twitterCard">
    <meta name="twitter:title" content="@ogTitle">
    <meta name="twitter:description" content="@twitterDescription">
    <meta name="twitter:image" content="@ogImage">
    <meta name="twitter:image:alt" content="@ogImageAlt">

    <title>@pageTitle</title>

