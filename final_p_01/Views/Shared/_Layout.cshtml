            <div class="logo">
                <a href="/">
                    <span class="logo-text">دارابی <span>کو</span></span>
                </a>
            </div>

            <nav class="desktop-nav">
                <ul>
                    <li><a href="/#about1" class="nav-link">درباره ما</a></li>
                    <li><a href="/#services-section" class="nav-link">خدمات</a></li>
                    <li><a href="/#projects-section" class="nav-link">پروژه‌ها</a></li>
                    <li><a asp-controller="Home" asp-action="Blog" class="nav-link">مقالات</a></li>
                    <li><a asp-controller="Home" asp-action="PadelGuide" class="nav-link">راهنمای جامع 0 تا 100 ساخت زمین پدل</a></li>
                </ul>
            </nav>

            <div class="header-actions">
                <a asp-controller="Home" asp-action="Contact" class="header-cta-btn">مشاوره رایگان</a>
                <button class="hamburger" id="hamburger-btn" aria-label="منو">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="mobile-menu" id="mobile-menu">
            <div class="mobile-menu-header">
                <span class="mobile-logo-text">فهرست خدمات</span>
                <button class="close-menu" id="close-menu-btn">&times;</button>
            </div>
            <nav>
                <ul>
                    <li><a asp-controller="Home" asp-action="About" class="mobile-link">درباره ما</a></li>
                    <li><a href="/#services-section" class="mobile-link">خدمات ما</a></li>
                    <li><a href="/#projects-section" class="mobile-link">نمونه کارها</a></li>
                    <li><a asp-controller="Home" asp-action="Blog" class="mobile-link">وبلاگ آموزشی</a></li>
                    <li><a asp-controller="Home" asp-action="PadelGuide" class="mobile-link">راهنمای جامع 0 تا 100 ساخت زمین پدل</a></li>
