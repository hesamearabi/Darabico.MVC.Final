@{
    // 🚀 افزودن هدرهای امنیتی در سطح Layout برای محافظت از بازدیدکنندگان
    Context.Response.Headers.Append("X-Content-Type-Options", "nosniff");
    Context.Response.Headers.Append("X-Frame-Options", "SAMEORIGIN");
    Context.Response.Headers.Append("Referrer-Policy", "strict-origin-when-cross-origin");
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="دارابی کو، مجری تخصصی ساخت زمین پدل و تولیدکننده شیشه‌های استاندارد پدل با ۵۰ سال تجربه. مشاوره رایگان هزینه ساخت در سراسر ایران.">
    <meta name="keywords" content="ساخت زمین پدل, هزینه ساخت زمین پدل, شیشه زمین پدل, ابعاد زمین پدل, دارابی کو">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <meta property="og:site_name" content="دارابی کو">
    <meta property="og:title" content="دارابی کو | @(ViewData["Title"] ?? "مرجع تخصصی ساخت و تجهیز زمین های پدل")">
    <meta property="og:type" content="website">
    <meta property="og:description" content="صفر تا صد ساخت زمین پدل با شیشه‌های نشکن استاندارد جهانی.">

    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/siteLOGO/sitelogo.png")">
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")">

    <title>دارابی کو | @(ViewData["Title"] ?? "مرجع تخصصی ساخت و تجهیز زمین های پدل")</title>

    <link rel="icon" type="image/png" href="/siteLOGO/favicon.png" asp-append-version="true">
    <link rel="apple-touch-icon" href="/siteLOGO/favicon.png">

    <link rel="stylesheet" href="/CSS-SOURCE/layouts.css" asp-append-version="true">

    <style>
        /* تعریف انیمیشن‌ها (استفاده از @@ برای جلوگیری از خطای Razor) */
        @@keyframes pulse-logo {
            0% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @@keyframes loading-progress {
            0% {
                transform: translateX(-100%);
            }

            50% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(100%);
            }
        }

        /* استایل بدنه لودر */
        #brand-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #ffffff;
            z-index: 9999999;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: opacity 0.6s ease-out, visibility 0.6s ease-out;
        }

        .loader-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 25px;
        }

        .loader-logo {
            width: 110px;
            height: auto;
            animation: pulse-logo 2s infinite ease-in-out;
        }

        .loading-bar-container {
            width: 160px;
            height: 4px;
            background-color: #f0f0f0;
            border-radius: 100px;
            overflow: hidden;
            position: relative;
        }

        .loading-bar {
            width: 100%;
            height: 100%;
            background-color: #0056b3;
            transform-origin: left;
            animation: loading-progress 1.5s infinite ease-in-out;
        }

        .loader-hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        body.loading-state {
            overflow: hidden !important;
        }

        /* استایل دکمه‌های بخش Hero */
        .hero-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 25px;
            z-index: 10;
            position: relative;
        }

        .hero-guide-btn {
            display: inline-block;
            padding: 12px 30px;
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            border: 2px solid #ffffff;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
        }

            .hero-guide-btn:hover {
                background-color: #ffffff;
                color: #0056b3;
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.15);
            }

        .sub-footer {
            background: #0a0c12;
            border-top: 1px solid rgba(255,255,255,0.05);
            padding: 1rem;
            text-align: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-size: 0.85rem;
            color: #94a3b8;
        }

            .sub-footer a.dev-linkedin-link {
                color: #e2e8f0;
                text-decoration: none;
                font-weight: 700;
                margin-right: 4px;
                transition: all 0.3s ease;
            }

                .sub-footer a.dev-linkedin-link:hover {
                    color: #0a66c2;
                    text-decoration: none;
                    text-shadow: 0 0 8px rgba(10, 102, 194, 0.4);
                }
    </style>

    <script type="application/ld+json">
