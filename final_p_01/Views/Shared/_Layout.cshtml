<!DOCTYPE html>
<html lang="fa-IR" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="@(ViewData["MetaDescription"] ?? "دارابی‌کو، برند تخصصی هلدینگ دارابی و پیمانکار مستقیم طراحی، زیرسازی و ساخت زمین پدل در ایران. تولید شیشه، چمن مصنوعی و تجهیزات با استانداردهای جهانی FIP.")">
    <meta name="keywords" content="ساخت زمین پدل, احداث زمین پدل, پیمانکار زمین پدل, قیمت شیشه زمین پدل, هزینه ساخت زمین پدل, چمن مصنوعی پدل, دارابی کو, استاندارد FIP">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

    <link rel="canonical" href="@($"https://{Context.Request.Host}{Context.Request.Path}")" />

    <meta property="og:site_name" content="دارابی کو | مجری ساخت زمین پدل">
    <meta property="og:title" content="دارابی کو | @(ViewData["Title"] ?? "مرجع تخصصی ساخت و تجهیز زمین پدل")">
    <meta property="og:type" content="website">
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "صفر تا صد ساخت زمین پدل با شیشه‌های نشکن، چمن مصنوعی و سازه استاندارد جهانی بدون واسطه.")">
    <meta property="og:image" content="@(ViewData["OgImage"] ?? $"https://{Context.Request.Host}/siteLOGO/sitelogo.png")">
    <meta property="og:url" content="@($"https://{Context.Request.Host}{Context.Request.Path}")">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="دارابی کو | @(ViewData["Title"] ?? "مرجع تخصصی ساخت زمین پدل")">
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "دارابی کو، پیمانکار تخصصی احداث زمین پدل و تولیدکننده شیشه‌های استاندارد پدل در ایران.")">
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? $"https://{Context.Request.Host}/siteLOGO/sitelogo.png")">

    <title>دارابی کو | @(ViewData["Title"] ?? "مرجع تخصصی ساخت و تجهیز زمین های پدل")</title>

    <link rel="icon" type="image/x-icon" href="@($"https://{Context.Request.Host}/favicon.ico")" sizes="48x48">
    <link rel="icon" type="image/png" sizes="192x192" href="@($"https://{Context.Request.Host}/siteLOGO/favicon.png")">
    <link rel="apple-touch-icon" sizes="180x180" href="@($"https://{Context.Request.Host}/apple-touch-icon.png")">

    <link rel="stylesheet" href="@Url.Content("~/CSS-SOURCE/layouts.css")" asp-append-version="true">

    <style>
        @@keyframes pulse-logo {
            0% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @@keyframes loading-progress {
            0% {
                transform: translateX(-100%);
            }

            50% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(100%);
            }
        }

        #brand-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #ffffff;
            z-index: 9999999;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: opacity 0.6s ease-out, visibility 0.6s ease-out;
        }

        .loader-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 25px;
        }

        .loader-logo {
            width: 110px;
            height: auto;
            animation: pulse-logo 2s infinite ease-in-out;
        }

        .loading-bar-container {
            width: 160px;
            height: 4px;
            background-color: #f0f0f0;
            border-radius: 100px;
            overflow: hidden;
            position: relative;
        }

        .loading-bar {
            width: 100%;
            height: 100%;
            background-color: #0056b3;
            transform-origin: left;
            animation: loading-progress 1.5s infinite ease-in-out;
        }

        .loader-hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        body.loading-state {
            overflow: hidden !important;
        }

        .inner-page-header {
            background-color: #0a0c12 !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .hero-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 25px;
            z-index: 10;
            position: relative;
        }

        .hero-guide-btn {
            display: inline-block;
            padding: 12px 30px;
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            border: 2px solid #ffffff;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            transition: background-color 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
        }

            .hero-guide-btn:hover {
                background-color: #ffffff;
                color: #0056b3;
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.15);
            }

        .sub-footer {
            background: #0a0c12;
            border-top: 1px solid rgba(255,255,255,0.05);
            padding: 1rem;
            text-align: center;
            font-size: 0.85rem;
            color: #94a3b8;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

            .sub-footer a.dev-linkedin-link {
                color: #e2e8f0;
                text-decoration: none;
                font-weight: 700;
                margin-right: 4px;
                transition: color 0.3s ease, text-shadow 0.3s ease;
            }

                .sub-footer a.dev-linkedin-link:hover {
                    color: #0a66c2;
                    text-decoration: none;
                    text-shadow: 0 0 8px rgba(10, 102, 194, 0.4);
                }

        @@media (prefers-reduced-motion: reduce) {
            .loader-logo, .loading-bar {
                animation: none;
            }
        }

        .hero-bg-img {
            transform: translateZ(0);
            -webkit-transform: translateZ(0);
            backface-visibility: hidden;
        }

        .hero-overlay {
            pointer-events: none;
        }
    </style>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "GeneralContractor",
          "name": "دارابی کو - Darabico",
          "url": "@($"https://{Context.Request.Host}")",
          "logo": "@($"https://{Context.Request.Host}/siteLOGO/sitelogo.png")",
          "description": "پیمانکار تخصصی طراحی، زیرسازی، ساخت سازه و تجهیز زمین های پدل در ایران با تولید مستقیم شیشه.",
          "priceRange": "$$",
          "address": {
            "@@type": "PostalAddress",
            "addressCountry": "IR",
            "addressLocality": "Sari",
            "streetAddress": "بلوار خزر، خیابان دریا ۴"
          },
          "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "+989111515971",
            "contactType": "sales",
            "areaServed": "IR",
            "availableLanguage": "Persian"
          },
          "sameAs": [
            "https://instagram.com/darabicopadel",
            "https://t.me/DarabiHolding"
          ]
        }
    </script>

    @await RenderSectionAsync("Head", required: false)
</head>

<body class="loading-state">

