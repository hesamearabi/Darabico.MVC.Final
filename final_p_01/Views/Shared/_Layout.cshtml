                        <img src="@Url.Content("~/footerimg/phone.png")" alt="شماره تماس مجری زمین پدل" width="20" height="20" loading="lazy" decoding="async">
                        <a href="tel:09121729882" dir="ltr">09121729882</a>
                    </div>
                    <div class="social-links">
                        <a href="https://instagram.com/darabicopadel" title="اینستاگرام دارابی کو" rel="noopener noreferrer" target="_blank">
                            <img src="@Url.Content("~/footerimg/logo-instagram.svg")" alt="Instagram" width="22" height="22" loading="lazy" decoding="async">
                        </a>
                        <a href="https://t.me/DarabiHolding" title="تلگرام دارابی کو" rel="noopener noreferrer" target="_blank">
                            <img src="@Url.Content("~/footerimg/4701496.png")" alt="Telegram" width="22" height="22" loading="lazy" decoding="async">
                        </a>
