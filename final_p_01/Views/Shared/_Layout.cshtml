    <meta name="twitter:title" content="@(ViewData["Title"] != null ? $"دارابی کو | {ViewData["Title"]}" : "دارابی کو | مرجع تخصصی ساخت زمین پدل")">
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "دارابی کو، پیمانکار تخصصی احداث زمین پدل و تولیدکننده شیشه‌های استاندارد پدل در ایران.")">
    <meta name="twitter:image" content="@($"https://{Context.Request.Host}/siteLOGO/sitelogo.png")">

    <title>@(ViewData["Title"] != null ? $"دارابی کو | {ViewData["Title"]}" : "دارابی کو | مرجع تخصصی ساخت و تجهیز زمین های پدل")</title>

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/siteLOGO/favicon.png">

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">

    <!-- Apple -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <!-- Web App -->
    <link rel="manifest" href="/site.webmanifest">

    <!-- 🚀 Stylesheets -->
    <link rel="stylesheet" href="/CSS-SOURCE/layouts.css" asp-append-version="true">

    <style>
        /* انیمیشن‌ها (استفاده از @@ برای جلوگیری از خطای Razor) */
        @@keyframes pulse-logo {
            0% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.05);
                opacity: 0.8;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @@keyframes loading-progress {
            0% {
                transform: translateX(-100%);
            }

            50% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(100%);
            }
        }

        /* استایل بدنه لودر */
        #brand-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #ffffff;
            z-index: 9999999;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: opacity 0.6s ease-out, visibility 0.6s ease-out;
        }

        .loader-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 25px;
        }

        .loader-logo {
            width: 110px;
            height: auto;
            animation: pulse-logo 2s infinite ease-in-out;
        }

        .loading-bar-container {
            width: 160px;
            height: 4px;
            background-color: #f0f0f0;
            border-radius: 100px;
            overflow: hidden;
            position: relative;
        }

        .loading-bar {
            width: 100%;
            height: 100%;
            background-color: #0056b3;
            transform-origin: left;
            animation: loading-progress 1.5s infinite ease-in-out;
        }

        .loader-hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        body.loading-state {
            overflow: hidden !important;
        }

        /* دکمه‌های بخش Hero */
        .hero-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 25px;
            z-index: 10;
            position: relative;
        }

        .hero-guide-btn {
            display: inline-block;
            padding: 12px 30px;
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            border: 2px solid #ffffff;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
        }

            .hero-guide-btn:hover {
                background-color: #ffffff;
                color: #0056b3;
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.15);
            }

        /* فوتر کپی رایت */
        .sub-footer {
            background: #0a0c12;
            border-top: 1px solid rgba(255,255,255,0.05);
            padding: 1rem;
            text-align: center;
            font-size: 0.85rem;
            color: #94a3b8;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

            .sub-footer a.dev-linkedin-link {
                color: #e2e8f0;
                text-decoration: none;
                font-weight: 700;
                margin-right: 4px;
                transition: all 0.3s ease;
            }

                .sub-footer a.dev-linkedin-link:hover {
                    color: #0a66c2;
                    text-decoration: none;
                    text-shadow: 0 0 8px rgba(10, 102, 194, 0.4);
                }
    </style>

    <!-- 🚀 JSON-LD Schema (ارتقا یافته برای سئو لوکال و خدمات پیمانکاری) -->
