        // اگر صفحه اصلی بود و ناخواسته تگ Hero را درونش تعریف کرده بودی، آن را ایگنور میکند تا سرور کرش نکند.
        if (IsSectionDefined("Hero"))
        {
            IgnoreSection("Hero");
        }

        <section class="hero">
            <img src="@Url.Content("~/H-IMG/man-playing-padel-9KR4F3U-e1750063137155-compressed.webp")" alt="اجرای زمین پدل استاندارد" class="hero-bg-img" fetchpriority="high" decoding="async" width="1920" height="1080">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1 class="hero-title">
                    <span class="d-block">طراحی و احداث</span>
                    <span class="highlight">زمین پدل</span>
                    <span class="d-block">با استاندارد جهانی FIP</span>
                </h1>
                <p class="hero-subtitle">مجری بی‌واسطه و تولیدکننده شیشه سکوریت، چمن مصنوعی و تجهیزات کامل کورت پدل.</p>

                <div class="hero-actions">
                    <a asp-controller="Home" asp-action="Contact" class="hero-consult-btn">دریافت مشاوره و قیمت</a>
                    <a asp-controller="Home" asp-action="PadelGuide" class="hero-guide-btn">
                        راهنمای جامع 0 تا 100 ساخت زمین پدل
