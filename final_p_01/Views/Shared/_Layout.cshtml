                        <li><a asp-controller="Home" asp-action="Blog">مجله آموزشی پدل</a></li>
                        <li><a asp-controller="Home" asp-action="About">درباره ما</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">ارتباط با ما</a></li>
                        <li><a asp-controller="Home" asp-action="PadelGuide">راهنمای جامع 0 تا 100 ساخت زمین پدل</a></li>
                    </ul>
