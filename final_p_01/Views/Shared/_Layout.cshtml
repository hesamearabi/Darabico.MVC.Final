    <meta property="og:title" content="@(ViewData["Title"] != null ? $"دارابی کو | {ViewData["Title"]}" : "دارابی کو | مرجع تخصصی ساخت و تجهیز زمین پدل")">
    <meta property="og:type" content="website">
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "صفر تا صد ساخت زمین پدل با شیشه‌های نشکن، چمن مصنوعی و سازه استاندارد جهانی بدون واسطه.")">
