                </div>
            </div>
        </div>
    </footer>

    <div class="sub-footer">
        <div class="sub-footer-container">
            <p>Powered by <a href="https://www.linkedin.com/in/hesam-arabi/" target="_blank" rel="noopener noreferrer" class="dev-linkedin-link">hesamearabi</a></p>
        </div>
    </div>

    <script src="@Url.Content("~/JS-SOURCE/minislider.js")" asp-append-version="true" defer></script>
    <script src="@Url.Content("~/JS-SOURCE/slider-body.js")" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const header = document.getElementById("main-header");
            const isHomePage = @(isHomePage.ToString().ToLower());

            if (header) {
                let scrolled = false;
                let ticking = false;

                const update = () => {
                    const next = window.scrollY > 50;
                    if (next !== scrolled) {
                        scrolled = next;
                        if (isHomePage) {
                            header.classList.toggle("scrolled", next);
                        }
                    }
                    ticking = false;
                };

                window.addEventListener("scroll", () => {
                    if (!ticking) {
                        ticking = true;
                        requestAnimationFrame(update);
                    }
                }, { passive: true });

                update();
            }

            const mobileMenu = document.getElementById("mobile-menu");
            const overlay = document.getElementById("mobile-overlay");
            const hamburgerBtn = document.getElementById("hamburger-btn");
            const closeMenuBtn = document.getElementById("close-menu-btn");
            const mobileLinks = document.querySelectorAll(".mobile-link");

            function toggleMenu(active) {
                if (mobileMenu && overlay) {
                    mobileMenu.classList.toggle("active", active);
                    overlay.classList.toggle("active", active);
                    if (!document.body.classList.contains("loading-state")) {
                        document.body.style.overflow = active ? "hidden" : "";
                    }
                }
            }

            if (hamburgerBtn) hamburgerBtn.onclick = () => toggleMenu(true);
            if (closeMenuBtn) closeMenuBtn.onclick = () => toggleMenu(false);
            if (overlay) overlay.onclick = () => toggleMenu(false);

            if (mobileLinks) {
                mobileLinks.forEach(l => {
                    l.onclick = () => toggleMenu(false);
                });
            }

            const goTopBtn = document.querySelector('.go-top-btn');
            if (goTopBtn) {
                goTopBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }
        });

        window.addEventListener("load", function () {
            const LOADER_DELAY_MS = 800;
            const loader = document.getElementById("brand-loader");
            const body = document.body;

            setTimeout(() => {
                if (!loader) {
                    body.classList.remove("loading-state");
                    return;
                }

                let finished = false;
                const finish = () => {
                    if (finished) return;
                    finished = true;
                    body.classList.remove("loading-state");
                    loader.remove();
                };

                loader.classList.add("loader-hidden");
                loader.addEventListener("transitionend", finish, { once: true });
                setTimeout(finish, 900);
            }, LOADER_DELAY_MS);
        });
    </script>
</body>
</html>