@model ErrorViewModel
@{
    ViewData["Title"] = "خطای غیرمنتظره";
    ViewData["MetaDescription"] = "در پردازش درخواست شما خطایی رخ داد. لطفاً دقایقی دیگر دوباره تلاش کنید.";
    ViewData["Robots"] = "noindex, nofollow";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <style>
        .err-page-wrapper {
            min-height: 75vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 140px 20px 80px;
            background-color: #f8fafc;
        }

        .err-card {
            max-width: 560px;
            width: 100%;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 24px;
            padding: 48px 36px;
            text-align: center;
            box-shadow: 0 12px 35px rgba(10, 12, 18, 0.06);
        }

        .err-code {
            font-size: 4rem;
            font-weight: 900;
            line-height: 1;
            color: #0056b3;
            margin-bottom: 16px;
        }

        .err-title {
            font-size: 1.65rem;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 14px;
        }

        .err-desc {
            font-size: 1rem;
            line-height: 1.9;
            color: #475569;
            margin: 0 0 28px;
        }

        .err-actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .err-btn-primary {
            display: inline-block;
            padding: 12px 28px;
            border-radius: 50px;
            background-color: #0a0c12;
            color: #ffffff;
            text-decoration: none;
            font-weight: 700;
            transition: background-color 0.25s ease, transform 0.25s ease;
        }

            .err-btn-primary:hover {
                background-color: #0056b3;
                transform: translateY(-2px);
            }

        .err-btn-secondary {
            display: inline-block;
            padding: 12px 28px;
            border-radius: 50px;
            background-color: #f1f5f9;
            color: #0f172a;
            text-decoration: none;
            font-weight: 700;
            transition: background-color 0.25s ease, transform 0.25s ease;
        }

            .err-btn-secondary:hover {
                background-color: #e2e8f0;
                transform: translateY(-2px);
            }

        .err-request-id {
            margin-top: 28px;
            padding-top: 18px;
            border-top: 1px solid #f1f5f9;
            font-size: 0.85rem;
            color: #64748b;
        }

            .err-request-id code {
                direction: ltr;
                display: inline-block;
                background: #f1f5f9;
                padding: 2px 8px;
                border-radius: 6px;
                color: #334155;
            }
    </style>
}

<section class="err-page-wrapper">
    <div class="err-card">
        <div class="err-code" dir="ltr">500</div>
        <h1 class="err-title">خطایی در سرور رخ داد</h1>
        <p class="err-desc">
            متأسفانه در پردازش درخواست شما مشکلی پیش آمد. لطفاً صفحه را مجدداً بارگذاری کنید یا به صفحه اصلی بازگردید.
        </p>

        <div class="err-actions">
            <a href="/" class="err-btn-primary">بازگشت به صفحه اصلی</a>
            <a asp-controller="Home" asp-action="Contact" class="err-btn-secondary">ارتباط با پشتیبانی</a>
        </div>

        @if (Model != null && Model.ShowRequestId)
        {
            <div class="err-request-id">
                کد پیگیری: <code>@Model.RequestId</code>
            </div>
        }
    </div>
</section>