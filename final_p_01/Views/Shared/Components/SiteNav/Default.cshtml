@model final_p_01.ViewComponents.SiteNavViewModel
<div class="workspace-nav-subtree">
    <details class="workspace-nav-group">
        <summary>راهنمای جامع 0 تا 100 ساخت زمین پدل</summary>
        <ul class="workspace-nav-cluster">
            <li><a href="/padel-court-construction-guide" class="nav-link">مشاهده راهنمای جامع</a></li>
            @foreach (var child in Model.GuideChildren)
            {
                <li><a href="/blog/@child.Slug" class="nav-link">@child.Title</a></li>
            }
        </ul>
    </details>
    <details class="workspace-nav-group">
        <summary>مقالات و دسته‌بندی‌ها</summary>
        <ul class="workspace-nav-cluster">
            <li><a href="/blog" class="nav-link">همه مقالات</a></li>
            @foreach (var category in Model.Categories)
            {
                <li><a href="/blog?category=@category.Id" class="nav-link">@category.Name</a></li>
            }
            @foreach (var post in Model.LatestPosts)
            {
                <li><a href="/blog/@post.Slug" class="nav-link">@post.Title</a></li>
            }
        </ul>
    </details>
</div>