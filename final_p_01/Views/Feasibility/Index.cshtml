@model final_p_01.Controllers.FeasibilityLeadViewModel
@{
    ViewData["Title"] = Model.MetaTitle ?? "نمونه طرح توجیهی احداث زمین پدل";
    if (!string.IsNullOrEmpty(Model.MetaDescription))
    {
        ViewData["MetaDescription"] = Model.MetaDescription;
    }
}
<main class="form-page" dir="rtl">
    <h1>@(Model.PageTitle ?? "نمونه طرح توجیهی")</h1>
    @if (!string.IsNullOrEmpty(Model.PageIntro))
    {
        <p class="form-page__intro">@Model.PageIntro</p>
    }

    @if (!string.IsNullOrEmpty(Model.DownloadToken) && Model.PdfConfigured)
    {
        <div class="result-card" role="status">
            <h2 class="result-card__title">ثبت شد</h2>
            <p class="form-page__intro">فایل نمونه طرح توجیهی آماده دانلود است:</p>
            <a class="download-cta" href="/feasibility-study/download?token=@Model.DownloadToken" download>
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                دانلود فایل PDF
            </a>
        </div>
    }
    else
    {
        <form method="post" asp-action="Index" class="form-grid" novalidate>
            @Html.AntiForgeryToken()
            <div class="form-field">
                <label asp-for="FullName">نام و نام خانوادگی</label>
                <input asp-for="FullName" class="form-input" />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>
            <div class="form-field">
                <label asp-for="Mobile">شماره موبایل</label>
                <input asp-for="Mobile" class="form-input form-input--ltr" inputmode="tel" />
                <span asp-validation-for="Mobile" class="field-validation-error"></span>
            </div>
            <input type="text" name="Website" value="" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
            <div class="form-grid__full">
                <button type="submit" class="btn-submit">
                    <span class="btn-submit__spinner" aria-hidden="true"></span>
                    <span class="btn-submit__label">دریافت نمونه طرح توجیهی</span>
                </button>
            </div>
        </form>
    }
</main>

@section Scripts {
    <script>
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function () {
                if (form.dataset.submitted) return;
                form.dataset.submitted = '1';
                var btn = form.querySelector('.btn-submit');
                if (btn) {
                    btn.classList.add('is-loading');
                    btn.disabled = true;
                    var label = btn.querySelector('.btn-submit__label');
                    if (label) label.textContent = 'در حال ثبت…';
                }
            });
        });
    </script>
}
