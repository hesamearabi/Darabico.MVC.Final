@model IEnumerable<final_p_01.Domain.Entities.DocumentItem>
@{
    ViewData["Title"] = "کاتالوگ و دیتاشیت‌ها";
}
<main class="container py-5" dir="rtl">
    <h1>کاتالوگ و دیتاشیت‌های فنی</h1>
    <ul class="list-group">
        @foreach (var item in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@item.Title</strong>
                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        <p class="small text-muted mb-0">@item.Description</p>
                    }
                </div>
                <a class="btn btn-outline-primary" href="/technical-docs/download/@item.Id" download>دانلود</a>
            </li>
        }
        @if (!Model.Any())
        {
            <li class="list-group-item">موردی برای نمایش موجود نیست.</li>
        }
    </ul>
</main>
