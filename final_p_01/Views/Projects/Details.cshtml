@using Darabico.Domain.Enums
@inject final_p_01.Services.ISiteUrlBuilder UrlBuilder
@model Darabico.Web.ViewModels.Public.ProjectDetailViewModel
@{
    ViewData["Title"] = Model.MetaTitle;
    ViewData["MetaDescription"] = Model.MetaDescription;
    var canonicalUrl = UrlBuilder.Absolute($"/projects/{Uri.EscapeDataString(Model.Slug)}");
    ViewData["Canonical"] = canonicalUrl;
    var breadcrumbs = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new[]
        {
            new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = UrlBuilder.Absolute("/") },
            new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "پروژه‌ها", ["item"] = UrlBuilder.Absolute("/projects") },
            new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = Model.Title, ["item"] = canonicalUrl }
        }
    };
    var courtTypeLabel = Model.CourtType == CourtType.Outdoor ? "روباز" : "سرپوشیده";
}

@section Head {
    <script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(breadcrumbs))</script>
}

<article class="project-detail" dir="rtl">
    <div class="container">
        <nav class="breadcrumb" aria-label="مسیر صفحه">
            <a asp-controller="Home" asp-action="Index">خانه</a>
            <span>/</span>
            <a asp-controller="Projects" asp-action="Index">پروژه‌ها</a>
            <span>/</span>
            <span aria-current="page">@Model.Title</span>
        </nav>

        <header class="detail-header">
            <h1 class="detail-title">@Model.Title</h1>
            <div class="detail-specs">
                <div class="spec-box">
                    <span class="spec-label">شهر اجرا</span>
                    <strong class="spec-value">@Model.City</strong>
                </div>
                <div class="spec-box">
                    <span class="spec-label">تعداد زمین</span>
                    <strong class="spec-value">@Model.CourtCount زمین پدل</strong>
                </div>
                <div class="spec-box">
                    <span class="spec-label">نوع سازه</span>
                    <strong class="spec-value">@courtTypeLabel</strong>
                </div>
                <div class="spec-box">
                    <span class="spec-label">سال اجرا</span>
                    <strong class="spec-value">@Model.ExecutionYear</strong>
                </div>
                <div class="spec-box">
                    <span class="spec-label">مدت اجرا</span>
                    <strong class="spec-value">@Model.ExecutionDurationMonths ماه</strong>
                </div>
            </div>
        </header>

        <!-- تصویر اصلی صفحه تک‌پروژه: بدون loading="lazy" برای LCP بهینه -->
        <figure class="hero-figure">
            <img src="@Model.FeaturedImageUrl"
                 alt="@Model.Title - @Model.City"
                 width="1200"
                 height="800"
                 fetchpriority="high"
                 decoding="async"
                 class="hero-img" />
        </figure>

        <!-- توضیحات کامل پروژه -->
        <section class="detail-content">
            <h2 class="section-heading">مشخصات فنی و شرح اجرای پروژه</h2>
            <div class="rich-text">
                @Html.Raw(Model.Description)
            </div>
        </section>

        <!-- اسلایدر مقایسه قبل و بعد (در صورت وجود هر دو تصویر) -->
        @if (!string.IsNullOrWhiteSpace(Model.BeforeImageUrl) && !string.IsNullOrWhiteSpace(Model.AfterImageUrl))
        {
            <section class="compare-section">
                <h2 class="section-heading">مقایسه محل پروژه قبل و بعد از اجرا</h2>
                <div class="ba-slider" id="baSlider">
                    <img src="@Model.AfterImageUrl"
                         alt="پس از اجرای @Model.Title"
                         width="1200"
                         height="800"
                         loading="lazy"
                         class="ba-img ba-img--after" />

                    <div class="ba-before-wrap" id="baBeforeWrap">
                        <img src="@Model.BeforeImageUrl"
                             alt="پیش از اجرای @Model.Title"
                             width="1200"
                             height="800"
                             loading="lazy"
                             class="ba-img ba-img--before" />
                    </div>

                    <span class="ba-label ba-label--after">بعد از اجرا</span>
                    <span class="ba-label ba-label--before">قبل از اجرا</span>

                    <div class="ba-handle" id="baHandle" aria-hidden="true">
                        <span>⇄</span>
                    </div>
                    <input type="range"
                           id="baRange"
                           min="0"
                           max="100"
                           value="50"
                           aria-label="تغییر موقعیت مقایسه قبل و بعد"
                           class="ba-range" />
                </div>
            </section>
        }

        <!-- پخش‌کننده ویدیو با preload="none" و poster -->
        @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
        {
            <section class="video-section">
                <h2 class="section-heading">ویدیو مراحل ساخت و بهره‌برداری</h2>
                <div class="video-wrap">
                    <video controls preload="none" poster="@Model.FeaturedImageUrl" class="project-video">
                        <source src="@Model.VideoUrl" type="video/mp4" />
                        مرورگر شما از پخش ویدیو پشتیبانی نمی‌کند.
                    </video>
                </div>
            </section>
        }

        <!-- گالری تصاویر همراه با Lightbox سبک و بدون وابستگی خارجی -->
        @if (Model.GalleryImages.Any())
        {
            <section class="gallery-section">
                <h2 class="section-heading">گالری تصاویر پروژه</h2>
                <div class="gallery-grid">
                    @for (int i = 0; i < Model.GalleryImages.Count; i++)
                    {
                        var img = Model.GalleryImages[i];
                        <button type="button"
                                class="gallery-item"
                                data-index="@i"
                                data-src="@img.ImageUrl"
                                data-alt="@img.AltText"
                                aria-label="بزرگ‌نمایی: @img.AltText">
                            <img src="@img.ImageUrl"
                                 alt="@img.AltText"
                                 width="@img.Width"
                                 height="@img.Height"
                                 loading="lazy"
                                 decoding="async"
                                 class="gallery-thumb" />
                        </button>
                    }
                </div>
            </section>
        }

        <!-- باکس اقدام (CTA) -->
        <aside class="cta-banner">
            <div class="cta-banner__text">
                <h2>قصد احداث زمین پدل مشابه این پروژه را دارید؟</h2>
                <p>کارشناسان فنی دارابیکو آماده ارائه مشاوره تخصصی، برآورد هزینه و زمان‌بندی اجرا برای زمین شما هستند.</p>
            </div>
            <a href="/inquiry?projectRef=@Model.Id" class="cta-banner__btn">
                استعلام برای پروژه مشابه
            </a>
        </aside>
    </div>
</article>
<section class="form-page" aria-label="درخواست مشاوره پروژه">
    <h2 class="form-page__title">درباره پروژه مشابه مشاوره بگیرید</h2>
    @await Component.InvokeAsync("InquiryForm", new { source = "projects", projectRef = Model.Id })
</section>

<!-- Lightbox بومی -->
<div class="lightbox" id="projectLightbox" hidden aria-modal="true" role="dialog">
    <button type="button" class="lightbox__close" id="lbClose" aria-label="بستن">✕</button>
    <button type="button" class="lightbox__nav lightbox__prev" id="lbPrev" aria-label="تصویر قبلی">❯</button>
    <figure class="lightbox__figure">
        <img id="lbImage" src="" alt="" width="1200" height="800" class="lightbox__img" />
        <figcaption id="lbCaption" class="lightbox__caption"></figcaption>
    </figure>
    <button type="button" class="lightbox__nav lightbox__next" id="lbNext" aria-label="تصویر بعدی">❮</button>
</div>

<style>
    .project-detail {
        padding: 2rem 0 4rem;
        background: #fff;
        color: #0f172a;
    }

    .container {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1rem;
        box-sizing: border-box;
    }

    .breadcrumb {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        font-size: .85rem;
        color: #64748b;
        margin-bottom: 1.5rem;
    }

        .breadcrumb a {
            color: #0f766e;
            text-decoration: none;
        }

    .detail-title {
        font-size: clamp(1.45rem, 3.2vw, 2.2rem);
        font-weight: 800;
        margin: 0 0 1.25rem;
    }

    .detail-specs {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: .85rem;
        margin-bottom: 1.75rem;
    }

    .spec-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: .85rem 1rem;
    }

    .spec-label {
        display: block;
        font-size: .8rem;
        color: #64748b;
        margin-bottom: .25rem;
    }

    .spec-value {
        font-size: 1rem;
        color: #0f172a;
    }

    .hero-figure {
        margin: 0 0 2.5rem;
        border-radius: 16px;
        overflow: hidden;
        background: #f1f5f9;
        aspect-ratio: 3 / 2;
    }

    .hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .section-heading {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0 0 1rem;
        padding-bottom: .5rem;
        border-bottom: 2px solid #e2e8f0;
    }

    .detail-content {
        margin-bottom: 2.5rem;
    }

    .rich-text {
        line-height: 1.9;
        font-size: 1rem;
        color: #334155;
        overflow-wrap: break-word;
    }

    /* اسلایدر قبل و بعد */
    .compare-section {
        margin-bottom: 2.5rem;
    }

    .ba-slider {
        position: relative;
        aspect-ratio: 3 / 2;
        border-radius: 16px;
        overflow: hidden;
        user-select: none;
        background: #0f172a;
    }

    .ba-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .ba-before-wrap {
        position: absolute;
        inset: 0;
        width: 50%;
        overflow: hidden;
    }

        .ba-before-wrap .ba-img {
            width: 100%;
            max-width: none;
        }

    .ba-label {
        position: absolute;
        bottom: 1rem;
        padding: .35rem .8rem;
        border-radius: 8px;
        background: rgba(15, 23, 42, .75);
        color: #fff;
        font-size: .8rem;
        font-weight: 600;
        pointer-events: none;
    }

    .ba-label--before {
        left: 1rem;
    }

    .ba-label--after {
        right: 1rem;
    }

    .ba-handle {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 3px;
        background: #fff;
        transform: translateX(-50%);
        pointer-events: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .ba-handle span {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #0f766e;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            box-shadow: 0 2px 10px rgba(0,0,0,.35);
        }

    .ba-range {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: ew-resize;
        margin: 0;
    }

    /* ویدیو */
    .video-section {
        margin-bottom: 2.5rem;
    }

    .video-wrap {
        border-radius: 16px;
        overflow: hidden;
        background: #000;
        aspect-ratio: 16 / 9;
    }

    .project-video {
        width: 100%;
        height: 100%;
        display: block;
    }

    /* گالری */
    .gallery-section {
        margin-bottom: 3rem;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
        gap: 1rem;
    }

    .gallery-item {
        padding: 0;
        border: none;
        background: #f1f5f9;
        border-radius: 12px;
        overflow: hidden;
        cursor: zoom-in;
        aspect-ratio: 3 / 2;
    }

    .gallery-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform .25s;
    }

    .gallery-item:hover .gallery-thumb {
        transform: scale(1.04);
    }

    /* CTA */
    .cta-banner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding: 2rem;
        border-radius: 18px;
        background: linear-gradient(135deg, #0f766e, #115e59);
        color: #fff;
    }

    .cta-banner__text {
        max-width: 650px;
    }

        .cta-banner__text h2 {
            margin: 0 0 .5rem;
            font-size: 1.35rem;
        }

        .cta-banner__text p {
            margin: 0;
            opacity: .92;
            font-size: .95rem;
            line-height: 1.6;
        }

    .cta-banner__btn {
        padding: .9rem 1.75rem;
        border-radius: 12px;
        background: #fff;
        color: #0f766e;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
    }

    /* Lightbox */
    .lightbox[hidden] {
        display: none;
    }

    .lightbox {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(2, 6, 23, .92);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .lightbox__figure {
        margin: 0;
        max-width: 90vw;
        max-height: 85vh;
        text-align: center;
    }

    .lightbox__img {
        max-width: 100%;
        max-height: 76vh;
        width: auto;
        height: auto;
        border-radius: 10px;
    }

    .lightbox__caption {
        color: #e2e8f0;
        margin-top: .75rem;
        font-size: .95rem;
    }

    .lightbox__close, .lightbox__nav {
        position: absolute;
        background: rgba(255,255,255,.15);
        color: #fff;
        border: none;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        font-size: 1.25rem;
        cursor: pointer;
    }

    .lightbox__close {
        top: 1rem;
        left: 1rem;
    }

    .lightbox__prev {
        right: 1rem;
    }

    .lightbox__next {
        left: 1rem;
    }
</style>

@section Scripts {
    <script>
        (function () {
            // 1. اسلایدر قبل و بعد
            const range = document.getElementById('baRange');
            const beforeWrap = document.getElementById('baBeforeWrap');
            const handle = document.getElementById('baHandle');
            if (range && beforeWrap && handle) {
                const syncSlider = (val) => {
                    beforeWrap.style.width = val + '%';
                    handle.style.left = val + '%';
                };
                range.addEventListener('input', (e) => syncSlider(e.target.value));
            }

            // 2. لایت‌باکس بومی گالری
            const items = Array.from(document.querySelectorAll('.gallery-item'));
            const lightbox = document.getElementById('projectLightbox');
            const lbImg = document.getElementById('lbImage');
            const lbCap = document.getElementById('lbCaption');
            if (!items.length || !lightbox) return;

            let currentIndex = 0;
            const showSlide = (idx) => {
                currentIndex = (idx + items.length) % items.length;
                const target = items[currentIndex];
                lbImg.src = target.dataset.src;
                lbImg.alt = target.dataset.alt;
                lbCap.textContent = target.dataset.alt;
                lightbox.hidden = false;
                document.body.style.overflow = 'hidden';
            };

            const closeLb = () => {
                lightbox.hidden = true;
                document.body.style.overflow = '';
            };

            items.forEach((btn, idx) => btn.addEventListener('click', () => showSlide(idx)));
            document.getElementById('lbClose').addEventListener('click', closeLb);
            document.getElementById('lbPrev').addEventListener('click', () => showSlide(currentIndex - 1));
            document.getElementById('lbNext').addEventListener('click', () => showSlide(currentIndex + 1));

            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) closeLb();
            });

            document.addEventListener('keydown', (e) => {
                if (lightbox.hidden) return;
                if (e.key === 'Escape') closeLb();
                if (e.key === 'ArrowRight') showSlide(currentIndex - 1);
                if (e.key === 'ArrowLeft') showSlide(currentIndex + 1);
            });
        })();
    </script>
}