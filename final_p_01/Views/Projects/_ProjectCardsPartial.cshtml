@using Darabico.Domain.Enums
@model IEnumerable<Darabico.Web.ViewModels.Public.ProjectCardViewModel>
@foreach (var item in Model)
{
    <article class="dc-projects-card">
        <a asp-controller="Projects" asp-action="Details" asp-route-slug="@item.Slug" class="dc-projects-card-link">
            <div class="dc-projects-media">
                <img src="@item.ThumbnailUrl" alt="@item.Title - @item.City" width="600" height="400" loading="lazy" decoding="async" />
                <span class="dc-projects-badge">@(item.CourtType == CourtType.Outdoor ? "روباز" : "سرپوشیده")</span>
            </div>
            <div class="dc-projects-card-body">
                <h2>@item.Title</h2>
                <div class="dc-projects-meta"><span>@item.City</span><span>@item.CourtCount زمین پدل</span></div>
                <span class="dc-projects-card-action">مشاهده پروژه <span aria-hidden="true">←</span></span>
            </div>
        </a>
    </article>
}
