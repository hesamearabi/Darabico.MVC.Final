@using Darabico.Domain.Enums
@model IEnumerable<Darabico.Web.ViewModels.Public.ProjectCardViewModel>

@foreach (var item in Model)
{
    var courtTypeLabel = item.CourtType == CourtType.Outdoor ? "روباز" : "سرپوشیده";
    var badgeClass = item.CourtType == CourtType.Outdoor ? "badge-outdoor" : "badge-indoor";

    <article class="project-card">
        <a asp-controller="Projects" asp-action="Details" asp-route-slug="@item.Slug" class="project-card__link" aria-label="مشاهده جزئیات @item.Title">
            <div class="project-card__media">
                <img src="@item.ThumbnailUrl"
                     alt="@item.Title - @item.City"
                     width="600"
                     height="400"
                     loading="lazy"
                     decoding="async"
                     class="project-card__img" />
                <span class="project-card__badge @badgeClass">@courtTypeLabel</span>
            </div>
            <div class="project-card__body">
                <h2 class="project-card__title">@item.Title</h2>
                <div class="project-card__meta">
                    <span class="meta-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        @item.City
                    </span>
                    <span class="meta-item">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                            <line x1="12" y1="3" x2="12" y2="21"></line>
                        </svg>
                        @item.CourtCount زمین پدل
                    </span>
                </div>
            </div>
        </a>
    </article>
}