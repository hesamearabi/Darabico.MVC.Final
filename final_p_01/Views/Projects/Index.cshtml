@using Darabico.Domain.Enums
@model Darabico.Web.ViewModels.Public.ProjectIndexViewModel
@{
    ViewData["Title"] = "پروژه‌های اجرا شده زمین پدل | دارابیکو";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.SelectedCity) || Model.SelectedCourtType.HasValue;
    ViewData["Canonical"] = !hasFilters && Model.CurrentPage > 1 ? $"/projects?page={Model.CurrentPage}" : "/projects";
    var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    ViewData["MetaDescription"] = "نمونه پروژه‌های اجرا شده زمین پدل دارابیکو در شهرهای مختلف ایران؛ مشخصات، تصاویر و جزئیات هر پروژه را ببینید.";
}
<main class="dc-projects-page" dir="rtl">
    <header class="dc-projects-header">
        <p class="dc-projects-eyebrow">از طراحی تا اولین بازی</p>
        <h1>پروژه‌های اجرا شده دارابیکو</h1>
        <p>مجموعه‌ای از زمین‌های پدل استاندارد طراحی و اجرا شده در شهرهای مختلف کشور</p>
    </header>
    <section class="dc-projects-content" aria-label="پروژه‌ها و فیلترها">
        <form method="get" asp-controller="Projects" asp-action="Index" class="dc-projects-filters">
            <div class="dc-projects-field">
                <label for="project-city">شهر</label>
                <select name="city" id="project-city">
                    <option value="">همه شهرها</option>
                    @foreach (var city in Model.AvailableCities)
                    {
                        <option value="@city" selected="@(Model.SelectedCity == city)">@city.Trim()</option>
                    }
                </select>
            </div>
            <fieldset class="dc-projects-types">
                <legend>نوع زمین</legend>
                <div class="dc-projects-options">
                    <label><input type="radio" name="courtType" value="" checked="@(!Model.SelectedCourtType.HasValue)" /><span>همه</span></label>
                    <label><input type="radio" name="courtType" value="Outdoor" checked="@(Model.SelectedCourtType == CourtType.Outdoor)" /><span>روباز</span></label>
                    <label><input type="radio" name="courtType" value="Indoor" checked="@(Model.SelectedCourtType == CourtType.Indoor)" /><span>سرپوشیده</span></label>
                </div>
            </fieldset>
            <button type="submit" class="dc-projects-button">اعمال فیلترها</button>
        </form>
        @if (!Model.Projects.Any())
        {
            <div class="dc-projects-empty">
                <svg width="80" height="64" viewBox="0 0 80 64" fill="none" stroke="currentColor" aria-hidden="true"><rect x="8" y="8" width="64" height="48" rx="2"/><path d="M40 8v48M8 32h64M24 8v24m32-24v24M24 32v24m32-24v24"/></svg>
                <h2>پروژه‌ای با این مشخصات پیدا نشد</h2>
                <p>در حال حاضر پروژه‌ای با فیلترهای انتخاب‌شده یافت نشد.</p>
                <a asp-controller="Projects" asp-action="Index" class="dc-projects-button">نمایش همه پروژه‌ها</a>
            </div>
        }
        else
        {
            <div class="dc-projects-grid" id="projectsGrid">
                <partial name="_ProjectCardsPartial" model="Model.Projects" />
            </div>
            @if (totalPages > 1)
            {
                <nav class="dc-projects-pagination dc-projects-page-links" aria-label="صفحه‌بندی پروژه‌ها">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="dc-projects-button" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-city="@Model.SelectedCity" asp-route-courtType="@Model.SelectedCourtType" rel="prev">صفحه قبل</a>
                    }
                    @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                    {
                        <a class="dc-projects-button" asp-action="Index" asp-route-page="@pageNumber" asp-route-city="@Model.SelectedCity" asp-route-courtType="@Model.SelectedCourtType" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
                    }
                    @if (Model.HasMore)
                    {
                        <a class="dc-projects-button" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-city="@Model.SelectedCity" asp-route-courtType="@Model.SelectedCourtType" rel="next">صفحه بعد</a>
                    }
                </nav>
            }
            @if (Model.HasMore)
            {
                <div class="dc-projects-pagination">
                    <button type="button" class="dc-projects-button" id="loadMoreBtn" data-page="@Model.CurrentPage" data-city="@Model.SelectedCity" data-court-type="@Model.SelectedCourtType" hidden>نمایش پروژه‌های بیشتر</button>
                    <p id="projectsStatus" role="status" aria-live="polite"></p>
                </div>
            }
        }
    </section>
    <section class="dc-projects-consultation" aria-labelledby="projects-consultation-title">
        <header class="dc-section-heading">
            <h2 id="projects-consultation-title">پروژه بعدی، زمین پدل شما</h2>
            <p>اطلاعات پروژه‌تان را ثبت کنید تا درباره طراحی، اجرا و برآورد هزینه با شما تماس بگیریم.</p>
        </header>
        @await Component.InvokeAsync("InquiryForm", new { source = "projects" })
    </section>
</main>
@section Scripts {
    <script src="~/js/projects.js" asp-append-version="true" defer></script>
}
