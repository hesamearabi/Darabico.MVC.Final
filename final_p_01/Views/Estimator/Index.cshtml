@model final_p_01.Controllers.EstimatorFormViewModel
@{
    ViewData["Title"] = "برآوردگر هزینه احداث زمین پدل";
}
<main class="form-page" dir="rtl">
    <h1>برآوردگر هزینه احداث زمین پدل</h1>
    <p class="form-page__intro">مشخصات زمین موردنظر خود را وارد کنید تا بازه هزینه برآورد شود.</p>

    @if (Model.Result is not null)
    {
        <div class="result-card" role="status">
            <h2 class="result-card__title">بازه برآورد هزینه</h2>
            <p class="result-card__total">@Model.Result.MinCost.ToString("N0") تا @Model.Result.MaxCost.ToString("N0") تومان</p>
            <table class="result-card__table">
                <tbody>
                    <tr>
                        <th scope="row">نوع زمین</th>
                        <td>@(Model.CourtType == 2 ? "سرپوشیده" : "روباز")</td>
                    </tr>
                    <tr>
                        <th scope="row">تعداد زمین</th>
                        <td>@Model.CourtCount</td>
                    </tr>
                    @if (!string.IsNullOrEmpty(Model.Result.City))
                    {
                        <tr>
                            <th scope="row">شهر</th>
                            <td>@Model.Result.City</td>
                        </tr>
                    }
                    @if (!string.IsNullOrEmpty(Model.Result.MaterialTierTitle))
                    {
                        <tr>
                            <th scope="row">سطح متریال</th>
                            <td>@Model.Result.MaterialTierTitle</td>
                        </tr>
                    }
                    <tr>
                        <th scope="row">هزینه هر زمین</th>
                        <td>@Model.Result.PricePerCourt.ToString("N0") تومان</td>
                    </tr>
                    <tr>
                        <th scope="row">جمع بازه برآورد</th>
                        <td>@Model.Result.MinCost.ToString("N0") – @Model.Result.MaxCost.ToString("N0") تومان</td>
                    </tr>
                </tbody>
            </table>
            @if (!string.IsNullOrEmpty(Model.Result.Disclaimer))
            {
                <p class="result-card__note">@Model.Result.Disclaimer</p>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="form-alert form-alert--warning" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post" asp-action="Index" class="form-grid" novalidate>
        @Html.AntiForgeryToken()
        <div class="form-field">
            <label asp-for="FullName">نام و نام خانوادگی</label>
            <input asp-for="FullName" class="form-input" />
            <span asp-validation-for="FullName" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="Mobile">شماره موبایل</label>
            <input asp-for="Mobile" class="form-input form-input--ltr" inputmode="tel" />
            <span asp-validation-for="Mobile" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="CourtType">نوع زمین</label>
            <select asp-for="CourtType" class="form-select">
                <option value="1">روباز</option>
                <option value="2">سرپوشیده</option>
            </select>
        </div>
        <div class="form-field">
            <label asp-for="CourtCount">تعداد زمین</label>
            <input asp-for="CourtCount" type="number" min="1" max="50" class="form-input form-input--ltr" />
            <span asp-validation-for="CourtCount" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="City">شهر</label>
            <select asp-for="City" class="form-select">
                <option value="">— انتخاب شهر —</option>
                @foreach (var city in Model.CityMultipliers)
                {
                    <option value="@city.City">@city.City</option>
                }
            </select>
        </div>
        <div class="form-field">
            <label asp-for="MaterialTier">سطح کیفیت متریال</label>
            <select asp-for="MaterialTier" class="form-select">
                <option value="">— انتخاب کنید —</option>
                @foreach (var tier in Model.MaterialTiers)
                {
                    <option value="@tier.Title">@tier.Title</option>
                }
            </select>
        </div>
        @* تله ضداسپم *@
        <input type="text" name="Website" value="" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <div class="form-grid__full">
            <button type="submit" class="btn-submit">
                <span class="btn-submit__spinner" aria-hidden="true"></span>
                <span class="btn-submit__label">محاسبه هزینه</span>
            </button>
        </div>
    </form>
</main>

@section Scripts {
    <script>
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function () {
                if (form.dataset.submitted) return;
                form.dataset.submitted = '1';
                var btn = form.querySelector('.btn-submit');
                if (btn) {
                    btn.classList.add('is-loading');
                    btn.disabled = true;
                    var label = btn.querySelector('.btn-submit__label');
                    if (label) label.textContent = 'در حال محاسبه…';
                }
            });
        });
    </script>
}
