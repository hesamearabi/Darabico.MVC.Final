@model final_p_01.Controllers.BookingFormViewModel
@{
    ViewData["Title"] = "رزرو بازدید";
}
<main class="container py-5" dir="rtl">
    <h1>رزرو بازدید</h1>
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-warning">@Model.ErrorMessage</div>
    }

    <form method="post" asp-action="Index" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-md-6">
            <label asp-for="SlotId" class="form-label">اسلات بازدید</label>
            <select asp-for="SlotId" class="form-select">
                <option value="">— انتخاب اسلات —</option>
                @foreach (var slot in Model.AvailableSlots)
                {
                    @if (slot.BookedCount < slot.Capacity)
                    {
                        <option value="@slot.Id">@slot.Date.ToString("yyyy/MM/dd") — @slot.StartTime تا @slot.EndTime</option>
                    }
                }
            </select>
            <span asp-validation-for="SlotId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Mobile" class="form-label">شماره موبایل</label>
            <input asp-for="Mobile" class="form-control" inputmode="tel" dir="ltr" />
            <span asp-validation-for="Mobile" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Message" class="form-label">توضیحات (اختیاری)</label>
            <textarea asp-for="Message" rows="3" class="form-control"></textarea>
        </div>
        <input type="text" name="Website" value="" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <div class="col-12">
            <button type="submit" class="btn btn-primary">ثبت رزرو</button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
