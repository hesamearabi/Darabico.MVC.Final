@model final_p_01.Controllers.AfterSalesFormViewModel
@{
    ViewData["Title"] = "درخواست خدمات پس از اجرا";
}
<main class="form-page" dir="rtl">
    <h1>خدمات پس از اجرا</h1>
    @if (!string.IsNullOrEmpty(Model.Intro))
    {
        <p class="form-page__intro">@Model.Intro</p>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="form-alert form-alert--success" role="status">@Model.SuccessMessage</div>
    }

    <form method="post" asp-action="Index" class="form-grid" novalidate>
        @Html.AntiForgeryToken()
        <div class="form-field">
            <label asp-for="FullName">نام و نام خانوادگی</label>
            <input asp-for="FullName" class="form-input" />
            <span asp-validation-for="FullName" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="Mobile">شماره موبایل</label>
            <input asp-for="Mobile" class="form-input form-input--ltr" inputmode="tel" />
            <span asp-validation-for="Mobile" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="ServiceType">نوع خدمت</label>
            <select asp-for="ServiceType" class="form-select">
                <option value="">— انتخاب کنید —</option>
                @foreach (var service in final_p_01.Controllers.AfterSalesFormViewModel.AllowedServiceTypes)
                {
                    <option value="@service">@service</option>
                }
            </select>
            <span asp-validation-for="ServiceType" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="VisitType">نوع مراجعه</label>
            <select asp-for="VisitType" class="form-select">
                <option value="">— انتخاب کنید —</option>
                @foreach (var visit in final_p_01.Controllers.AfterSalesFormViewModel.AllowedVisitTypes)
                {
                    <option value="@visit">@visit</option>
                }
            </select>
            <span asp-validation-for="VisitType" class="field-validation-error"></span>
        </div>
        <div class="form-field form-grid__full">
            <label asp-for="Message">توضیحات</label>
            <textarea asp-for="Message" rows="4" class="form-textarea"></textarea>
        </div>
        <input type="text" name="Website" value="" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <div class="form-grid__full">
            <button type="submit" class="btn-submit">
                <span class="btn-submit__spinner" aria-hidden="true"></span>
                <span class="btn-submit__label">ثبت درخواست</span>
            </button>
        </div>
    </form>
</main>

@section Scripts {
    <script>
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function () {
                if (form.dataset.submitted) return;
                form.dataset.submitted = '1';
                var btn = form.querySelector('.btn-submit');
                if (btn) {
                    btn.classList.add('is-loading');
                    btn.disabled = true;
                    var label = btn.querySelector('.btn-submit__label');
                    if (label) label.textContent = 'در حال ثبت…';
                }
            });
        });
    </script>
}
