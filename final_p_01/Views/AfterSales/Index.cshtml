@model final_p_01.Controllers.AfterSalesFormViewModel
@{
    ViewData["Title"] = "درخواست خدمات پس از اجرا";
}
<main class="container py-5" dir="rtl">
    <h1>خدمات پس از اجرا</h1>
    @if (!string.IsNullOrEmpty(Model.Intro))
    {
        <p class="text-muted">@Model.Intro</p>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <form method="post" asp-action="Index" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-md-6">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Mobile" class="form-label">شماره موبایل</label>
            <input asp-for="Mobile" class="form-control" inputmode="tel" dir="ltr" />
            <span asp-validation-for="Mobile" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ServiceType" class="form-label">نوع خدمت</label>
            <select asp-for="ServiceType" class="form-select">
                <option value="">— انتخاب کنید —</option>
                @foreach (var service in final_p_01.Controllers.AfterSalesFormViewModel.AllowedServiceTypes)
                {
                    <option value="@service">@service</option>
                }
            </select>
            <span asp-validation-for="ServiceType" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="VisitType" class="form-label">نوع مراجعه</label>
            <select asp-for="VisitType" class="form-select">
                <option value="">— انتخاب کنید —</option>
                @foreach (var visit in final_p_01.Controllers.AfterSalesFormViewModel.AllowedVisitTypes)
                {
                    <option value="@visit">@visit</option>
                }
            </select>
            <span asp-validation-for="VisitType" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Message" class="form-label">توضیحات</label>
            <textarea asp-for="Message" rows="4" class="form-control"></textarea>
        </div>
        <input type="text" name="Website" value="" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />
        <div class="col-12">
            <button type="submit" class="btn btn-primary">ثبت درخواست</button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
