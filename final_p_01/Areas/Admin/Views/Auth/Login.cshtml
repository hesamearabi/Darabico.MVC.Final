@model final_p_01.Areas.Admin.Models.LoginViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>ورود به پنل مدیریت · دارابیکو</title>
    <link rel="stylesheet" href="~/vendor/bootstrap/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/CSS-SOURCE/workspace.css" asp-append-version="true" />
</head>
<body class="workspace workspace-login">
    <main class="workspace-login-card">
        <a href="/" class="workspace-brand"><span class="workspace-mark">د</span><span>دارابیکو<small>فضای کاری مدیریت</small></span></a>
        <h1>ورود به پنل مدیریت</h1>
        <p class="text-muted">برای بررسی درخواست‌ها و مدیریت محتوای سایت وارد شوید.</p>
        <form asp-area="Admin" asp-controller="Auth" asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
            <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
            <div class="mb-3"><label asp-for="Email">ایمیل مدیریت</label><input asp-for="Email" class="form-control" dir="ltr" type="email" autocomplete="username" required /><span asp-validation-for="Email"></span></div>
            <div class="mb-3"><label asp-for="Password">رمز عبور</label><input asp-for="Password" class="form-control" dir="ltr" type="password" autocomplete="current-password" required /><span asp-validation-for="Password"></span></div>
            <label class="d-flex gap-2 align-items-center"><input asp-for="RememberMe" />مرا به خاطر بسپار</label>
            <button type="submit" class="btn btn-primary">ورود به مدیریت</button>
        </form>
        <a href="/">بازگشت به سایت دارابیکو</a>
    </main>
    <script src="~/JS-SOURCE/workspace.js" asp-append-version="true" defer></script>
</body>
</html>
