@model final_p_01.ViewModels.InquirySettingsViewModel
@{ ViewData["Title"] = "تنظیمات درخواست مشاوره"; }
<section class="lead-panel"><h1>تنظیمات درخواست مشاوره</h1><p>گزینه‌های فرم و متن تأیید درخواست را مدیریت کنید. اطلاعات تماس اطلاع‌رسانی برای اتصال بعدی ذخیره می‌شود؛ ارسال خودکار در این بخش فعال نیست.</p>
@if(TempData["InquirySaved"] is string message){<p class="form-alert form-alert--success" role="status">@message</p>}
<form method="post" class="public-form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="form-alert form-alert--warning"></div><div class="form-grid">
<div class="form-field form-field--full"><label asp-for="ThanksTitle"></label><input asp-for="ThanksTitle" class="form-input" required maxlength="200" /></div>
<div class="form-field form-field--full"><label asp-for="ThanksBody"></label><textarea asp-for="ThanksBody" class="form-textarea" required maxlength="2000" rows="4"></textarea></div>
<div class="form-field"><label asp-for="Cities"></label><textarea asp-for="Cities" class="form-textarea" maxlength="4000" rows="6"></textarea></div>
<div class="form-field"><label asp-for="BudgetRanges"></label><textarea asp-for="BudgetRanges" class="form-textarea" maxlength="4000" rows="6"></textarea></div>
<div class="form-field"><label asp-for="NotificationEmail"></label><input asp-for="NotificationEmail" type="email" class="form-input" dir="ltr" /></div>
<div class="form-field"><label asp-for="NotificationPhone"></label><input asp-for="NotificationPhone" class="form-input" dir="ltr" inputmode="tel" /></div>
</div><button type="submit" class="btn-submit">ذخیره تنظیمات</button></form></section>
