@model final_p_01.Domain.Entities.Post

@{
    ViewData["Title"] = "ویرایش مقاله";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    .darabico-form-card {
        background: #fff;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid #eee;
    }

    .form-label {
        font-weight: 700;
        color: #121D35;
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .form-control, .form-select {
        border-radius: 8px;
        border: 1px solid #CBD5E1;
        padding: 12px 15px;
        font-size: 0.95rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #d11e32;
            box-shadow: 0 0 0 4px rgba(209, 30, 50, 0.1);
        }

    .btn-submit-darabico {
        background: #121D35;
        color: #fff;
        padding: 12px 30px;
        border-radius: 8px;
        font-weight: bold;
        border: none;
        transition: 0.3s;
    }

        .btn-submit-darabico:hover {
            background: #d11e32;
            color: #fff;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 fw-bold" style="color: #121D35;">ویرایش: @Model.Title</h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">بازگشت به لیست</a>
</div>

<div class="darabico-form-card">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Edit" enctype="multipart/form-data" method="post" id="editForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="CoverImagePath" />

        <div class="row">
            <div class="col-lg-8">
                <div class="mb-4">
                    <label asp-for="Title" class="form-label">عنوان مقاله</label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                <div class="mb-4">
                    <label asp-for="Slug" class="form-label">اسلاگ (URL)</label>
                    <input asp-for="Slug" class="form-control" style="direction: ltr;" required />
                </div>

                <div class="mb-4">
                    <label asp-for="Content" class="form-label">متن مقاله</label>
                    <textarea asp-for="Content" id="Content" class="form-control" rows="12"></textarea>
                </div>

                <div class="card card-outline card-dark mt-5 mb-4" style="border: 1px solid #dee2e6; border-radius: 8px;">
                    <div class="card-header d-flex justify-content-between align-items-center p-3" style="background: #f8f9fa; border-bottom: 1px solid #dee2e6;">
                        <h5 class="mb-0 fw-bold" style="color: #121D35; font-size: 1rem;"><i class="bi bi-patch-question text-danger me-1"></i> ویرایش سوالات متداول (FAQ)</h5>
                        <button type="button" id="btn-add-faq" class="btn btn-sm btn-outline-success fw-bold"><i class="bi bi-plus-lg"></i> افزودن پرسش جدید</button>
                    </div>
                    <div class="card-body p-3" id="faq-wrapper" style="background: #fdfdfd;">
                        @if (Model.Faqs != null && Model.Faqs.Any())
                        {
                            int index = 0;
                            foreach (var faq in Model.Faqs)
                            {
                                <div class="faq-item-row p-3 mb-3 position-relative" id="faq-row-@index" style="background: #fff; border: 1px solid #dee2e6; border-radius: 8px;">
                                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute" style="top: 10px; left: 10px; z-index: 10;" onclick="removeFaqRow(@index)"><i class="bi bi-trash3"></i> حذف</button>
                                    <div class="mb-3 pr-4">
                                        <label class="form-label small text-muted">پرسش متداول:</label>
                                        <input type="text" class="form-control faq-question" name="Faqs[@index].Question" value="@faq.Question" required />
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label small text-muted">پاسخ کوتاه و کامل:</label>
                                        <textarea class="form-control faq-answer" name="Faqs[@index].Answer" rows="2" required>@faq.Answer</textarea>
                                    </div>
                                </div>
                                index++;
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="mb-4">
                    <label asp-for="CategoryId" class="form-label">دسته‌بندی</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required></select>
                </div>
                <div class="mb-4">
                    <label class="form-label">تغییر عکس کاور (اختیاری)</label>
                    <input type="file" name="coverImage" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.CoverImagePath))
                    {
                        <div class="mt-3 p-2 bg-light border rounded text-center">
                            <img src="@Model.CoverImagePath" alt="Cover" class="img-fluid rounded shadow-sm" style="max-height: 120px;" />
                        </div>
                    }
                </div>

                <div class="card mb-4 border-0 shadow-sm" style="background-color: #f8f9fa;">
                    <div class="card-body">
                        <label class="form-label mb-3">تنظیمات انتشار</label>
                        <div class="form-check form-switch fs-5 mb-0">
                            <input class="form-check-input" type="checkbox" asp-for="IsPublished" role="switch" id="publishSwitch" style="cursor: pointer;">
                            <label class="form-check-label fs-6 mt-1 ms-2" for="publishSwitch" style="cursor: pointer;">
                                آیا این مقاله در سایت منتشر شود؟
                            </label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-submit-darabico w-100 shadow-sm mt-3"><i class="bi bi-save me-2"></i> ذخیره تغییرات</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>

    <script>
        // 💡 1. تابع استخراج آپارات (اصلاح شده برای جابجایی راحت با موس)
        function getAparatEmbedHtml(input) {
            if (!input) return '';
            input = input.trim();

            if (input.includes('<iframe') || input.includes('<div')) {
                // 🚀 اضافه شدن contenteditable="false" و mceNonEditable
                return '<div contenteditable="false" class="aparat-video-container mceNonEditable" style="position: relative; display: block; width: 100%; padding-top: 56.25%; margin: 25px 0; border-radius: 12px; overflow: hidden; background: #000; box-shadow: 0 8px 20px rgba(0,0,0,0.15); cursor: move;">' +
                       input +
                       '</div><p><br></p>';
            }

            var hash = '';
            if (input.indexOf('aparat.com/v/') !== -1) {
                hash = input.split('aparat.com/v/')[1].split('/')[0].split('?')[0].split('#')[0];
            } else if (input.indexOf('videohash/') !== -1) {
                hash = input.split('videohash/')[1].split('/')[0].split('?')[0].split('#')[0];
            } else {
                hash = input.replace(/[^a-zA-Z0-9]/g, '');
            }

            if (!hash) return '';

            // 🚀 جادوی contenteditable="false" : با این کار ویدیو تبدیل به یک بلوک قابل درگ (Drag) می‌شود
            return '<div contenteditable="false" class="aparat-video-container mceNonEditable" style="position: relative; display: block; width: 100%; padding-top: 56.25%; margin: 25px 0; border-radius: 12px; overflow: hidden; background: #000; box-shadow: 0 8px 20px rgba(0,0,0,0.15); cursor: move;">' +
                   '<iframe src="https://www.aparat.com/video/video/embed/videohash/' + hash + '/vt/frame" ' +
                   'style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; pointer-events: auto;" ' +
                   'allowFullScreen="true" webkitallowfullscreen="true" mozallowfullscreen="true"></iframe>' +
                   '</div><p><br></p>';
        }

        tinymce.init({
            selector: '#Content',
            directionality: 'rtl',
            height: 600,
            plugins: 'preview importcss searchreplace autolink autosave save directionality code visualblocks visualchars fullscreen image link media table charmap pagebreak nonbreaking anchor insertdatetime advlist lists wordcount help charmap quickbars emoticons',
            toolbar: 'undo redo | aparat | bold italic underline strikethrough | fontfamily fontsize blocks | alignleft aligncenter alignright alignjustify | outdent indent | numlist bullist | forecolor backcolor removeformat | pagebreak | charmap emoticons | fullscreen preview save print | insertfile image media template link anchor | ltr rtl | code',
            toolbar_mode: 'sliding',
            image_title: true,
            automatic_uploads: true,
            images_upload_url: '/Admin/Posts/UploadArticleImage',
            file_picker_types: 'image media',

            // 🚀 2. این گزینه حتماً باید true باشد تا ویدیوها داخل ادیتور قابلیت پخش شدن داشته باشند
            media_live_embeds: true,

            extended_valid_elements: 'iframe[*],video[*],source[*],div[*],p[*]',

            // 🚀 3. استایل‌دهی به بلوک‌های غیرقابل ویرایش تا وقتی موس روی ویدیو می‌رود، خط‌چین قرمز شود و بفهمید قابل جابجایی است
            content_style: 'body { font-family: Tahoma, Arial, sans-serif; font-size: 16px; line-height: 1.8; } .mceNonEditable { outline: 2px solid transparent; transition: outline 0.3s; cursor: move; } .mceNonEditable:hover { outline: 2px dashed #d11e32; } .aparat-video-container { position: relative; display: block; width: 100%; padding-top: 56.25%; margin: 20px 0; border-radius: 12px; overflow: hidden; background: #000; } .aparat-video-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; pointer-events: auto; }',

            setup: function (editor) {
                // دکمه اختصاصی آپارات
                editor.ui.registry.addButton('aparat', {
                    icon: 'embed',
                    tooltip: 'افزودن ویدیوی آپارات',
                    onAction: function (_) {
                        editor.windowManager.open({
                            title: 'درج ویدیوی آپارات',
                            body: {
                                type: 'panel',
                                items: [{ type: 'textarea', name: 'aparatInput', label: 'لینک ویدیو یا کد امبد آپارات را وارد کنید:' }]
                            },
                            buttons: [
                                { type: 'cancel', text: 'انصراف' },
                                { type: 'submit', text: 'تایید و قرار دادن ویدیو', primary: true }
                            ],
                            onSubmit: function (api) {
                                var data = api.getData();
                                var html = getAparatEmbedHtml(data.aparatInput);
                                if (html) {
                                    editor.insertContent(html);
                                } else {
                                    alert('لینک یا کد آپارات نامعتبر است.');
                                }
                                api.close();
                            }
                        });
                    }
                });

                editor.on('change', function () {
                    tinymce.triggerSave();
                });
            },

            // سیستم آپلود فایل مستقیم ویدیو (MP4)
            file_picker_callback: function (cb, value, meta) {
                if (meta.filetype === 'media') {
                    var input = document.createElement('input');
                    input.setAttribute('type', 'file');
                    input.setAttribute('accept', 'video/mp4,video/webm,video/ogg');

                    input.onchange = function () {
                        var file = this.files[0];
                        var formData = new FormData();
                        formData.append('file', file);

                        cb('در حال آپلود...', { title: 'لطفاً صبر کنید' });

                        fetch('/Admin/Posts/UploadArticleVideo', {
                            method: 'POST',
                            body: formData
                        })
                        .then(response => {
                            if (!response.ok) throw new Error("خطا در آپلود");
                            return response.json();
                        })
                        .then(result => {
                            // 🚀 جادوی contenteditable="false" برای ویدیوهای آپلود شده مستقیم
                            var videoHtml = '<div contenteditable="false" class="mceNonEditable" style="text-align: center; margin: 20px 0; cursor: move;">' +
                                            '<video controls="controls" style="width: 100%; max-width: 800px; height: auto; border-radius: 12px; display: block; margin: 0 auto; box-shadow: 0 4px 15px rgba(0,0,0,0.1); background:#000;">' +
                                            '<source src="' + result.location + '" type="video/mp4" />' +
                                            '</video>' +
                                            '</div><p><br></p>';
                            editor.insertContent(videoHtml);
                        })
                        .catch(error => {
                            alert('خطا در آپلود ویدیو. لطفاً حجم ویدیو را بررسی کنید.');
                        });
                    };
                    input.click();
                }
            }
        });

        // ===================================================
        // 🚀 4. رفع باگ ذخیره نشدن سوالات متداول (FAQ) در دیتابیس
        // ===================================================
        let faqCounter = document.querySelectorAll('.faq-item-row').length || 0;
        document.getElementById('btn-add-faq')?.addEventListener('click', function () {
            const wrapper = document.getElementById('faq-wrapper');
            const faqTemplate = `
                <div class="faq-item-row p-3 mb-3 position-relative" id="faq-row-${faqCounter}" style="background: #fff; border: 1px dashed #CBD5E1; border-radius: 8px;">
                    <button type="button" class="btn btn-sm btn-danger position-absolute" style="top: 10px; left: 10px; z-index: 10;" onclick="removeFaqRow(${faqCounter})"><i class="bi bi-trash3"></i> حذف</button>
                    <div class="mb-3 pr-4">
                        <label class="form-label small text-muted">پرسش متداول:</label>
                        <input type="text" class="form-control faq-question" required />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small text-muted">پاسخ کوتاه و کامل:</label>
                        <textarea class="form-control faq-answer" rows="2" required></textarea>
                    </div>
                </div>`;
            wrapper.insertAdjacentHTML('beforeend', faqTemplate);
            faqCounter++;
        });

        function removeFaqRow(id) {
            const row = document.getElementById(`faq-row-${id}`);
            if (row) row.remove();
        }

        document.querySelector('form')?.addEventListener('submit', function (e) {
            const rows = document.querySelectorAll('.faq-item-row');
            rows.forEach((row, index) => {
                // تزریق داینامیک فیلد Index برای جلوگیری از شکستن Model Binding هنگام حذف یک ردیف
                let indexInput = row.querySelector('.faq-index-hidden');
                if (!indexInput) {
                    indexInput = document.createElement('input');
                    indexInput.type = 'hidden';
                    indexInput.className = 'faq-index-hidden';
                    indexInput.name = 'Faqs.Index';
                    row.appendChild(indexInput);
                }
                indexInput.value = index;

                row.querySelector('.faq-question').setAttribute('name', `Faqs[${index}].Question`);
                row.querySelector('.faq-answer').setAttribute('name', `Faqs[${index}].Answer`);
            });
        });
    </script>
}