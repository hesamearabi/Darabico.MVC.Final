@model final_p_01.Domain.Entities.Post

@{
    ViewData["Title"] = "نوشتن مقاله جدید";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --brand-navy: #121D35;
        --brand-gold: #C5A66B;
        --brand-bg: #f8fafc;
        --border-color: #e2e8f0;
    }

    .darabico-form-card {
        background: #fff;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(18, 29, 53, 0.05);
        border: 1px solid var(--border-color);
    }

    .form-label {
        font-weight: 800;
        color: var(--brand-navy);
        font-size: 0.95rem;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-hint {
        font-weight: 400;
        color: #94a3b8;
        font-size: 0.8rem;
    }

    .form-control, .form-select {
        border-radius: 12px;
        border: 2px solid var(--border-color);
        padding: 14px 18px;
        font-size: 0.95rem;
        transition: all 0.3s;
        background-color: #fcfcfc;
    }

        .form-control:focus, .form-select:focus {
            border-color: var(--brand-gold);
            background-color: #fff;
            box-shadow: 0 0 0 4px rgba(197, 166, 107, 0.15);
        }

    .image-upload-box {
        border: 2px dashed #cbd5e1;
        border-radius: 16px;
        padding: 4px;
        height: 220px;
        text-align: center;
        background: #f8fafc;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
    }

        .image-upload-box:hover {
            border-color: var(--brand-gold);
            background: #fff;
            box-shadow: 0 10px 25px rgba(197, 166, 107, 0.1);
        }

        .image-upload-box img#previewImg {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 12px;
            display: none;
        }

    .upload-content {
        pointer-events: none;
    }

    .btn-submit-darabico {
        background: var(--brand-navy);
        color: #fff;
        padding: 16px 30px;
        border-radius: 14px;
        font-weight: 800;
        font-size: 1.1rem;
        border: none;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        .btn-submit-darabico:hover {
            background: var(--brand-gold);
            color: var(--brand-navy);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(197, 166, 107, 0.3);
        }

    .faq-card {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 25px;
        margin-bottom: 20px;
        position: relative;
        transition: 0.3s;
    }

        .faq-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
        }

    .btn-remove-faq {
        position: absolute;
        top: -12px;
        left: -12px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #ef4444;
        color: #fff;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.3s;
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3);
    }

        .btn-remove-faq:hover {
            background: #dc2626;
            transform: scale(1.1);
        }

    .form-switch .form-check-input {
        width: 3rem;
        height: 1.5rem;
        cursor: pointer;
    }

        .form-switch .form-check-input:checked {
            background-color: var(--brand-gold);
            border-color: var(--brand-gold);
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold" style="color: var(--brand-navy);">نوشتن مقاله جدید</h1>
    <a asp-action="Index" class="btn btn-light border fw-bold text-secondary rounded-pill px-4">
        <i class="bi bi-arrow-right me-2"></i> بازگشت به لیست
    </a>
</div>

<div class="darabico-form-card">
    <div asp-validation-summary="All" class="alert alert-danger p-3 mb-4 rounded-3 border-0 shadow-sm" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <form asp-action="Create" enctype="multipart/form-data" method="post" id="postForm">
        @Html.AntiForgeryToken()

        <div class="row g-5">
            <div class="col-lg-8">
                <div class="mb-4">
                    <label asp-for="Title" class="form-label">عنوان مقاله <span class="form-hint">حداکثر ۶۰ کاراکتر (SEO)</span></label>
                    <input asp-for="Title" class="form-control" placeholder="مثلاً: راهنمای صفر تا صد ساخت زمین پدل..." maxlength="70" required />
                </div>

                <div class="mb-4">
                    <label asp-for="Slug" class="form-label">اسلاگ (URL) <span class="form-hint">انگلیسی یا فینگلیش با خط تیره</span></label>
                    <input asp-for="Slug" class="form-control" placeholder="padel-court-guide" style="direction: ltr; text-align: left;" />
                </div>

                <div class="mb-5">
                    <label asp-for="Content" class="form-label">متن اصلی مقاله <span class="form-hint">از H2 تا H4 استفاده کنید و برای تصاویر Alt بنویسید</span></label>
                    <textarea asp-for="Content" id="Content" class="form-control" rows="15"></textarea>
                </div>

                <div class="p-4 rounded-4" style="background: #f8fafc; border: 2px dashed var(--border-color);">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="mb-0 fw-bold" style="color: var(--brand-navy);">
                            <i class="bi bi-patch-question-fill fs-4 align-middle me-2" style="color: var(--brand-gold);"></i>
                            سوالات متداول (FAQ Schema)
                        </h5>
                        <button type="button" id="btn-add-faq" class="btn btn-outline-dark fw-bold rounded-pill px-3">
                            <i class="bi bi-plus-lg me-1"></i> افزودن پرسش
                        </button>
                    </div>
                    <div id="faq-wrapper"></div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="mb-4">
                    <label asp-for="CategoryId" class="form-label">دسته‌بندی</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required>
                        <option value="" disabled selected>انتخاب کنید...</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="ParentPostId" class="form-label">مقاله والد (راهنمای جامع 0 تا 100)</label>
                    <select asp-for="ParentPostId" class="form-select" asp-items="ViewBag.ParentPostId">
                        <option value="">مقاله مستقل (بدون والد)</option>
                    </select>
                    <small class="form-text text-muted">با انتخاب راهنمای جامع، این مقاله به‌عنوان فصل کلارستر در منوی اصلی و صفحه راهنما نمایش داده می‌شود.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label">عکس کاور مقاله</label>
                    <div class="image-upload-box" onclick="document.getElementById('coverImage').click()">
                        <img id="previewImg" alt="پیش‌نمایش کاور" />
                        <div class="upload-content" id="uploadContent">
                            <i class="bi bi-image fs-1 d-block mb-2" style="color: var(--brand-gold);"></i>
                            <span class="fw-bold d-block" style="color: var(--brand-navy);">آپلود تصویر</span>
                            <span class="text-muted small">فرمت‌های مجاز: JPG, PNG, WEBP</span>
                        </div>
                        <input type="file" name="coverImage" id="coverImage" class="d-none" accept="image/*" onchange="previewFile(this);" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="CoverImageAlt" class="form-label">توضیح عکس (Alt) <span class="form-hint">برای سئو بسیار مهم</span></label>
                    <input asp-for="CoverImageAlt" class="form-control" placeholder="توضیح کوتاه درباره عکس کاور..." />
                </div>

                <div class="mb-4 p-3 rounded-4" style="border: 1px solid var(--border-color); background: #f8fafc;">
                    <label class="form-label text-success mb-3 border-bottom pb-2">
                        <i class="bi bi-file-earmark-pdf-fill me-2"></i> باکس دانلود فایل (PDF/Zip)
                    </label>

                    <div class="mb-3">
                        <label class="form-label small text-muted">عنوان دانلود (مثال: کاتالوگ شیشه‌های پدل)</label>
                        <input asp-for="AttachmentTitle" class="form-control" placeholder="دانلود فایل ضمیمه مقاله" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">توضیح کوتاه (اختیاری)</label>
                        <textarea asp-for="AttachmentDescription" class="form-control" rows="2" placeholder="برای دریافت اطلاعات کامل فنی فایل زیر را دریافت کنید..."></textarea>
                    </div>

                    <label class="form-label small text-muted mt-2">فایل آپلودی:</label>
                    <input type="file" name="attachmentFile" class="form-control mb-1" accept=".pdf,.zip,.rar,.doc,.docx" />
                    <span class="form-hint d-block text-muted" style="font-size:0.75rem;">فرمت‌های مجاز: PDF, ZIP (حداکثر ۵۰ مگابایت)</span>
                </div>

                <div class="mb-4 p-3 rounded-3" style="border: 1px solid var(--border-color); background: #f8fafc;">
                    <label class="form-label text-primary">
                        <i class="bi bi-mic-fill me-2"></i> فایل صوتی پادکست
                    </label>
                    <input type="file" name="audioFile" class="form-control mb-2" accept="audio/*" />
                    <span class="form-hint d-block text-muted" style="font-size:0.75rem;">فرمت‌های مجاز: MP3, OGG (حداکثر ۲۰ مگابایت)</span>
                </div>

                <div class="mb-4">
                    <label asp-for="MetaDescription" class="form-label">توضیحات سئو (Meta Description) <span class="form-hint">حداکثر ۱۶۰ کاراکتر</span></label>
                    <textarea asp-for="MetaDescription" class="form-control" rows="5" maxlength="160" placeholder="این متن در نتایج گوگل زیر عنوان مقاله نمایش داده می‌شود..."></textarea>
                </div>

                <div class="card border-0 rounded-4 p-4 mb-4" style="background: #eff6ff;">
                    <div class="form-check form-switch d-flex align-items-center gap-3 m-0 p-0">
                        <input class="form-check-input m-0" type="checkbox" asp-for="IsPublished" role="switch" id="publishSwitch" value="true" checked>
                        <label class="form-check-label fw-bold" for="publishSwitch" style="color: var(--brand-navy); cursor: pointer;">
                            انتشار فوری در سایت
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn-submit-darabico w-100 shadow-sm mt-2">
                    <i class="bi bi-rocket-takeoff-fill fs-5"></i> ذخیره و انتشار مقاله
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>

    <script>
        function previewFile(input) {
            var file = input.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('previewImg').src = e.target.result;
                    document.getElementById('previewImg').style.display = 'block';
                    document.getElementById('uploadContent').style.display = 'none';
                }
                reader.readAsDataURL(file);
            }
        }

        function processVideoLink(url, forceVertical) {
            if (!url) return null;
            url = url.trim();

            var isShorts = forceVertical || false;
            var hash = '';
            var platform = '';

            var ytMatch = url.match(/(?:youtube\.com\/shorts\/|youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]+)/i);
            if (ytMatch) {
                hash = ytMatch[1];
                platform = 'youtube';
                if (url.includes('/shorts/')) isShorts = true;
            }

            var apMatch = url.match(/aparat\.com\/(?:v|shorts|video\/video\/embed\/videohash)\/([a-zA-Z0-9_-]+)/i);
            if (apMatch) {
                hash = apMatch[1];
                platform = 'aparat';
                if (url.includes('/shorts/')) isShorts = true;
            }

            if (!hash) return null;

            var aspect = isShorts ? '9/16' : '16/9';
            var wrapperClass = isShorts ? 'video-shorts-wrapper' : 'video-normal-wrapper';
            var style = isShorts
                ? 'width:100%; max-width:350px; margin: 2.5rem auto; display:block;'
                : 'width:100%; margin: 2.5rem 0; display:block;';

            if (platform === 'aparat' && isShorts && /^\d+$/.test(hash)) {
                return `
                <div class="mceNonEditable" style="${style} background: linear-gradient(135deg, #1e293b, #0f172a); border: 2px solid #cbd5e1; border-radius: 20px; text-align: center; font-family: Tahoma; padding: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); height: 500px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                    <div style="width: 70px; height: 70px; background: #ea1d5d; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                        <span style="color: white; font-size: 30px;">▶</span>
                    </div>
                    <div style="font-size: 16px; color: #fff; font-weight: bold; margin-bottom: 10px;">آپارات شورتز (کارت هوشمند)</div>
                    <div style="font-size: 12px; color: #94a3b8; margin-bottom: 20px;">به دلیل قفل امنیتی آپارات، این ویدیو در سایت به صورت یک کارت پخش زیبا نمایش داده می‌شود تا کاربر آن را در آپارات ببیند.</div>
                    <span style="background: white; color: #ea1d5d; padding: 8px 20px; border-radius: 50px; font-weight: bold; font-size: 13px;">کد ویدیو: ${hash}</span>
                </div><p><br></p>`;
            }

            var iframeSrc = platform === 'youtube'
                ? 'https://www.youtube.com/embed/' + hash
                : 'https://www.aparat.com/video/video/embed/videohash/' + hash + '/vt/frame';

            return `<div class="${wrapperClass} mceNonEditable" style="${style}"><iframe src="${iframeSrc}" style="width:100%; aspect-ratio: ${aspect}; border-radius: 16px; border:none; background:#000;" allowfullscreen></iframe></div><p><br></p>`;
        }

        tinymce.init({
            selector: '#Content',
            directionality: 'rtl',
            height: 600,
            relative_urls: false,
            remove_script_host: true,
            document_base_url: '/',
            block_formats: 'پاراگراف=p; تیتر ۲ (بخش اصلی)=h2; تیتر ۳ (زیربخش)=h3; تیتر ۴=h4',
            plugins: 'preview importcss searchreplace autolink autosave save directionality code visualblocks visualchars fullscreen image link media table charmap pagebreak nonbreaking anchor insertdatetime advlist lists wordcount help charmap quickbars emoticons',
            toolbar: 'undo redo | smartmedia custompdf | bold italic underline strikethrough | fontfamily fontsize blocks | alignleft aligncenter alignright alignjustify | outdent indent | numlist bullist | forecolor backcolor removeformat | image link | code preview fullscreen',
            toolbar_mode: 'sliding',
            image_title: true,
            image_description: true,
            image_dimensions: true,
            a11y_advanced_options: true,
            media_live_embeds: false,
            extended_valid_elements: 'iframe[*],video[*],source[*],div[*],p[*],a[*]',
            content_style: 'body { font-family: Tahoma, Arial, sans-serif; font-size: 16px; line-height: 1.8; }',

            rel_list: [
                { title: 'معمولی (Dofollow)', value: '' },
                { title: 'نوفالو (Nofollow - عدم انتقال اعتبار سئو)', value: 'nofollow' },
                { title: 'رپورتاژ/تبلیغ (Sponsored)', value: 'sponsored' }
            ],
            target_list: [
                { title: 'باز شدن در همین صفحه', value: '' },
                { title: 'باز شدن در صفحه جدید (تب جدید)', value: '_blank' }
            ],

            paste_preprocess: function (plugin, args) {
                var url = args.content.trim();
                var html = processVideoLink(url, false);
                if (html) {
                    args.content = html;
                    return;
                }
                args.content = args.content.replace(/<(\/?)h1(\b[^>]*)>/gi, '<$1h2$2>');
            },

            setup: function (editor) {
                editor.ui.registry.addButton('smartmedia', {
                    icon: 'embed',
                    tooltip: 'افزودن ویدیوی آپارات یا یوتیوب',
                    onAction: function (_) {
                        editor.windowManager.open({
                            title: 'درج ویدیو از آپارات یا یوتیوب',
                            body: {
                                type: 'panel',
                                items: [
                                    { type: 'textarea', name: 'videoUrl', label: 'لینک ویدیو را کپی کرده و اینجا قرار دهید:' },
                                    { type: 'checkbox', name: 'isVertical', label: '📱 این یک ویدیوی شورتز (عمودی ۹:۱۶) است' }
                                ]
                            },
                            buttons: [
                                { type: 'cancel', text: 'انصراف' },
                                { type: 'submit', text: 'تایید و درج ویدیو', primary: true }
                            ],
                            onSubmit: function (api) {
                                var data = api.getData();
                                var html = processVideoLink(data.videoUrl, data.isVertical);
                                if (html) {
                                    editor.insertContent(html);
                                } else {
                                    alert('لینک وارد شده نامعتبر است! فقط لینک آپارات یا یوتیوب پشتیبانی می‌شود.');
                                }
                                api.close();
                            }
                        });
                    }
                });

                editor.ui.registry.addButton('custompdf', {
                    icon: 'document-properties',
                    tooltip: 'افزودن لینک دانلود فایل به متن مقاله',
                    onAction: function (_) {
                        editor.windowManager.open({
                            title: 'درج لینک دانلود فایل در متن',
                            body: {
                                type: 'panel',
                                items: [
                                    { type: 'input', name: 'btnText', label: 'متن دکمه (مثال: دانلود کاتالوگ)' },
                                    { type: 'input', name: 'btnUrl', label: 'لینک دانلود فایل' }
                                ]
                            },
                            buttons: [
                                { type: 'cancel', text: 'انصراف' },
                                { type: 'submit', text: 'درج در مقاله', primary: true }
                            ],
                            onSubmit: function (api) {
                                var data = api.getData();
                                if (!data.btnText || !data.btnUrl) {
                                    alert('لطفا متن دکمه و لینک دانلود را وارد کنید.');
                                    return;
                                }
                                var html = `<div style="text-align: center; margin: 2rem 0;"><a href="${data.btnUrl}" download class="pdf-btn" style="display: inline-block; background: #0056b3; color: #fff; padding: 12px 28px; border-radius: 50px; font-weight: bold; text-decoration: none;">📥 ${data.btnText}</a></div><p><br></p>`;
                                editor.insertContent(html);
                                api.close();
                            }
                        });
                    }
                });

                editor.on('change', function () { tinymce.triggerSave(); });
            },
            images_upload_handler: function (blobInfo, progress) {
                return new Promise((resolve, reject) => {
                    const xhr = new XMLHttpRequest();
                    xhr.open('POST', '/Admin/Posts/UploadArticleImage');
                    const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tokenElement) xhr.setRequestHeader('RequestVerificationToken', tokenElement.value);
                    xhr.upload.onprogress = (e) => { progress(e.loaded / e.total * 100); };
                    xhr.onload = () => {
                        if (xhr.status < 200 || xhr.status >= 300) { reject('HTTP Error: ' + xhr.status); return; }
                        const json = JSON.parse(xhr.responseText);
                        resolve(json.location);
                    };
                    xhr.onerror = () => { reject('Image upload failed.'); };
                    const formData = new FormData();
                    formData.append('upload', blobInfo.blob(), blobInfo.filename());
                    xhr.send(formData);
                });
            }
        });

        document.getElementById('postForm')?.addEventListener('submit', function (e) {
            if (typeof tinymce !== 'undefined') {
                tinymce.triggerSave();
                const editor = tinymce.get('Content');
                if (editor) {
                    const doc = new DOMParser().parseFromString(editor.getContent(), 'text/html');
                    const missingAlt = Array.from(doc.querySelectorAll('img')).filter(img => !img.hasAttribute('alt'));
                    if (missingAlt.length > 0) {
                        const proceed = confirm(`تعداد ${missingAlt.length} تصویر داخل متن فاقد توضیح Alt است (برای تصاویر تزئینی می‌توانید تیک «Image is decorative» را بزنید). آیا مایل به ادامه ذخیره هستید؟`);
                        if (!proceed) {
                            e.preventDefault();
                        }
                    }
                }
            }
        });

        let faqCounter = 0;
        document.getElementById('btn-add-faq')?.addEventListener('click', function () {
            const wrapper = document.getElementById('faq-wrapper');
            const faqTemplate = `
                <div class="faq-card" id="faq-row-${faqCounter}">
                    <button type="button" class="btn-remove-faq" title="حذف این پرسش" onclick="removeFaqRow(${faqCounter})"><i class="bi bi-x-lg"></i></button>
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">پرسش متداول:</label>
                        <input type="text" class="form-control" name="Faqs[${faqCounter}].Question" required />
                    </div>
                    <div class="mb-0">
                        <label class="form-label text-muted small mb-1">پاسخ کوتاه و کامل:</label>
                        <textarea class="form-control" name="Faqs[${faqCounter}].Answer" rows="2" required></textarea>
                    </div>
                </div>`;
            wrapper.insertAdjacentHTML('beforeend', faqTemplate);
            faqCounter++;
        });

        function removeFaqRow(id) {
            const row = document.getElementById(`faq-row-${id}`);
            if (row) row.remove();

            const rows = document.querySelectorAll('.faq-card');
            rows.forEach((r, idx) => {
                r.querySelector('input[type="text"]').setAttribute('name', `Faqs[${idx}].Question`);
                r.querySelector('textarea').setAttribute('name', `Faqs[${idx}].Answer`);
            });
            faqCounter = rows.length;
        }
    </script>
}