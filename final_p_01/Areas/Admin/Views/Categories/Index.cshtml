@model IEnumerable<final_p_01.Domain.Entities.Category>
@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger fw-bold shadow-sm rounded-3 mt-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>مدیریت دسته‌بندی‌ها</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> دسته‌بندی جدید</a>
</div>

<table class="table table-bordered table-striped text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>نام دسته‌بندی</th>
            <th>اسلاگ سئو (Slug)</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td dir="ltr">@item.Slug</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i> ویرایش</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('آیا از حذف این دسته‌بندی مطمئن هستید؟');">
                        <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>