@model final_p_01.Domain.Entities.Category

@{
    ViewData["Title"] = "ویرایش دسته‌بندی";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 fw-bold" style="color: #121D35;"><i class="bi bi-pencil-square me-2"></i> ویرایش دسته‌بندی: @Model.Name</h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">بازگشت به لیست</a>
</div>

<div class="card border-0 shadow-sm p-4" style="border-radius: 16px; max-width: 600px; margin: 0 auto;">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-4">
            <label asp-for="Name" class="form-label fw-bold">نام دسته‌بندی</label>
            <input asp-for="Name" class="form-control" style="border-radius: 8px; padding: 12px;" required />
        </div>

        <div class="mb-5">
            <label asp-for="Slug" class="form-label fw-bold">اسلاگ (URL)</label>
            <input asp-for="Slug" class="form-control" style="direction: ltr; border-radius: 8px; padding: 12px;" required />
        </div>

        <button type="submit" class="btn w-100 fw-bold" style="background: #121D35; color: #fff; padding: 12px; border-radius: 8px;">
            ذخیره تغییرات
        </button>
    </form>
</div>