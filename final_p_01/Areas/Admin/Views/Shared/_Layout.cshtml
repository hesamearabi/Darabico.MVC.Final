@{
    var currentPath = Context.Request.Path.Value ?? "";
    var navigation = new (string Path, string Title, string Icon)[] {
        ("/admin/leads", "درخواست‌ها و پیگیری", "inbox"),
        ("/admin/inquiry-settings", "تنظیمات استعلام", "sliders"),
        ("/Admin/Projects", "پروژه‌ها", "grid"),
        ("/Admin/Posts", "مقالات", "journal-text"),
        ("/Admin/Categories", "دسته‌بندی‌ها", "folder"),
        ("/admin/pillar-pages", "راهنماهای جامع", "book"),
        ("/admin/city-pages", "صفحات شهرها", "geo-alt"),
        ("/admin/process-stages", "مراحل اجرا", "list-check"),
        ("/admin/documents", "کاتالوگ و دیتاشیت", "file-earmark-text"),
        ("/admin/booking-slots", "زمان‌های بازدید", "calendar3"),
        ("/admin/faqs", "پرسش‌های متداول", "question-circle"),
        ("/admin/estimator-settings", "تنظیمات برآورد هزینه", "calculator"),
        ("/admin/site-settings", "تنظیمات سایت", "gear"),
        ("/Admin/Settings", "امنیت حساب", "shield-lock")
    };
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>@ViewData["Title"] · دارابیکو</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
</head>
<body class="workspace admin-workspace">
    <a class="workspace-skip" href="#main-content">رفتن به محتوای اصلی</a>
    <aside class="workspace-sidebar" id="admin-navigation" aria-label="منوی مدیریت">
        <a href="/admin/leads" class="workspace-brand"><span class="workspace-mark">د</span><span>دارابیکو<small>پنل مدیریت</small></span></a>
        <p class="workspace-eyebrow">فضای کاری شما</p>
        <nav aria-label="بخش‌های مدیریت">
            @foreach (var item in navigation)
            {
                var active = currentPath.StartsWith(item.Path, StringComparison.OrdinalIgnoreCase);
                <a href="@item.Path" class="workspace-nav-link @(active ? "is-active" : "")" aria-current="@(active ? "page" : null)"><i class="bi bi-@item.Icon" aria-hidden="true"></i>@item.Title</a>
            }
        </nav>
        <a class="workspace-nav-link workspace-site-link" href="/" target="_blank" rel="noopener"><i class="bi bi-arrow-up-left" aria-hidden="true"></i>مشاهده سایت</a>
    </aside>
    <button class="workspace-backdrop" type="button" aria-label="بستن منوی مدیریت" tabindex="-1" hidden></button>
    <div class="workspace-main">
        <header class="workspace-topbar">
            <button type="button" class="workspace-menu btn" aria-controls="admin-navigation" aria-expanded="false"><i class="bi bi-list" aria-hidden="true"></i><span>منو</span></button>
            <div><p class="workspace-eyebrow">پنل مدیریت دارابیکو</p><span>@ViewData["Title"]</span></div>
            <form asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-secondary" type="submit">خروج</button></form>
        </header>
        <main id="main-content" class="workspace-content" tabindex="-1">
            @if (TempData["Success"] is string success)
            {
                <div class="workspace-alert workspace-alert--success" role="status">@success</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="workspace-alert workspace-alert--error" role="alert">@error</div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="workspace-alert workspace-alert--error" role="alert" tabindex="-1" data-validation-alert><strong>اطلاعات نیاز به اصلاح دارد</strong><div asp-validation-summary="All"></div></div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/workspace.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
