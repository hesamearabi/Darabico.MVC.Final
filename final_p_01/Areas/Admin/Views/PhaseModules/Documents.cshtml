@model IEnumerable<final_p_01.Domain.Entities.DocumentItem>
@{
    ViewData["Title"] = "کاتالوگ و دیتاشیت‌ها";
}
<div class="container py-4" dir="rtl">
    <h1>کاتالوگ و دیتاشیت‌ها</h1>
    <table class="table">
        <thead><tr><th>عنوان</th><th>مسیر فایل</th><th>دسته</th><th>وضعیت</th><th></th></tr></thead>
        <tbody>
        @foreach (var document in Model)
        {
            <tr>
                <td>@document.Title</td>
                <td><code dir="ltr">@document.FilePath</code></td>
                <td>@document.Category</td>
                <td>@(document.IsPublished ? "منتشرشده" : "پیش‌نویس")</td>
                <td>
                    <form method="post" asp-action="ToggleDocument" asp-route-id="@document.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-secondary">تغییر وضعیت</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <h2 class="mt-4">مورد جدید</h2>
    <form method="post" asp-action="CreateDocument" class="row g-2">
        @Html.AntiForgeryToken()
        <div class="col-md-3"><input name="Title" class="form-control" placeholder="عنوان" required /></div>
        <div class="col-md-3"><input name="FilePath" class="form-control" dir="ltr" placeholder="/files/catalog.pdf" required /></div>
        <div class="col-md-2"><input name="Category" class="form-control" placeholder="دسته" /></div>
        <div class="col-md-2"><input name="SortOrder" type="number" class="form-control" placeholder="ترتیب" /></div>
        <div class="col-md-2"><button class="btn btn-outline-primary">افزودن</button></div>
    </form>
</div>
