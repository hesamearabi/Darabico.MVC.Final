@model IEnumerable<final_p_01.Domain.Entities.ProcessStage>
@{
    ViewData["Title"] = "مراحل فرایند اجرا";
}
<div class="container py-4" dir="rtl">
    <h1>مراحل فرایند اجرا</h1>
    <table class="table">
        <thead><tr><th>شماره</th><th>عنوان</th><th>مدت</th><th>وضعیت</th><th></th></tr></thead>
        <tbody>
        @foreach (var stage in Model)
        {
            <tr>
                <td>@stage.StepNumber</td>
                <td>@stage.Title</td>
                <td>@stage.EstimatedDuration</td>
                <td>@(stage.IsActive ? "فعال" : "غیرفعال")</td>
                <td>
                    <form method="post" asp-action="ToggleProcessStage" asp-route-id="@stage.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-secondary">تغییر وضعیت</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <h2 class="mt-4">مرحله جدید</h2>
    <form method="post" asp-action="CreateProcessStage" class="row g-2">
        @Html.AntiForgeryToken()
        <div class="col-md-4"><label for="Title">عنوان مرحله</label>@Html.TextBox("Title", null, new { @class = "form-control", required = "required" })</div>
        <div class="col-md-6"><label for="Description">توضیحات اجرا</label>@Html.TextArea("Description", null, new { @class = "form-control", required = "required" })</div>
        <div class="col-md-2"><label for="EstimatedDuration">مدت تقریبی</label>@Html.TextBox("EstimatedDuration", null, new { @class = "form-control", placeholder = "مثلا ۲ هفته" })</div>
        <div class="col-md-2"><label for="StepNumber">شماره مرحله</label>@Html.TextBox("StepNumber", null, new { @class = "form-control", type = "number" })</div>
        <div class="col-md-2"><label for="SortOrder">ترتیب نمایش</label>@Html.TextBox("SortOrder", null, new { @class = "form-control", type = "number" })</div>
        <div class="col-md-2"><button class="btn btn-outline-primary">افزودن</button></div>
    </form>
</div>
