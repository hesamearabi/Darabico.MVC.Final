@model final_p_01.Domain.Entities.CityPage
@{
    ViewData["Title"] = "صفحه شهر جدید";
}
<div class="container py-4" dir="rtl">
    <h1>صفحه شهر جدید</h1>
    <form method="post" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-md-4"><label class="form-label">نام شهر</label><input asp-for="CityName" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label">نامک (Slug)</label><input asp-for="Slug" class="form-control" dir="ltr" required /></div>
        <div class="col-md-4"><label class="form-label">عنوان صفحه</label><input asp-for="Title" class="form-control" required /></div>
        <div class="col-12"><label class="form-label">محتوای HTML</label><textarea asp-for="ContentHtml" rows="10" class="form-control" dir="ltr"></textarea></div>
        <div class="col-md-6"><label class="form-label">Meta Title</label><input asp-for="MetaTitle" class="form-control" dir="ltr" /></div>
        <div class="col-md-6"><label class="form-label">Meta Description</label><input asp-for="MetaDescription" class="form-control" dir="ltr" /></div>
        <div class="col-md-6"><label class="form-label">Canonical</label><input asp-for="Canonical" class="form-control" dir="ltr" /></div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="IsPublished" class="form-check-input" />
                <label asp-for="IsPublished" class="form-check-label">منتشرشده</label>
            </div>
        </div>
        <div class="col-12"><button class="btn btn-primary">ذخیره</button></div>
    </form>
</div>
