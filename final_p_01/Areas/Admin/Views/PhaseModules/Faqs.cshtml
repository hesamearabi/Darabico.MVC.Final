@model IEnumerable<final_p_01.Domain.Entities.Faq>
@{
    ViewData["Title"] = "مدیریت سوالات متداول";
}
<div class="container py-4" dir="rtl">
    <h1>سوالات متداول</h1>
    <table class="table">
        <thead><tr><th>سوال</th><th>صفحه</th><th>ترتیب</th><th></th></tr></thead>
        <tbody>
        @foreach (var faq in Model)
        {
            <tr>
                <td>@faq.Question</td>
                <td><code>@(faq.PageKey ?? $"post:{faq.PostId}")</code></td>
                <td>@faq.SortOrder</td>
                <td>
                    <form method="post" asp-action="DeleteFaq" asp-route-id="@faq.Id" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-outline-danger">حذف</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <h2 class="mt-4">سوال جدید</h2>
    <form method="post" asp-action="CreateFaq" class="row g-2">
        @Html.AntiForgeryToken()
        <div class="col-md-4"><label for="Question">متن پرسش</label>@Html.TextBox("Question", null, new { @class = "form-control", required = "required" })</div>
        <div class="col-md-5"><label for="Answer">پاسخ</label>@Html.TextArea("Answer", null, new { @class = "form-control", required = "required" })</div>
        <div class="col-md-2"><label for="pageKey">کلید صفحه (اختیاری)</label>@Html.TextBox("pageKey", null, new { @class = "form-control", dir = "ltr", placeholder = "pillar:slug" })</div>
        <div class="col-md-1"><label for="SortOrder">ترتیب</label>@Html.TextBox("SortOrder", null, new { @class = "form-control", type = "number" })</div>
        <div class="col-12"><button class="btn btn-outline-primary">افزودن</button></div>
    </form>
</div>
