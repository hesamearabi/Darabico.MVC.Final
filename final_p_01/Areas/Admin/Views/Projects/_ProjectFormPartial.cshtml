@using Darabico.Domain.Enums
@model Darabico.Web.Areas.Admin.ViewModels.ProjectFormViewModel

<div asp-validation-summary="ModelOnly" class="validation-box"></div>

<div class="form-grid">
    <div class="form-field">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-input" />
        <span asp-validation-for="Title" class="field-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Slug"></label>
        <input asp-for="Slug" class="form-input" placeholder="در صورت خالی بودن از عنوان ساخته می‌شود" />
        <span asp-validation-for="Slug" class="field-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="City"></label>
        <input asp-for="City" class="form-input" />
        <span asp-validation-for="City" class="field-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="CourtCount"></label>
        <input asp-for="CourtCount" type="number" min="1" class="form-input" />
        <span asp-validation-for="CourtCount" class="field-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="CourtType"></label>
        <select asp-for="CourtType" asp-items="Html.GetEnumSelectList<CourtType>()" class="form-input"></select>
        <span asp-validation-for="CourtType" class="field-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="ExecutionYear"></label>
        <input asp-for="ExecutionYear" type="number" class="form-input" />
        <span asp-validation-for="ExecutionYear" class="field-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="ExecutionDurationMonths"></label>
        <input asp-for="ExecutionDurationMonths" type="number" min="1" class="form-input" />
        <span asp-validation-for="ExecutionDurationMonths" class="field-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="DisplayOrder"></label>
        <input asp-for="DisplayOrder" type="number" class="form-input" />
    </div>
</div>

<div class="form-field full-width">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" id="richDescription" rows="10" class="form-input"></textarea>
    <span asp-validation-for="Description" class="field-error"></span>
</div>

<fieldset class="media-fieldset">
    <legend>رسانه‌ها و تصاویر پروژه (تبدیل خودکار به WebP)</legend>

    <div class="form-grid">
        <div class="form-field">
            <label asp-for="FeaturedImageFile"></label>
            <input asp-for="FeaturedImageFile" type="file" accept="image/*" class="form-input" />
            <span asp-validation-for="FeaturedImageFile" class="field-error"></span>
            @if (!string.IsNullOrEmpty(Model.ExistingThumbnailUrl))
            {
                <img src="@Model.ExistingThumbnailUrl" alt="تصویر شاخص فعلی" width="150" height="100" loading="lazy" class="preview-img" />
            }
        </div>

        <div class="form-field">
            <label asp-for="FeaturedImageAlt"></label>
            <input asp-for="FeaturedImageAlt" class="form-input" placeholder="متن جایگزین تصویر شاخص (برای سئو)" />
            <span asp-validation-for="FeaturedImageAlt" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="VideoFile"></label>
            <input asp-for="VideoFile" type="file" accept="video/mp4,video/webm" class="form-input" />
            <label asp-for="VideoUrl" class="sub-label"></label>
            <input asp-for="VideoUrl" class="form-input" placeholder="/uploads/projects/videos/... یا لینک مستقیم" />
            @if (!string.IsNullOrEmpty(Model.VideoUrl))
            {
                <label class="checkbox-label">
                    <input asp-for="RemoveVideo" /> حذف ویدیو فعلی
                </label>
            }
        </div>

        <div class="form-field">
            <label asp-for="BeforeImageFile"></label>
            <input asp-for="BeforeImageFile" type="file" accept="image/*" class="form-input" />
            @if (!string.IsNullOrEmpty(Model.ExistingBeforeImageUrl))
            {
                <img src="@Model.ExistingBeforeImageUrl" alt="تصویر قبل" width="150" height="100" loading="lazy" class="preview-img" />
                <label class="checkbox-label">
                    <input asp-for="RemoveBeforeImage" /> حذف تصویر قبل
                </label>
            }
        </div>

        <div class="form-field">
            <label asp-for="AfterImageFile"></label>
            <input asp-for="AfterImageFile" type="file" accept="image/*" class="form-input" />
            @if (!string.IsNullOrEmpty(Model.ExistingAfterImageUrl))
            {
                <img src="@Model.ExistingAfterImageUrl" alt="تصویر بعد" width="150" height="100" loading="lazy" class="preview-img" />
                <label class="checkbox-label">
                    <input asp-for="RemoveAfterImage" /> حذف تصویر بعد
                </label>
            }
        </div>
    </div>
</fieldset>

<fieldset class="media-fieldset">
    <legend>فایل صوتی پادکست (اختیاری - MP3/OGG حداکثر ۲۰ مگابایت)</legend>
    <div class="form-field">
        <label asp-for="AudioFile"></label>
        <input asp-for="AudioFile" type="file" accept="audio/mpeg,audio/ogg,.mp3,.ogg" class="form-input" />
        @if (!string.IsNullOrEmpty(Model.ExistingAudioUrl))
        {
            <audio controls preload="none" src="@Model.ExistingAudioUrl" style="margin-top:.5rem; max-width:100%;"></audio>
            <label class="checkbox-label">
                <input asp-for="RemoveAudio" /> حذف فایل صوتی فعلی
            </label>
        }
    </div>
</fieldset>

<fieldset class="media-fieldset">
    <legend>باکس دانلود فایل (اختیاری - PDF/ZIP حداکثر ۵۰ مگابایت)</legend>
    <div class="form-grid">
        <div class="form-field">
            <label asp-for="AttachmentTitle"></label>
            <input asp-for="AttachmentTitle" class="form-input" placeholder="مثال: کاتالوگ کامل پروژه" />
        </div>
        <div class="form-field">
            <label asp-for="AttachmentDescription"></label>
            <input asp-for="AttachmentDescription" class="form-input" placeholder="توضیح کوتاه اختیاری" />
        </div>
    </div>
    <div class="form-field">
        <label asp-for="AttachmentFile"></label>
        <input asp-for="AttachmentFile" type="file" accept="application/pdf,application/zip,.pdf,.zip" class="form-input" />
        @if (!string.IsNullOrEmpty(Model.ExistingAttachmentUrl))
        {
            <p style="margin:.4rem 0 0; font-size:.85rem;">فایل فعلی: <a href="@Model.ExistingAttachmentUrl" target="_blank" rel="noopener">@Model.ExistingAttachmentUrl</a></p>
            <label class="checkbox-label">
                <input asp-for="RemoveAttachment" /> حذف فایل فعلی
            </label>
        }
    </div>
</fieldset>

<fieldset class="media-fieldset">
    <legend>سوالات متداول (FAQ Schema)</legend>
    <div id="faqContainer">
        @for (int i = 0; i < (Model.Faqs?.Count ?? 0); i++)
        {
            var faq = Model.Faqs![i];
            <div class="faq-admin-row" style="border:1px solid #e2e8f0; border-radius:10px; padding: .75rem; margin-bottom:.75rem; background:#f8fafc;">
                <input type="text" name="Faqs[@i].Question" value="@faq.Question" placeholder="سوال" class="form-input" style="width:100%; margin-bottom:.5rem;" />
                <textarea name="Faqs[@i].Answer" rows="2" placeholder="پاسخ" class="form-input" style="width:100%; margin-bottom:.5rem;">@faq.Answer</textarea>
                <button type="button" class="btn-remove-gallery" onclick="this.parentElement.remove()">حذف سوال</button>
            </div>
        }
    </div>
    <button type="button" id="btnAddFaqRow" class="btn-secondary">+ افزودن سوال و پاسخ</button>
</fieldset>

<fieldset class="media-fieldset">
    <legend>گالری تصاویر پروژه (متن جایگزین Alt برای هر تصویر اجباری است)</legend>

    @if (Model.ExistingGalleryImages.Any())
    {
        <div class="existing-gallery-list">
            @for (int i = 0; i < Model.ExistingGalleryImages.Count; i++)
            {
                var img = Model.ExistingGalleryImages[i];
                <div class="gallery-admin-row" id="existing-img-@img.Id">
                    <input type="hidden" name="ExistingGalleryImages[@i].Id" value="@img.Id" />
                    <input type="hidden" name="ExistingGalleryImages[@i].ImageUrl" value="@img.ImageUrl" />
                    <img src="@img.ImageUrl" alt="@img.AltText" width="120" height="80" loading="lazy" class="preview-img" />
                    <div class="gallery-row-inputs">
                        <input type="text" name="ExistingGalleryImages[@i].AltText" value="@img.AltText" required placeholder="متن جایگزین (Alt)" class="form-input" />
                        <input type="number" name="ExistingGalleryImages[@i].SortOrder" value="@img.SortOrder" placeholder="ترتیب" class="form-input order-sm" />
                        <button type="button" class="btn-remove-gallery" onclick="deleteExistingGalleryImage(@img.Id)">حذف عکس</button>
                    </div>
                </div>
            }
        </div>
    }

    <div id="newGalleryContainer"></div>
    <button type="button" id="btnAddGalleryRow" class="btn-secondary">+ افزودن تصویر جدید به گالری</button>
</fieldset>

<fieldset class="media-fieldset">
    <legend>تنظیمات سئو و انتشار</legend>
    <div class="form-grid">
        <div class="form-field">
            <label asp-for="MetaTitle"></label>
            <input asp-for="MetaTitle" class="form-input" />
        </div>
        <div class="form-field">
            <label asp-for="MetaDescription"></label>
            <input asp-for="MetaDescription" class="form-input" />
        </div>
    </div>
    <label class="checkbox-label">
        <input asp-for="IsPublished" /> انتشار عمومی در سایت
    </label>
</fieldset>