@model final_p_01.Domain.Entities.InquiryLead
@using final_p_01.ViewModels
@using final_p_01.Domain.Enums
@{ ViewData["Title"] = "جزئیات درخواست"; }
<section class="lead-panel">
    <a href="/admin/leads" class="btn btn-outline-secondary">بازگشت به درخواست‌ها</a>
    <header class="lead-heading"><div><p class="workspace-eyebrow">درخواست شماره @Model.Id</p><h1>@(Model.FullName ?? "بدون نام")</h1><p class="text-muted">ثبت: @LeadPresentation.Date(Model.CreatedAtUtc) · به وقت تهران</p></div><span class="badge">@LeadPresentation.Status(Model.Status)</span></header>
    <dl class="lead-filters lead-summary">
        <div><dt>موبایل</dt><dd><bdi>@Model.Mobile</bdi></dd></div><div><dt>شهر</dt><dd>@Model.City</dd></div>
        <div><dt>نوع محل</dt><dd>@Model.SiteType</dd></div><div><dt>تعداد زمین</dt><dd>@Model.CourtCount</dd></div>
        <div><dt>نوع زمین</dt><dd>@(Model.LeadType == "inquiry" && Model.CourtType is >= 0 and < 3 ? InquiryFormViewModel.CourtTypes[Model.CourtType.Value] : Model.CourtType?.ToString())</dd></div>
        <div><dt>زمان شروع</dt><dd>@Model.EstimatedStartTime</dd></div><div><dt>بودجه تقریبی</dt><dd>@Model.ApproximateBudget</dd></div>
        <div><dt>منبع / نوع درخواست</dt><dd>@(Model.Source ?? Model.LeadType) / @Model.LeadType</dd></div>
        <div><dt>پروژه مرجع</dt><dd>@Model.ProjectId</dd></div><div><dt>برآورد هزینه (تومان)</dt><dd>@Model.EstimatedMinCost — @Model.EstimatedMaxCost</dd></div>
        <div><dt>صفحه فرود</dt><dd>@Model.LandingPage</dd></div><div><dt>ارجاع‌دهنده</dt><dd>@Model.Referrer</dd></div>
        <div><dt>UTM Source / Medium / Campaign</dt><dd>@Model.UtmSource / @Model.UtmMedium / @Model.UtmCampaign</dd></div>
    </dl>
    <h2>توضیحات پروژه</h2><p class="inquiry-thanks">@(string.IsNullOrWhiteSpace(Model.Message) ? "توضیحی ثبت نشده است." : Model.Message)</p>
    <section class="result-card">
        <h2>پیگیری درخواست</h2>
        <form action="/admin/leads/@Model.Id/update" method="post" class="lead-inline">
            @Html.AntiForgeryToken()
            <div><label asp-for="Status">وضعیت</label><select asp-for="Status" class="form-select">@foreach(var status in Enum.GetValues<LeadStatus>()){<option value="@status">@LeadPresentation.Status(status)</option>}</select><span asp-validation-for="Status"></span></div>
            <div><label asp-for="AssignedTo">مسئول پیگیری</label><input asp-for="AssignedTo" maxlength="150" class="form-control" /><span asp-validation-for="AssignedTo"></span></div><button class="btn btn-primary">ذخیره پیگیری</button>
        </form>
    </section>
    <h2>فایل‌های خصوصی</h2>
    @if(Model.Attachments.Count == 0){<p class="text-muted">فایلی همراه این درخواست ثبت نشده است.</p>}else{<ul>@foreach(var file in Model.Attachments){<li><a class="btn btn-outline-primary" href="/admin/leads/attachments/@file.Id">دانلود @file.OriginalFileName</a><span>@LeadPresentation.Date(file.CreatedAtUtc) · @file.ByteLength بایت</span></li>}</ul>}
    <h2>یادداشت‌های داخلی</h2>
    @if(Model.Notes.Count == 0){<p class="text-muted">هنوز یادداشتی ثبت نشده است. نتیجه تماس را در فرم زیر بنویسید.</p>}
    @foreach(var note in Model.Notes.OrderByDescending(n => n.CreatedAtUtc)){<article class="result-card"><p class="inquiry-thanks">@note.Text</p><p class="text-muted">@note.Author · @LeadPresentation.Date(note.CreatedAtUtc)</p></article>}
    <form action="/admin/leads/@Model.Id/notes" method="post" class="result-card">@Html.AntiForgeryToken()<label for="note">یادداشت جدید (فقط برای مدیریت)</label><textarea id="note" name="text" class="form-control" required maxlength="2000" rows="4" aria-describedby="note-error">@ViewData["NoteText"]</textarea><span id="note-error" class="field-validation-error">@Html.ValidationMessage("text")</span><button class="btn btn-primary mt-3">ثبت یادداشت</button></form>

    <form action="/admin/leads/delete/@Model.Id" method="post" class="result-card lead-delete-form" onsubmit="return confirm('این درخواست و همه یادداشت‌ها و پیوست‌های آن برای همیشه حذف می‌شود. مطمئن هستید؟');">
        @Html.AntiForgeryToken()
        <h2>حذف درخواست</h2>
        <p class="field-hint">حذف دائمی است و قابل بازگشت نیست؛ فایل‌های پیوست نیز پاک می‌شوند.</p>
        <button type="submit" class="btn btn-danger">حذف دائمی درخواست</button>
    </form>
</section>
