@model final_p_01.Domain.Entities.AdminUser

@{
    ViewData["Title"] = "تنظیمات حساب کاربری";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="card" style="border-radius: 16px; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.03); max-width: 600px; margin: 0 auto; padding: 30px;">

    <h3 class="fw-bold mb-4" style="color: #121D35;"><i class="bi bi-person-gear me-2"></i> تنظیمات امنیتی</h3>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success fw-bold">@ViewBag.SuccessMessage</div>
    }

    <form asp-action="Index" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label fw-bold">نام نمایشی</label>
            <input asp-for="FullName" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">ایمیل (نام کاربری جدید)</label>
            <input asp-for="Email" class="form-control" style="direction: ltr;" />
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">رمز عبور جدید</label>
            <input type="text" asp-for="Password" class="form-control" style="direction: ltr;" placeholder="در صورت عدم تغییر، خالی بگذارید..." />
        </div>

        <button type="submit" class="btn w-100 fw-bold" style="background: #121D35; color: #fff; padding: 12px;">
            ذخیره تغییرات
        </button>
    </form>
</div>