@model final_p_01.Areas.Admin.Models.AdminSettingsViewModel
@{
    ViewData["Title"] = "تنظیمات سایت و حساب کاربری";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="card p-4 mx-auto" style="max-width: 760px;">
    <h1 class="h3 mb-4">تنظیمات سایت و حساب کاربری</h1>
    @if (ViewBag.SiteSeo is final_p_01.Areas.Admin.Models.SiteSeoViewModel seo)
    {
        <section aria-labelledby="seo-heading">
            <h2 id="seo-heading" class="h4">سئوی صفحات و فاوآیکون</h2>
            @if (TempData["SeoSuccess"] != null)
            {
                <div class="alert alert-success" role="status">@TempData["SeoSuccess"]</div>
            }
            @if (TempData["SeoError"] != null)
            {
                <div class="alert alert-danger" role="alert">@TempData["SeoError"]</div>
            }
            <form asp-action="SaveSeo" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    @foreach (var (key, label) in new[] { ("Home", "صفحه اصلی"), ("Projects", "پروژه‌ها"), ("Blog", "مجله"), ("Estimator", "برآورد هزینه"), ("Inquiry", "درخواست مشاوره"), ("Guide", "راهنمای جامع 0 تا 100"), ("About", "درباره ما"), ("Contact", "تماس با ما") })
                    {
                        <div class="col-12">
                            <label for="Seo@(key)Title" class="form-label fw-bold">عنوان سئو — @label</label>
                            <input id="Seo@(key)Title" name="Seo@(key)Title" class="form-control" value="@((string?)typeof(final_p_01.Areas.Admin.Models.SiteSeoViewModel).GetProperty($"Seo{key}Title")!.GetValue(seo))" maxlength="200" />
                            <label for="Seo@(key)Description" class="form-label fw-bold mt-2">توضیح متا — @label</label>
                            <textarea id="Seo@(key)Description" name="Seo@(key)Description" class="form-control" rows="2" maxlength="320">@((string?)typeof(final_p_01.Areas.Admin.Models.SiteSeoViewModel).GetProperty($"Seo{key}Description")!.GetValue(seo))</textarea>
                        </div>
                    }
                    <div class="col-12">
                        <label for="favicon" class="form-label fw-bold">فاوآیکون سایت (ico/png/svg، حداکثر ۵۰۰KB)</label>
                        <input id="favicon" type="file" name="favicon" class="form-control" accept=".ico,.png,.svg" />
                        @if (!string.IsNullOrWhiteSpace(seo.CurrentFaviconPath))
                        {
                            <p class="text-muted mt-2">فاوآیکون فعلی: <img src="@seo.CurrentFaviconPath" alt="نشان سایت" width="32" height="32" /></p>
                        }
                        else
                        {
                            <p class="text-muted mt-2">در صورت خالی گذاشتن، فاوآیکون پیش‌فرض استفاده می‌شود.</p>
                        }
                    </div>
                </div>
                <button type="submit" class="pw-btn pw-btn--primary mt-4">ذخیره تنظیمات سئو</button>
            </form>
        </section>
    }
    <section class="mt-4 pt-4 border-top" aria-labelledby="account-heading">
        <h2 id="account-heading" class="h4">تنظیمات امنیتی</h2>
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success" role="status">@ViewBag.SuccessMessage</div>
        }
        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label">نام نمایشی</label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">ایمیل (نام کاربری)</label>
                <input asp-for="Email" class="form-control" dir="ltr" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">رمز عبور فعلی (جهت تایید تغییرات)</label>
                <input type="password" asp-for="CurrentPassword" class="form-control" dir="ltr" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">رمز عبور جدید</label>
                <input type="password" asp-for="NewPassword" class="form-control" dir="ltr" autocomplete="new-password" placeholder="در صورت عدم تغییر، خالی بگذارید" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label">تکرار رمز عبور جدید</label>
                <input type="password" asp-for="ConfirmNewPassword" class="form-control" dir="ltr" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="pw-btn pw-btn--primary">ذخیره تغییرات حساب</button>
        </form>
    </section>
</div>
